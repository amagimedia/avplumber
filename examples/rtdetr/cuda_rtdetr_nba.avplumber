hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "/home/fedora/nba.mp4", "dst": "in_v", "group": "in", "name": "input", "timeout": -1, "auto_restart": "panic" }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in" }

# CUDA HW decode (CUVID)
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "fps": "30", "group": "in", "src": "v_dec_cuda", "dst": "v_dec_30fps" }

# Split: full-res for drawing, downscaled for inference
node.add { "type": "split", "src": "v_dec_30fps", "dst": ["v_dec_1080p", "v_dec_for_rtdetr"], "group": "in" }

# 1920x1080 -> 960x544 for RT-DETR engine input
node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_dec_for_rtdetr", "dst": "v_pre_rtdetr", "group": "in", "name": "Cuda_Preprocess_RTDETR", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

node.add { "type": "cuda_infer_rtdetr", "src": "v_pre_rtdetr", "dst": "v_post_rtdetr", "group": "in", "name": "RTDETR_Infer", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 200, "infer_every_n": 1, "metadata_key_detection": "yolo_detections", "debug_log_metadata": true, "debug_log_every_n": 30, "models": [{ "engine": "/home/fedora/tensorrt/rtdetr-basketball-full/rtdetr-l_960x544.plan", "output_contract": "rtdetr_combined_v1", "class_names": ["Ball", "Hoop", "Period", "Player", "Ref", "Shot Clock", "Team Name", "Team Points", "Time Remaining"] }] }

# Merge detections onto 1080p branch by PTS
node.add { "type": "join_metadata", "src": ["v_dec_1080p", "v_post_rtdetr"], "dst": "v_1080p_with_md", "group": "in" }

# Draw bboxes on full-res frames
node.add { "type": "draw_bbox", "src": "v_1080p_with_md", "dst": "v_annotated_cuda", "group": "in", "name": "Draw_RTDETR", "metadata_key": "yolo_detections", "bbox_thickness": 2, "min_conf": 0.25, "allowed_labels": ["Ball", "Hoop", "Period", "Player", "Ref", "Shot Clock", "Team Name", "Team Points", "Time Remaining"], "label_colors": { "Ball": "red", "Hoop": "yellow", "Period": "cyan", "Player": "green", "Ref": "orange", "Shot Clock": "purple", "Team Name": "light_blue", "Team Points": "magenta", "Time Remaining": "white" }, "model_content_width": 960, "model_content_height": 544, "model_content_offset_x": 0, "model_content_offset_y": 0, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "debug_log_every_n": 30 }

# Encode and output
node.add { "type": "force_fps", "fps": "30/1", "group": "in", "src": "v_annotated_cuda", "dst": "v_annotated_fps" }
node.add { "type": "assume_video_format", "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "group": "in", "src": "v_annotated_fps", "dst": "v_preenc", "auto_restart": "panic" }
node.add { "type": "enc_video", "src": "v_preenc", "dst": "v_outenc", "group": "in", "name": "Video_Encode_NVENC", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "6000k", "maxrate": "6000k", "bufsize": "12000k", "g": 60, "bf": 0, "preset": "p3", "profile": "high" } }

node.add { "type": "mux", "src": ["v_outenc"], "dst": "mux_v", "group": "in", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "mpegts", "url": "rtdetr_nba.ts", "src": "mux_v", "group": "in", "auto_restart": "panic" }

group.start in
