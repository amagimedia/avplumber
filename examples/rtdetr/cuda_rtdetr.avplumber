hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "rtmp://test-streamer-s3dev.aws-dev.intranet/stream_test/cbcdemo", "dst": "in_v", "group": "in", "auto_restart": "group", "name": "input", "initial_timeout": 20, "timeout": 10 }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in", "auto_restart": "group" }

# CUDA HW decode (CUVID)
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "auto_restart": "group", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }

# Preprocess outside infer node:
# 1920x1080 (16:9) -> 960x544 for RT-DETR engine input
node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_dec_cuda", "dst": "v_pre_rtdetr", "group": "in", "name": "Cuda_Preprocess_RTDETR", "auto_restart": "group", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

node.add { "type": "cuda_infer_rtdetr", "src": "v_pre_rtdetr", "dst": "v_post_rtdetr", "group": "in", "name": "RTDETR_Infer", "auto_restart": "group", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 200, "infer_every_n": 2, "metadata_key_detection": "yolo_detections", "debug_log_metadata": true, "debug_log_every_n": 30, "models": [{ "engine": "/home/fedora/tensorrt/rtdetr-basketball-full/rtdetr-l_960x544.plan", "output_contract": "rtdetr_combined_v1", "class_names": ["Ball", "Hoop", "Period", "Player", "Ref", "Shot Clock", "Team Name", "Team Points", "Time Remaining"] }] }

# Sink that discards frames; detections can be observed in avplumber debug logs
node.add { "type": "null_sink<av::VideoFrame>", "src": "v_post_rtdetr", "group": "in", "name": "vnullsink", "auto_restart": "group" }

detach retry group.start in
