hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "/home/fedora/nba.mp4", "dst": "in_v", "group": "in", "name": "input", "timeout": -1, "auto_restart": "panic" }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in" }

# CUDA HW decode (CUVID)
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "fps": "30", "group": "in", "src": "v_dec_cuda", "dst": "v_dec_30fps" }

# Split: full-res for drawing, downscaled for inference
node.add { "type": "split", "src": "v_dec_30fps", "dst": ["v_dec_1080p", "v_dec_for_rtdetr"], "group": "in" }

# Scale to 960x544 on GPU (no CPU roundtrip)
node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_dec_for_rtdetr", "dst": "v_pre_rtdetr", "group": "in", "name": "Cuda_Scale", "auto_restart": "group", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

# RT-DETRv2 R18vd ball-only inference — low conf_thresh to let ball_tracker filter
node.add { "type": "cuda_infer_rtdetr", "src": "v_pre_rtdetr", "dst": "v_post_rtdetr", "group": "in", "name": "RTDETR_Ball_Infer", "input_format": "RGB", "conf_thresh": 0.04, "max_det": 300, "infer_every_n": 1, "metadata_key_detection": "rtdetr_ball", "debug_log_metadata": true, "debug_log_every_n": 30, "models": [{ "engine": "/home/fedora/tensorrt/nba-ball-coco/rtdetrv2_r18vd_ball_best_960x544.plan", "output_contract": "rtdetr_e2e_v1", "class_names": ["basketball"] }] }

# Ball tracker — Kalman-filtered tracking with coasting
node.add { "type": "ball_tracker", "src": "v_post_rtdetr", "dst": "v_tracked", "group": "in", "metadata_key": "rtdetr_ball", "target_label": "basketball", "coast": true, "min_conf": 0.04, "debug_log_every_n": 30, "dump_file": "rtdetr_ball_detections.csv" }

# Merge tracked detections onto 1080p branch by PTS
node.add { "type": "join_metadata", "src": ["v_dec_1080p", "v_tracked"], "dst": "v_1080p_with_md", "group": "in" }

# Draw ball trail on full-res frames
node.add { "type": "draw_trail", "src": "v_1080p_with_md", "dst": "v_trail_drawn", "group": "in", "name": "Draw_Trail", "metadata_key": "rtdetr_ball", "color": "red", "thickness": 2, "model_content_width": 960, "model_content_height": 544, "model_content_offset_x": 0, "model_content_offset_y": 0, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12" }

# Draw tracked ball bbox on full-res frames
node.add { "type": "draw_bbox", "src": "v_trail_drawn", "dst": "v_annotated_cuda", "group": "in", "name": "Draw_Ball", "metadata_key": "rtdetr_ball", "bbox_thickness": 2, "min_conf": 0.04, "allowed_labels": ["basketball"], "model_colors": { "0": "red" }, "model_content_width": 960, "model_content_height": 544, "model_content_offset_x": 0, "model_content_offset_y": 0, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "debug_log_every_n": 30 }

# Encode and output
node.add { "type": "force_fps", "fps": "30/1", "group": "in", "src": "v_annotated_cuda", "dst": "v_annotated_fps" }
node.add { "type": "assume_video_format", "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "group": "in", "src": "v_annotated_fps", "dst": "v_preenc", "auto_restart": "panic" }
node.add { "type": "enc_video", "src": "v_preenc", "dst": "v_outenc", "group": "in", "name": "Video_Encode_NVENC", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "6000k", "maxrate": "6000k", "bufsize": "12000k", "g": 60, "bf": 0, "preset": "p3", "profile": "high" } }

node.add { "type": "mux", "src": ["v_outenc"], "dst": "mux_v", "group": "in", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "mpegts", "url": "rtdetr_ball_tracker.ts", "src": "mux_v", "group": "in", "auto_restart": "panic" }

group.start in
