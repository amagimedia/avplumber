# Super-slomo, cascaded FRUC variant (recommended quality preset).
#
# Two nvof_fruc factor=2 stages in series produce the same 4x frame density as
# factor=4 in a single stage, but every interpolated frame is a true midpoint
# of its input pair -- FRUC's optical-flow refinement is tuned for t=0.5, so
# off-midpoint samples (t=0.25, t=0.75 in single-stage factor=4) get lower
# quality flow. Cascade avoids that.
#
# Trace: 30 fps input -> FRUC_A(2x) -> 60 fps -> FRUC_B(2x) -> 120 fps
#   FRUC_A: midpoint of (F0, F1) = M
#   FRUC_B: midpoint of (F0, M) = Q1; midpoint of (M, F1) = Q3
# All three interpolated frames (Q1, M, Q3) are true midpoints.
#
# Throughput: identical or slightly better than single-stage factor=4 because
# the two FRUC nodes pipeline (stage B processes frame N while stage A works
# on frame N+1).
#
# For 8x slomo add a third nvof_fruc factor=2 stage and set speed=0.125.

hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "input.mp4", "dst": "in0", "group": "in", "auto_restart": "off", "name": "input" }

queue.plan_capacity v_in 240
node.add { "type": "demux", "src": "in0", "routing": { "v:0": "v_in" }, "group": "in", "auto_restart": "off" }

queue.plan_capacity v_dec 30
node.add { "type": "dec_video", "src": "v_in", "dst": "v_dec", "group": "in", "name": "Video_Dec", "auto_restart": "off", "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }

queue.plan_capacity v_fruc_a 120
node.add { "type": "nvof_fruc", "src": "v_dec", "dst": "v_fruc_a", "group": "in", "hwaccel": "@gpu", "library": "/usr/local/Optical_Flow_SDK_5.0.7/NvOFFRUC/NvOFFRUCSample/bin/ubuntu/libNvOFFRUC.so", "factor": 2, "passthrough_on_fail": false }

queue.plan_capacity v_fruc_b 120
node.add { "type": "nvof_fruc", "src": "v_fruc_a", "dst": "v_fruc_b", "group": "in", "hwaccel": "@gpu", "library": "/usr/local/Optical_Flow_SDK_5.0.7/NvOFFRUC/NvOFFRUCSample/bin/ubuntu/libNvOFFRUC.so", "factor": 2, "passthrough_on_fail": false }

queue.plan_capacity v_slow 120
node.add { "type": "speed_video", "src": "v_fruc_b", "dst": "v_slow", "group": "in", "team": "slomo", "speed": 0.25 }

queue.plan_capacity v_cfr 120
node.add { "type": "force_fps", "src": "v_slow", "dst": "v_cfr", "fps": "60/1", "group": "out", "auto_restart": "panic" }

queue.plan_capacity v0 60
node.add { "type": "fake_video_format", "pixel_format": "cuda", "real_pixel_format": "yuv420p", "group": "out", "auto_restart": "panic", "src": "v_cfr", "dst": "v0" }

queue.plan_capacity keyframed 120
node.add { "type": "force_keyframe", "src": "v0", "dst": "keyframed", "interval_sec": "2/1", "group": "out", "auto_restart": "panic" }

queue.plan_capacity venc 240
node.add { "type": "enc_video", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "preset": "p5", "b": "12000k", "maxrate": "16000k", "bufsize": "16000k", "rc": "vbr", "profile": "high", "level": "51", "g": 120 }, "auto_restart": "panic", "name": "VEncode", "group": "out", "src": "keyframed", "dst": "venc" }

queue.plan_capacity mux0 240
node.add { "type": "mux", "src": ["venc"], "dst": "mux0", "group": "out", "auto_restart": "panic", "ts_sort_wait": 0 }

node.add { "type": "output", "format": "mp4", "url": "slomo_out.mp4", "options": { "movflags": "+empty_moov+frag_keyframe+default_base_moof" }, "src": "mux0", "group": "out", "auto_restart": "panic", "name": "Out_mp4" }

group.start out
group.start in
