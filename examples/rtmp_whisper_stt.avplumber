# RTMP audio transcription using FFmpeg 8's whisper filter through avplumber.
#
# Pipeline:
#   RTMP input -> demux audio -> AAC decode -> filter_audio(whisper) -> null_sink
#
# Notes:
# - Assumes avplumber is linked against FFmpeg 8 with whisper enabled
#   (`./configure --enable-whisper`) and whisper.cpp available at runtime.
# - The transcript is written by the FFmpeg `whisper` filter itself via
#   `destination=...`, matching the upstream FFmpeg documentation style.
# - Change `model`, `language`, `queue`, and `destination` to suit your setup.

node.add {
  "type": "input",
  "url": "rtmp://localhost/live/input",
  "dst": "in_mux0",
  "group": "stt",
  "auto_restart": "group",
  "name": "input",
  "initial_timeout": 20,
  "timeout": 10,
  "options": {
    "probesize": 5000000,
    "analyzeduration": 5000000,
    "fflags": "discardcorrupt"
  }
}

queue.plan_capacity a_in 600
queue.plan_capacity a_dec 60
queue.plan_capacity a_stt 60

node.add {
  "type": "demux",
  "src": "in_mux0",
  "wait_for_keyframe": false,
  "routing": { "?a:0": "a_in" },
  "group": "stt",
  "auto_restart": "group",
  "name": "demux"
}

node.add {
  "type": "dec_audio",
  "src": "a_in",
  "dst": "a_dec",
  "group": "stt",
  "name": "Audio_Decode",
  "auto_restart": "group",
  "optional": true
}

# Mirror the FFmpeg whisper examples:
#   whisper=model=...:language=en:queue=3:destination=output.srt:format=srt
#
# The prefilters below are optional but useful for speech recognition:
# - highpass removes low-frequency rumble
# - lowpass reduces high-frequency noise
# - aresample/aformat normalize the audio for ASR workloads
node.add {
  "type": "filter_audio",
  "src": "a_dec",
  "dst": "a_stt",
  "group": "stt",
  "name": "Whisper_STT",
  "auto_restart": "panic",
  "graph": "highpass=f=200,lowpass=f=3000,aresample=16000,aformat=channel_layouts=mono,whisper=model=/models/ggml-base.en.bin:language=en:queue=3:destination=/tmp/rtmp_whisper.srt:format=srt"
}

# The transcript is emitted by the whisper filter to destination=/tmp/rtmp_whisper.srt.
# We do not need the filtered audio downstream for this example.
node.add {
  "type": "null_sink",
  "src": "a_stt",
  "group": "stt",
  "name": "Audio_Blackhole",
  "auto_restart": "panic"
}

group.start stt
