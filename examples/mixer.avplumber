hwaccel.init { "name": "@gpu", "type": "cuda" }

queue.plan_capacity * 3

# ============================================================
# Input Layer: two cameras
# ============================================================

node.add { "type": "input_rec", "url": "/home/fedora/bbl_alt_420.mp4", "dst": "in_cam1_pkt", "group": "input_cam1", "name": "input_cam1", "initial_timeout": 20, "timeout": 3942000000, "loop": true }
node.add { "type": "demux", "src": "in_cam1_pkt", "wait_for_keyframe": false, "routing": { "?v:0": "cam1_pkt" }, "group": "input_cam1", "auto_restart": "group" }
node.add { "type": "dec_video", "src": "cam1_pkt", "dst": "cam1_dec", "group": "input_cam1", "pixel_format": "?cuda", "hwaccel": "@gpu", "auto_restart": "group" }
node.add { "type": "realtime", "src": "cam1_dec", "dst": "cam1_rt", "set_pts": true, "group": "input_cam1" }
node.add { "type": "force_fps", "fps": "30/1", "src": "cam1_rt", "dst": "cam1_fps", "group": "input_cam1" }
node.add { "type": "one_to_many", "name": "otm_cam1", "src": "cam1_fps", "dst": ["cam1_a", "cam1_b"], "outputs": 1, "timeline": "mixer_tl", "group": "input_cam1" }

node.add { "type": "input_rec", "url": "/home/fedora/nba.mp4", "dst": "in_cam2_pkt", "group": "input_cam2", "name": "input_cam2", "initial_timeout": 20, "timeout": 3942000000, "loop": true }
node.add { "type": "demux", "src": "in_cam2_pkt", "wait_for_keyframe": false, "routing": { "?v:0": "cam2_pkt" }, "group": "input_cam2", "auto_restart": "group" }
node.add { "type": "dec_video", "src": "cam2_pkt", "dst": "cam2_dec", "group": "input_cam2", "pixel_format": "?cuda", "hwaccel": "@gpu", "auto_restart": "group" }
node.add { "type": "realtime", "src": "cam2_dec", "dst": "cam2_rt", "set_pts": true, "group": "input_cam2" }
node.add { "type": "force_fps", "fps": "30/1", "src": "cam2_rt", "dst": "cam2_fps", "group": "input_cam2" }
node.add { "type": "one_to_many", "name": "otm_cam2", "src": "cam2_fps", "dst": ["cam2_a", "cam2_b"], "outputs": 0, "timeline": "mixer_tl", "group": "input_cam2" }

# ============================================================
# Per-input crop/scale chains (one per camera per slot)
# ============================================================

# scale_cuda interp_algo: bicubic (default) < lanczos (sharper, more GPU). Wipe leg cannot use scale_cuda on alpha (see wipe_fmt).
node.add { "type": "filter_video", "name": "cs_cam1_a", "src": "cam1_a", "dst": "cam1_a_scaled", "graph": "scale_cuda=w=1920:h=1080:interp_algo=lanczos", "hwaccel": "@gpu", "group": "input_cam1", "auto_restart": "on" }
node.add { "type": "filter_video", "name": "cs_cam2_a", "src": "cam2_a", "dst": "cam2_a_scaled", "graph": "scale_cuda=w=1920:h=1080:interp_algo=lanczos", "hwaccel": "@gpu", "group": "input_cam2", "auto_restart": "on" }
node.add { "type": "filter_video", "name": "cs_cam1_b", "src": "cam1_b", "dst": "cam1_b_scaled", "graph": "scale_cuda=w=1920:h=1080:interp_algo=lanczos", "hwaccel": "@gpu", "group": "input_cam1", "auto_restart": "on" }
node.add { "type": "filter_video", "name": "cs_cam2_b", "src": "cam2_b", "dst": "cam2_b_scaled", "graph": "scale_cuda=w=640:h=360:interp_algo=lanczos", "hwaccel": "@gpu", "group": "input_cam2", "auto_restart": "on" }

# ============================================================
# Scene Rendering Layer: fixed 2-slot compositors
# ============================================================

# Slot A compositor (initially PGM: fullscreen cam1)
node.add { "type": "cuda_rect_overlay", "name": "comp_a", "src": ["cam1_a_scaled", "cam2_a_scaled"], "dst": "scene_a_out", "hwaccel": "@gpu", "width": 1920, "height": 1080, "sw_format": "nv12", "layers": [{"dst_x": 0, "dst_y": 0}, {"dst_x": 0, "dst_y": 0}], "active_inputs": 1, "timeline": "mixer_tl", "group": "mixer_a" }
node.add { "type": "force_fps", "name": "norm_a", "fps": "30/1", "src": "scene_a_out", "dst": "scene_a_norm", "group": "mixer_a" }
node.add { "type": "one_to_many", "name": "otm_scene_a", "src": "scene_a_norm", "dst": ["scA_direct", "scA_trans"], "outputs": 1, "timeline": "mixer_tl", "group": "mixer_a" }

# Slot B compositor (initially PVW: idle)
node.add { "type": "cuda_rect_overlay", "name": "comp_b", "src": ["cam1_b_scaled", "cam2_b_scaled"], "dst": "scene_b_out", "hwaccel": "@gpu", "width": 1920, "height": 1080, "sw_format": "nv12", "layers": [{"dst_x": 0, "dst_y": 0}, {"dst_x": 1280, "dst_y": 720}], "active_inputs": 0, "timeline": "mixer_tl", "group": "mixer_b" }
node.add { "type": "force_fps", "name": "norm_b", "fps": "30/1", "src": "scene_b_out", "dst": "scene_b_norm", "group": "mixer_b" }
node.add { "type": "one_to_many", "name": "otm_scene_b", "src": "scene_b_norm", "dst": ["scB_direct", "scB_trans"], "outputs": 0, "timeline": "mixer_tl", "group": "mixer_b" }

# ============================================================
# Output Selection Layer
# ============================================================

node.add { "type": "source_switcher", "name": "out_sel", "src": ["scA_direct", "scB_direct", "trans_out"], "dst": "mixer_out", "active": 0, "timeline": "mixer_tl", "group": "mixer" }

# Wipe output path: normalize mixer_out first, then split that shared 30fps grid
# into the direct leg and the wipe-overlay main leg. Using the same normalized
# source for both avoids a backward PTS jump when wipe_sel switches back to direct.
node.add { "type": "force_fps", "name": "wipe_base_fps", "fps": "30/1", "src": "mixer_out", "dst": "final_wipe_pre", "group": "mixer" }
node.add { "type": "one_to_many", "name": "otm_final", "src": "final_wipe_pre", "dst": ["final_direct", "final_wipe_in"], "outputs": 1, "timeline": "mixer_tl", "group": "mixer" }
node.add { "type": "source_switcher", "name": "wipe_sel", "src": ["final_direct", "wipe_overlay_out"], "dst": "final_out", "active": 0, "timeline": "mixer_tl", "group": "mixer" }

node.add { "type": "force_fps", "fps": "30/1", "src": "final_out", "dst": "mixer_norm_fps", "group": "output" }
node.add { "type": "assume_video_format", "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "group": "output", "src": "mixer_norm_fps", "dst": "mixer_norm", "auto_restart": "panic" }
node.add { "type": "enc_video", "src": "mixer_norm", "dst": "v_enc", "group": "output", "name": "enc", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "8000k", "maxrate": "14000k", "bufsize": "20000k", "g": 60, "bf": 0, "preset": "p3", "profile": "high" } }
node.add { "type": "mux", "src": ["v_enc"], "dst": "mux_out", "group": "output", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "flv", "url": "rtmp://test-streamer-s3dev.aws-dev.intranet/stream_test/output", "src": "mux_out", "group": "output", "auto_restart": "panic" }

# ============================================================
# Wipe subgraph (pre-created, not started; mixer_wipe group is
# started by the orchestrator at wipe begin and stopped at wipe end)
# ============================================================

node.add { "type": "input_rec", "name": "wipe_input", "url": "", "loop": false, "dst": "wipe_raw_pkt", "group": "mixer_wipe" }
node.add { "type": "demux", "name": "wipe_demux", "src": "wipe_raw_pkt", "routing": { "v:0": "wipe_v_pkt" }, "group": "mixer_wipe" }
node.add { "type": "dec_video", "name": "wipe_dec", "src": "wipe_v_pkt", "dst": "wipe_dec_out", "pixel_format": "?cuda", "hwaccel": "@gpu", "group": "mixer_wipe" }
# Downscale wipe to program size before hwupload. scale_cuda has no yuva420p support, so the
# software scale→format→hwupload pipeline is correct here. overlay_many_cuda requires the
# overlay to be >= main size, so scaling to 1920x1080 is mandatory before upload.
node.add { "type": "filter_video", "name": "wipe_fmt", "src": "wipe_dec_out", "dst": "wipe_fmt_out", "graph": "format=yuva420p,scale=1920:1080:flags=lanczos,hwupload_cuda", "hwaccel": "@gpu", "group": "mixer_wipe" }
node.add { "type": "realtime", "name": "wipe_rt", "src": "wipe_fmt_out", "dst": "wipe_rt_out", "set_pts": true, "group": "mixer_wipe" }
# Normalize wipe overlay to 30fps/tb 1/30 so both wipe_overlay inputs share the same
# integer PTS grid as final_wipe_in (also 30fps via wipe_base_fps).  Matching grids let
# framesync advance both inputs simultaneously on first advance, preventing EXT_NULL.
node.add { "type": "force_fps", "name": "wipe_rt_fps", "fps": "30/1", "src": "wipe_rt_out", "dst": "wipe_rt_fps_out", "group": "mixer_wipe" }
# overlay_many_cuda requires YUV420P main; scale_cuda wraps convert NV12<->YUV420P on GPU.
# This ensures wipe_overlay_out always carries NV12 sw_format, matching assume_video_format.
# overlay_cuda is avoided: NV12 main + YUVA420P overlay is unsupported by it, and convert_cuda
# produces YUV420P output that is misread as NV12 by the encoder after filter restarts.
node.add { "type": "filter_video", "name": "wipe_overlay", "src": ["final_wipe_in", "wipe_rt_fps_out"], "dst": "wipe_overlay_out", "graph": "[in0]scale_cuda=format=yuv420p[main]; [main][in1]overlay_many_cuda=inputs=2[blended]; [blended]scale_cuda=format=nv12", "hwaccel": "@gpu", "group": "mixer_wipe" }

# ============================================================
# Initialize Mixer State
# ============================================================

mixer.init mixer { "timeline": "mixer_tl", "hwaccel": "@gpu", "fps_num": 30, "fps_den": 1, "source_switcher": "out_sel", "initial_pgm_slot": "A", "initial_pgm_scene": "fullcam1", "wipe_otm": "otm_final", "wipe_base_fps": "wipe_base_fps", "wipe_selector": "wipe_sel", "wipe_group": "mixer_wipe", "wipe_input_node": "wipe_input", "wipe_tail_edge": "wipe_rt_fps_out", "wipe_flush_edges": ["wipe_raw_pkt", "wipe_v_pkt", "wipe_dec_out", "wipe_fmt_out", "wipe_rt_out", "wipe_rt_fps_out", "final_wipe_pre", "final_wipe_in", "wipe_overlay_out"], "slot_a": { "compositor": "comp_a", "norm_ts": "norm_a", "post_otm": "otm_scene_a" }, "slot_b": { "compositor": "comp_b", "norm_ts": "norm_b", "post_otm": "otm_scene_b" } }

# Register camera sources (name, otm_node, input_index, cs_node_a, cs_node_b)
mixer.source mixer cam1 otm_cam1 0 cs_cam1_a cs_cam1_b
mixer.source mixer cam2 otm_cam2 1 cs_cam2_a cs_cam2_b

# Define scenes (`sources`: logical name -> ffmpeg graph + compositor rect; omit a camera for off-air / dummy layer slot)
mixer.scene mixer fullcam1 { "sources": { "cam1": { "graph": "scale_cuda=w=1920:h=1080:interp_algo=lanczos", "dst_x": 0, "dst_y": 0 } } }
mixer.scene mixer pip { "sources": { "cam1": { "graph": "scale_cuda=w=1920:h=1080:interp_algo=lanczos", "dst_x": 0, "dst_y": 0 }, "cam2": { "graph": "scale_cuda=w=640:h=360:interp_algo=lanczos", "dst_x": 1280, "dst_y": 720 } } }

# ============================================================
# Start all groups
# ============================================================

detach retry group.start input_cam1
detach retry group.start input_cam2
detach retry group.start mixer_a
detach retry group.start mixer_b
detach retry group.start mixer
detach retry group.start output

# ============================================================
# Usage examples (send via TCP control socket):
#
#   mixer.cut {"mixer":"mixer","scene":"pip"}                                      -- instant switch to PiP scene
#   mixer.fade {"mixer":"mixer","scene":"fullcam1","duration_sec":3}               -- 3-second crossfade to fullscreen cam1
#   mixer.wipe {"mixer":"mixer","scene":"pip","wipe_file":"/path/to/wipe.mov"}     -- media wipe to PiP (duration probed from file)
#   mixer.wipe {"mixer":"mixer","scene":"fullcam1","wipe_file":"/path/to/wipe.mov","duration_sec":2.5} -- media wipe with explicit duration
#   mixer.status mixer                           -- show current PGM/PVW/transition state
#   timeline.dump mixer_tl                       -- inspect all scheduled timeline entries
# ============================================================
