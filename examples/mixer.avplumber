hwaccel.init { "name": "@gpu", "type": "cuda" }

queue.plan_capacity * 3

# ============================================================
# Input Layer: two cameras
# ============================================================

node.add { "type": "input_rec", "url": "/home/fedora/bbl_alt_420.mp4", "dst": "in_cam1_pkt", "group": "input_cam1", "name": "input_cam1", "initial_timeout": 20, "timeout": 3942000000, "loop": true }
node.add { "type": "demux", "src": "in_cam1_pkt", "wait_for_keyframe": false, "routing": { "?v:0": "cam1_pkt" }, "group": "input_cam1", "auto_restart": "group" }
node.add { "type": "dec_video", "src": "cam1_pkt", "dst": "cam1_dec", "group": "input_cam1", "pixel_format": "?cuda", "hwaccel": "@gpu", "auto_restart": "group" }
node.add { "type": "realtime", "src": "cam1_dec", "dst": "cam1_rt", "set_pts": true, "group": "input_cam1" }
node.add { "type": "force_fps", "fps": "30/1", "src": "cam1_rt", "dst": "cam1_fps", "group": "input_cam1" }
node.add { "type": "one_to_many", "name": "otm_cam1", "src": "cam1_fps", "dst": ["cam1_a", "cam1_b"], "outputs": 1, "timeline": "mixer_tl", "group": "input_cam1" }

node.add { "type": "input_rec", "url": "/home/fedora/nba.mp4", "dst": "in_cam2_pkt", "group": "input_cam2", "name": "input_cam2", "initial_timeout": 20, "timeout": 3942000000, "loop": true }
node.add { "type": "demux", "src": "in_cam2_pkt", "wait_for_keyframe": false, "routing": { "?v:0": "cam2_pkt" }, "group": "input_cam2", "auto_restart": "group" }
node.add { "type": "dec_video", "src": "cam2_pkt", "dst": "cam2_dec", "group": "input_cam2", "pixel_format": "?cuda", "hwaccel": "@gpu", "auto_restart": "group" }
node.add { "type": "realtime", "src": "cam2_dec", "dst": "cam2_rt", "set_pts": true, "group": "input_cam2" }
node.add { "type": "force_fps", "fps": "30/1", "src": "cam2_rt", "dst": "cam2_fps", "group": "input_cam2" }
node.add { "type": "one_to_many", "name": "otm_cam2", "src": "cam2_fps", "dst": ["cam2_a", "cam2_b"], "outputs": 0, "timeline": "mixer_tl", "group": "input_cam2" }

# ============================================================
# Per-input crop/scale chains (one per camera per slot)
# ============================================================

node.add { "type": "filter_video", "name": "cs_cam1_a", "src": "cam1_a", "dst": "cam1_a_scaled", "graph": "scale_cuda=1920:1080", "hwaccel": "@gpu", "group": "input_cam1", "auto_restart": "on" }
node.add { "type": "filter_video", "name": "cs_cam2_a", "src": "cam2_a", "dst": "cam2_a_scaled", "graph": "scale_cuda=1920:1080", "hwaccel": "@gpu", "group": "input_cam2", "auto_restart": "on" }
node.add { "type": "filter_video", "name": "cs_cam1_b", "src": "cam1_b", "dst": "cam1_b_scaled", "graph": "scale_cuda=1920:1080", "hwaccel": "@gpu", "group": "input_cam1", "auto_restart": "on" }
node.add { "type": "filter_video", "name": "cs_cam2_b", "src": "cam2_b", "dst": "cam2_b_scaled", "graph": "scale_cuda=640:360", "hwaccel": "@gpu", "group": "input_cam2", "auto_restart": "on" }

# ============================================================
# Scene Rendering Layer: fixed 2-slot compositors
# ============================================================

# Slot A compositor (initially PGM: fullscreen cam1)
node.add { "type": "cuda_rect_overlay", "name": "comp_a", "src": ["cam1_a_scaled", "cam2_a_scaled"], "dst": "scene_a_out", "hwaccel": "@gpu", "width": 1920, "height": 1080, "sw_format": "nv12", "layers": [{"dst_x": 0, "dst_y": 0}, {"dst_x": 0, "dst_y": 0}], "active_inputs": 1, "timeline": "mixer_tl", "group": "mixer_a" }
node.add { "type": "force_fps", "name": "norm_a", "fps": "30/1", "src": "scene_a_out", "dst": "scene_a_norm", "group": "mixer_a" }
node.add { "type": "one_to_many", "name": "otm_scene_a", "src": "scene_a_norm", "dst": ["scA_direct", "scA_trans"], "outputs": 1, "timeline": "mixer_tl", "group": "mixer_a" }

# Slot B compositor (initially PVW: idle)
node.add { "type": "cuda_rect_overlay", "name": "comp_b", "src": ["cam1_b_scaled", "cam2_b_scaled"], "dst": "scene_b_out", "hwaccel": "@gpu", "width": 1920, "height": 1080, "sw_format": "nv12", "layers": [{"dst_x": 0, "dst_y": 0}, {"dst_x": 1280, "dst_y": 720}], "active_inputs": 0, "timeline": "mixer_tl", "group": "mixer_b" }
node.add { "type": "force_fps", "name": "norm_b", "fps": "30/1", "src": "scene_b_out", "dst": "scene_b_norm", "group": "mixer_b" }
node.add { "type": "one_to_many", "name": "otm_scene_b", "src": "scene_b_norm", "dst": ["scB_direct", "scB_trans"], "outputs": 0, "timeline": "mixer_tl", "group": "mixer_b" }

# ============================================================
# Output Selection Layer
# ============================================================

node.add { "type": "source_switcher", "name": "out_sel", "src": ["scA_direct", "scB_direct", "trans_out"], "dst": "mixer_out", "active": 0, "timeline": "mixer_tl", "group": "mixer" }

# Wipe output path: otm_final splits mixer_out so wipe overlay can read it
# without stealing from the direct path.  wipe_sel chooses direct vs overlay.
node.add { "type": "one_to_many", "name": "otm_final", "src": "mixer_out", "dst": ["final_direct", "final_wipe_in"], "outputs": 1, "timeline": "mixer_tl", "group": "mixer" }
node.add { "type": "source_switcher", "name": "wipe_sel", "src": ["final_direct", "wipe_overlay_out"], "dst": "final_out", "active": 0, "timeline": "mixer_tl", "group": "mixer" }

node.add { "type": "force_fps", "fps": "30/1", "src": "final_out", "dst": "mixer_norm_fps", "group": "output" }
node.add { "type": "assume_video_format", "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "group": "output", "src": "mixer_norm_fps", "dst": "mixer_norm", "auto_restart": "panic" }
node.add { "type": "enc_video", "src": "mixer_norm", "dst": "v_enc", "group": "output", "name": "enc", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "8000k", "maxrate": "14000k", "bufsize": "20000k", "g": 60, "bf": 0, "preset": "p3", "profile": "high" } }
node.add { "type": "mux", "src": ["v_enc"], "dst": "mux_out", "group": "output", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "flv", "url": "rtmp://test-streamer-s3dev.aws-dev.intranet/stream_test/output", "src": "mux_out", "group": "output", "auto_restart": "panic" }

# ============================================================
# Initialize Mixer State
# ============================================================

mixer.init mixer { "timeline": "mixer_tl", "hwaccel": "@gpu", "fps_num": 30, "fps_den": 1, "source_switcher": "out_sel", "initial_pgm_slot": "A", "initial_pgm_scene": "fullcam1", "wipe_otm": "otm_final", "wipe_selector": "wipe_sel", "slot_a": { "compositor": "comp_a", "norm_ts": "norm_a", "post_otm": "otm_scene_a" }, "slot_b": { "compositor": "comp_b", "norm_ts": "norm_b", "post_otm": "otm_scene_b" } }

# Register camera sources (name, otm_node, input_index, cs_node_a, cs_node_b)
mixer.source mixer cam1 otm_cam1 0 cs_cam1_a cs_cam1_b
mixer.source mixer cam2 otm_cam2 1 cs_cam2_a cs_cam2_b

# Define scenes
mixer.scene mixer fullcam1 { "sources": { "cam1": { "graph": "scale_cuda=1920:1080" } }, "layers": [{"dst_x": 0, "dst_y": 0}, {"dst_x": 0, "dst_y": 0}] }
mixer.scene mixer pip { "sources": { "cam1": { "graph": "scale_cuda=1920:1080" }, "cam2": { "graph": "scale_cuda=640:360" } }, "layers": [{"dst_x": 0, "dst_y": 0}, {"dst_x": 1280, "dst_y": 720}] }

# ============================================================
# Start all groups
# ============================================================

detach retry group.start input_cam1
detach retry group.start input_cam2
detach retry group.start mixer_a
detach retry group.start mixer_b
detach retry group.start mixer
detach retry group.start output

# ============================================================
# Usage examples (send via TCP control socket):
#
#   mixer.cut mixer pip           -- instant switch to PiP scene
#   mixer.fade mixer fullcam1 3   -- 3-second crossfade to fullscreen cam1
#   mixer.status mixer            -- show current PGM/PVW/transition state
#   timeline.dump mixer_tl        -- inspect all scheduled timeline entries
# ============================================================
