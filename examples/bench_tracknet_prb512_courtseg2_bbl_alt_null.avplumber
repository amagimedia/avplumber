node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "bench", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "name": "Force_25fps", "fps": "25/1", "group": "bench", "src": "v_dec_cuda", "dst": "v_dec_25fps" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=540,pad_cuda=960:544:0:2", "src": "v_dec_25fps", "dst": "v_960", "group": "bench", "name": "Scale_Shared_960x544", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "split", "src": "v_960", "dst": ["v_tracknet_src", "v_prb_src", "v_court_src"], "group": "bench" }

node.add { "type": "tracknet_ball", "src": "v_tracknet_src", "dst": "v_tracknet_raw", "group": "bench", "name": "TrackNet_Ball", "engine": "/home/fedora/tensorrt/tracknet-ball/tracknetv2_basketball_float_512x288.plan", "metadata_key": "yolo_ball", "target_label": "basketball", "conf_thresh": 0.04, "visible_thresh": 0.5, "use_cuda_graph": true, "debug_log_metadata": false, "debug_log_every_n": 0 }
node.add { "type": "ball_tracker", "src": "v_tracknet_raw", "dst": "v_ball_tracked", "group": "bench", "metadata_key": "yolo_ball", "target_label": "basketball", "min_conf": 0.04, "coast": true, "coast_max": 6, "coast_edge_jump_veto_enabled": true, "coast_edge_zone_rel": 0.14, "coast_edge_jump_rel": 0.18, "coast_edge_confirm_frames": 9, "debug_log_every_n": 0, "dump_file": "/home/fedora/avplumber/artifacts/tracknet_prb512_courtseg2_ball_tracker.csv" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=512:h=288", "src": "v_prb_src", "dst": "v_prb_512", "group": "bench", "name": "Scale_PRB_512x288", "dst_width": 512, "dst_height": 288, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "cuda_infer_yolo", "src": "v_prb_512", "dst": "v_post_prb", "group": "bench", "name": "Yolo_Player_Referee_Ball_512x288", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 80, "infer_every_n": 1, "metadata_key_detection": "yolo_player_referee_ball", "debug_log_metadata": false, "debug_log_every_n": 0, "mask_gpu_every_n": 0, "mask_cpu_every_n": 0, "models": [{ "engine": "/home/fedora/tensorrt/amagi_player_referee_ball/player_referee_ball_yolo_512x288_fp16_o3.plan", "task_type": "detection", "class_names": ["player", "referee", "ball"], "output_box_format": "end2end_xyxy" }] }

node.add { "type": "cuda_infer_yolo", "src": "v_court_src", "dst": "v_post_court", "group": "bench", "name": "Yolo_Court_Seg_Every2", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 10, "infer_every_n": 2, "metadata_key_detection": "yolo_seg_det", "metadata_key_segmentation": "yolo_seg", "debug_log_metadata": false, "debug_log_every_n": 0, "mask_gpu_every_n": 0, "mask_cpu_every_n": 1, "mask_cpu_resolution": 64, "models": [{ "engine": "/home/tensorrt/court-segmentation_960x544.plan", "task_type": "segmentation", "class_names": ["basketball-court", "three point line"], "output_box_format": "end2end_xyxy", "include_in_detection_metadata": false }] }

node.add { "type": "join_metadata", "src": ["v_post_prb", "v_post_court"], "dst": "v_players_court", "group": "bench" }
node.add { "type": "shot_classifier", "src": "v_players_court", "dst": "v_shot_classified", "group": "bench", "seg_metadata_key": "yolo_seg", "player_metadata_key": "yolo_player_referee_ball", "player_labels": ["player"], "court_class_indices": [0], "wide_court_threshold": 0.25, "closeup_court_threshold": 0.05, "ambiguous_min_players": 3, "high_player_override": 5, "player_height_fraction": 0.25, "player_height_tolerance": 0.45, "player_min_aspect_ratio": 0.75, "min_stable_frames": 3, "reuse_last_court_coverage_frames": 2, "debug_log_every_n": 0 }

node.add { "type": "join_metadata", "src": ["v_ball_tracked", "v_shot_classified"], "dst": "v_bench_done", "group": "bench" }
node.add { "type": "null_sink<av::VideoFrame>", "src": "v_bench_done", "group": "bench", "name": "Bench_Sink", "auto_restart": "exit" }

group.start bench
