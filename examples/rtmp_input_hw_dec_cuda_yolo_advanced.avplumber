hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "rtmp://test-streamer-s3dev.aws-dev.intranet/stream_test/cbcdemo", "dst": "in_v", "group": "in", "auto_restart": "group", "name": "input", "initial_timeout": 20, "timeout": 10 }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in", "auto_restart": "group" }

# CUDA HW decode (CUVID)
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "auto_restart": "group", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }

# Split decoded CUDA frames into:
# 1) full-resolution branch (primary)
# 2) YOLO preprocessing branch (auxiliary)
node.add { "type": "split", "src": "v_dec_cuda", "dst": ["v_dec_1080p", "v_dec_for_yolo"], "group": "in" }

# YOLO preprocess branch: scale, then pad to model input canvas
node.add { "type": "filter_video", "graph": "scale_cuda=w=640:h=360", "src": "v_dec_for_yolo", "dst": "v_scaled_640x360", "group": "in", "name": "Cuda_Scale_Yolo", "auto_restart": "group", "dst_width": 640, "dst_height": 360, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "filter_video", "graph": "pad_cuda=w=640:h=384", "src": "v_scaled_640x360", "dst": "v_pre_yolo", "group": "in", "name": "Cuda_Pad_Yolo", "auto_restart": "group", "dst_width": 640, "dst_height": 384, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

node.add { "type": "cuda_infer_yolo", "src": "v_pre_yolo", "dst": "v_post_yolo", "group": "in", "name": "Yolo_Infer", "auto_restart": "group", "hwaccel": "@gpu", "engine": "/home/fedora/tensorrt/yolo26n_640x360_fp16.plan", "input_format": "RGB", "class_names": "coco80", "conf_thresh": 0.25, "iou_thresh": 0.45, "max_det": 300, "infer_every_n": 1, "metadata_key_out": "yolo_detections_v1", "debug_log_metadata": true, "debug_log_every_n": 30 }

# Merge metadata from YOLO branch onto 1080p branch by exact PTS match
node.add { "type": "join_metadata", "src": ["v_dec_1080p", "v_post_yolo"], "dst": "v_1080p_with_md", "group": "in" }

# Encode merged full-resolution branch using NVENC
node.add { "type": "enc_video", "src": "v_1080p_with_md", "dst": "v_outenc", "group": "in", "name": "Video_Encode_NVENC", "auto_restart": "group", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "6000k", "maxrate": "6000k", "bufsize": "12000k", "g": 60, "bf": 0 } }

node.add { "type": "mux", "src": ["v_outenc"], "dst": "mux_v", "group": "in", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "mpegts", "url": "/tmp/yolo_joined_1080p.ts", "src": "mux_v", "group": "in", "auto_restart": "panic" }

detach retry group.start in

