# Active-active NVJPEG producer A. Uses sync-bars SRT input PTS as frame identity.

queue.plan_capacity * 4
queue.plan_capacity v_packet 16
queue.plan_capacity v_packet_rt 16
queue.plan_capacity v_dec_cuda 4
queue.plan_capacity v_dec_rt 4
queue.plan_capacity v_marked 4
queue.plan_capacity v_jpeg 8

hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "srt://ingest-1-qa.tellyo.com:9000?streamid=output/live/sync164bdf34f", "dst": "in_mux0", "group": "tx", "name": "SyncBarsA", "initial_timeout": 20, "timeout": 10 }
node.add { "type": "demux", "src": "in_mux0", "routing": { "?v:0": "v_packet" }, "group": "tx", "name": "DemuxA", "auto_restart": "panic", "wait_for_keyframe": false }
node.add { "type": "realtime", "src": "v_packet", "dst": "v_packet_rt", "group": "tx", "name": "PacketRealtimeA", "auto_restart": "panic", "speed": 1.0, "set_pts": false, "negative_time_tolerance": 0.007, "jitter_margin": 0, "discontinuity_threshold": 3 }
node.add { "type": "dec_video", "src": "v_packet_rt", "dst": "v_dec_cuda", "group": "tx", "name": "DecodeA", "auto_restart": "panic", "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid" }, "hwaccel_only_for_codecs": ["h264"] }
node.add { "type": "realtime<av::VideoFrame>", "src": "v_dec_cuda", "dst": "v_dec_rt", "group": "tx", "name": "FrameRealtimeA", "auto_restart": "panic", "speed": 1.0, "set_pts": false, "negative_time_tolerance": 0.007, "jitter_margin": 0, "discontinuity_threshold": 3 }
node.add { "type": "static_text_overlay", "src": "v_dec_rt", "dst": "v_marked", "group": "tx", "name": "OverlayProducerA", "auto_restart": "panic", "text": "PRODUCER A", "x": 18, "y": 18, "font_scale": 2, "padding_x": 12, "padding_y": 8, "text_color": "white", "background_color": "black", "background_opacity": 0.85, "width": 640, "height": 360, "pixel_format": "cuda", "real_pixel_format": "nv12" }
node.add { "type": "nvjpeg_enc", "src": "v_marked", "dst": "v_jpeg", "group": "tx", "name": "NVJPEG_A_Q95", "auto_restart": "panic", "quality": 95, "optimized_huffman": true }
node.add { "type": "fabric_sink", "src": "v_jpeg", "group": "tx", "name": "FabricHotHotJpegA", "provider": "tcp", "remote_host": "127.0.0.1", "remote_port": "5576", "stream_id": "main", "replica_id": 1, "generation": 0, "redundancy_mode": "hot_hot", "media_type": "video", "codec": "jpeg", "width": 640, "height": 360, "pixel_format": "cuda", "real_pixel_format": "nv12", "require_keyframes": true, "max_payload_bytes": 4194304, "queue_depth": 64, "completion_batch": 16, "backpressure": "block" }

group.start tx
