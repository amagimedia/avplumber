# Active-standby NVJPEG producer B. Sends status and keeps repair cache until promoted.

queue.plan_capacity * 4
queue.plan_capacity v_packet 16
queue.plan_capacity v_packet_rt 16
queue.plan_capacity v_dec_cuda 4
queue.plan_capacity v_dec_rt 4
queue.plan_capacity v_marked 4
queue.plan_capacity v_jpeg 8

hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "srt://ingest-1-qa.tellyo.com:9000?streamid=output/live/sync2e446f12e", "dst": "in_mux0", "group": "tx", "name": "SyncBarsStandbyB", "initial_timeout": 20, "timeout": 10 }
node.add { "type": "demux", "src": "in_mux0", "routing": { "?v:0": "v_packet" }, "group": "tx", "name": "DemuxStandbyB", "auto_restart": "panic", "wait_for_keyframe": false }
node.add { "type": "realtime", "src": "v_packet", "dst": "v_packet_rt", "group": "tx", "name": "PacketRealtimeStandbyB", "auto_restart": "panic", "speed": 1.0, "set_pts": false, "negative_time_tolerance": 0.007, "jitter_margin": 0, "discontinuity_threshold": 3 }
node.add { "type": "dec_video", "src": "v_packet_rt", "dst": "v_dec_cuda", "group": "tx", "name": "DecodeStandbyB", "auto_restart": "panic", "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid" }, "hwaccel_only_for_codecs": ["h264"] }
node.add { "type": "realtime<av::VideoFrame>", "src": "v_dec_cuda", "dst": "v_dec_rt", "group": "tx", "name": "FrameRealtimeStandbyB", "auto_restart": "panic", "speed": 1.0, "set_pts": false, "negative_time_tolerance": 0.007, "jitter_margin": 0, "discontinuity_threshold": 3 }
node.add { "type": "static_text_overlay", "src": "v_dec_rt", "dst": "v_marked", "group": "tx", "name": "OverlayProducerB", "auto_restart": "panic", "text": "PRODUCER B", "x": 18, "y": 18, "font_scale": 2, "padding_x": 12, "padding_y": 8, "text_color": "white", "background_color": "magenta", "background_opacity": 0.85, "width": 640, "height": 360, "pixel_format": "cuda", "real_pixel_format": "nv12" }
node.add { "type": "nvjpeg_enc", "src": "v_marked", "dst": "v_jpeg", "group": "tx", "name": "NVJPEG_B_Standby_Q95", "auto_restart": "panic", "quality": 95, "optimized_huffman": true }
node.add { "type": "fabric_sink", "src": "v_jpeg", "group": "tx", "name": "FabricStandbyJpegB", "provider": "tcp", "remote_host": "127.0.0.1", "remote_port": "5587", "stream_id": "main", "replica_id": 2, "generation": 0, "redundancy_mode": "standby", "repair_window_frames": 120, "control_port": 6587, "media_type": "video", "codec": "jpeg", "width": 640, "height": 360, "pixel_format": "cuda", "real_pixel_format": "nv12", "require_keyframes": true, "max_payload_bytes": 4194304, "queue_depth": 64, "completion_batch": 16, "backpressure": "block" }

group.start tx
