# Active-active redundancy with post-source timeline normalization.
# The selector learns B's PTS offset relative to A from receiver wallclock proximity,
# then patches selected packets onto A's timeline before muxing.

queue.plan_capacity * 4
queue.plan_capacity v_fabric_a 64
queue.plan_capacity v_fabric_b 64
queue.plan_capacity v_selected_fabric 32
queue.plan_capacity v_relayed_pkt 32
queue.plan_capacity v_muxed 4

node.add { "type": "fabric_source", "dst": "v_fabric_a", "group": "rx", "name": "FabricAIn", "provider": "tcp", "bind_port": "5556", "reference_url": "/home/fedora/sync_bars_ref.ts", "max_payload_bytes": 4194304, "queue_depth": 128 }
node.add { "type": "fabric_source", "dst": "v_fabric_b", "group": "rx", "name": "FabricBIn", "provider": "tcp", "bind_port": "5557", "reference_url": "/home/fedora/sync_bars_ref.ts", "max_payload_bytes": 4194304, "queue_depth": 128 }
node.add { "type": "redundancy_selector", "src": ["v_fabric_a", "v_fabric_b"], "dst": "v_selected_fabric", "group": "rx", "name": "TimelineSelector", "mode": "active_active", "alignment_mode": "strict_frame_identity", "reference_url": "/home/fedora/sync_bars_ref.ts", "anchor_replica_id": 1, "standby_replica_id": 2, "alignment_window_frames": 50, "alignment_required_frames": 10, "alignment_max_wallclock_delta_ms": 120, "playout_delay_frames": 1 }
node.add { "type": "fabric_unpack", "src": "v_selected_fabric", "dst": "v_relayed_pkt", "group": "rx", "name": "UnpackSelectedPackets", "auto_restart": "panic" }
node.add { "type": "mux", "src": ["v_relayed_pkt"], "dst": "v_muxed", "group": "rx", "name": "MuxFlv", "auto_restart": "panic", "ts_sort_wait": 0 }
node.add { "type": "output", "src": "v_muxed", "format": "flv", "url": "rtmp://test-streamer-s3dev.aws-dev.intranet/stream_test/test", "group": "rx", "name": "OutRtmpSelector", "auto_restart": "panic" }

group.start rx
