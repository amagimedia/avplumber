queue.plan_capacity * 14

hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input_rec", "url": "/media/bbl_alt.mp4", "dst": "in_v", "group": "tracknet", "name": "Input_BBL_Alt", "initial_timeout": 20, "timeout": 10, "loop": true, "auto_restart": "group" }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "tracknet", "auto_restart": "group" }

node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "tracknet", "name": "Video_Dec", "auto_restart": "group", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "realtime", "src": "v_dec_cuda", "dst": "v_dec_rt", "group": "tracknet", "auto_restart": "group", "set_pts": true }
node.add { "type": "force_fps", "fps": "25/1", "group": "tracknet", "src": "v_dec_rt", "dst": "v_dec_25fps", "auto_restart": "group" }

node.add { "type": "split", "src": "v_dec_25fps", "dst": ["v_fullres", "v_tracknet_src", "v_yolo_src"], "group": "tracknet", "auto_restart": "group" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_tracknet_src", "dst": "v_tracknet_960", "group": "tracknet", "name": "Scale_TrackNet", "auto_restart": "group", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=540,pad_cuda=960:544:0:2", "src": "v_yolo_src", "dst": "v_pre_yolo", "group": "tracknet", "name": "Scale_Yolo_Shot", "auto_restart": "group", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "split", "src": "v_pre_yolo", "dst": ["v_for_players", "v_for_seg"], "group": "tracknet", "auto_restart": "group" }
node.add { "type": "cuda_infer_yolo", "src": "v_for_players", "dst": "v_post_players", "group": "tracknet", "name": "Yolo_Players_For_Shot", "auto_restart": "group", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 40, "infer_every_n": 1, "metadata_key_detection": "yolo_players", "debug_log_metadata": true, "debug_log_every_n": 250, "mask_gpu_every_n": 0, "mask_cpu_every_n": 0, "models": [{ "engine": "/home/tensorrt/basketball-players-full_960x544.plan", "task_type": "detection", "class_names": ["_suppress", "Hoop", "_suppress", "Player", "Ref", "_suppress", "_suppress", "_suppress", "_suppress"], "output_box_format": "end2end_xyxy" }] }
node.add { "type": "cuda_infer_yolo", "src": "v_for_seg", "dst": "v_post_seg", "group": "tracknet", "name": "Yolo_Court_For_Shot", "auto_restart": "group", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 10, "infer_every_n": 1, "metadata_key_detection": "yolo_seg_det", "metadata_key_segmentation": "yolo_seg", "debug_log_metadata": true, "debug_log_every_n": 250, "mask_gpu_every_n": 1, "mask_cpu_every_n": 1, "models": [{ "engine": "/home/tensorrt/court-segmentation_960x544.plan", "task_type": "segmentation", "class_names": ["basketball-court", "three point line"], "output_box_format": "end2end_xyxy", "include_in_detection_metadata": false }] }
node.add { "type": "join_metadata", "src": ["v_post_players", "v_post_seg"], "dst": "v_players_court", "group": "tracknet", "auto_restart": "group" }
node.add { "type": "shot_classifier", "src": "v_players_court", "dst": "v_shot_classified", "group": "tracknet", "seg_metadata_key": "yolo_seg", "player_metadata_key": "yolo_players", "player_labels": ["Player"], "court_class_indices": [0], "wide_court_threshold": 0.25, "closeup_court_threshold": 0.05, "ambiguous_min_players": 3, "high_player_override": 5, "player_height_fraction": 0.25, "player_height_tolerance": 0.45, "player_min_aspect_ratio": 0.75, "min_stable_frames": 3, "debug_log_every_n": 250, "auto_restart": "group" }

node.add { "type": "tracknet_ball", "src": "v_tracknet_960", "dst": "v_tracknet_raw", "group": "tracknet", "name": "TrackNet_Ball", "auto_restart": "group", "engine": "/models/tracknet-ball/tracknetv2_basketball_float_512x288.plan", "metadata_key": "yolo_ball", "target_label": "basketball", "conf_thresh": 0.04, "visible_thresh": 0.5, "use_cuda_graph": true, "debug_log_metadata": true, "debug_log_every_n": 250 }

node.add { "type": "join_metadata", "src": ["v_tracknet_raw", "v_shot_classified"], "dst": "v_tracknet_with_shot", "group": "tracknet", "auto_restart": "group" }

node.add { "type": "ball_tracker", "src": "v_tracknet_with_shot", "dst": "v_ball_tracked", "group": "tracknet", "metadata_key": "yolo_ball", "target_label": "basketball", "min_conf": 0.04, "coast": true, "coast_max": 6, "camera_shot_metadata_key": "camera_shot_info", "coast_edge_jump_veto_enabled": true, "coast_edge_zone_rel": 0.14, "coast_edge_jump_rel": 0.18, "coast_edge_confirm_frames": 9, "debug_log_every_n": 250, "dump_file": "/artifacts/tracknet_ball_bbl_alt.csv", "auto_restart": "group" }

node.add { "type": "join_metadata", "src": ["v_fullres", "v_ball_tracked"], "dst": "v_fullres_with_ball_md", "group": "tracknet", "auto_restart": "group" }

node.add { "type": "draw_trail", "src": "v_fullres_with_ball_md", "dst": "v_trail_drawn", "group": "tracknet", "name": "Draw_Ball_Trail", "metadata_key": "yolo_ball", "color": "red", "thickness": 2, "model_content_width": 960, "model_content_height": 544, "model_content_offset_x": 0, "model_content_offset_y": 0, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "auto_restart": "group" }

node.add { "type": "draw_bbox", "src": "v_trail_drawn", "dst": "v_annotated_cuda", "group": "tracknet", "name": "Draw_Ball_BBox", "metadata_key": "yolo_ball", "bbox_thickness": 3, "min_conf": 0.04, "allowed_labels": ["basketball"], "label_colors": { "basketball": "green" }, "predicted_color": "yellow", "model_content_width": 960, "model_content_height": 544, "model_content_offset_x": 0, "model_content_offset_y": 0, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "debug_log_every_n": 250, "auto_restart": "group" }

node.add { "type": "force_fps", "fps": "25/1", "group": "tracknet", "src": "v_annotated_cuda", "dst": "v_output_fps", "auto_restart": "group" }
node.add { "type": "force_keyframe", "interval_sec": "1/1", "group": "tracknet", "src": "v_output_fps", "dst": "v_keyframed", "auto_restart": "group" }
node.add { "type": "assume_video_format", "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "group": "tracknet", "src": "v_keyframed", "dst": "v_preenc", "auto_restart": "group" }
node.add { "type": "enc_video", "src": "v_preenc", "dst": "v_outenc", "group": "tracknet", "name": "Video_Encode_NVENC", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "8000k", "maxrate": "8000k", "bufsize": "8000k", "rc": "cbr", "g": 30, "bf": 0, "preset": "p6", "profile": "baseline", "level": "4.0", "tune": "ull", "rc-lookahead": 0, "zerolatency": 1, "delay": 0, "forced-idr": 1, "no-scenecut": 1, "strict_gop": 1, "aud": 1, "spatial-aq": 1, "temporal-aq": 0 }, "auto_restart": "group" }
node.add { "type": "bsf", "src": "v_outenc", "dst": "v_outenc_headers", "group": "tracknet", "bsf": "dump_extra=freq=keyframe", "auto_restart": "group" }

node.add { "type": "mux", "src": ["v_outenc_headers"], "dst": "mux_v", "group": "tracknet", "ts_sort_wait": 0, "auto_restart": "group" }
node.add { "type": "output", "format": "rtp", "url": "rtp://127.0.0.1:5004?pkt_size=1200&rtcp_port=5005", "src": "mux_v", "group": "tracknet", "options": { "payload_type": 96, "rtpflags": "skip_rtcp", "ssrc": 1096179713 }, "auto_restart": "group" }

detach retry group.start tracknet
