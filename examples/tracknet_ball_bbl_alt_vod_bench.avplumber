node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "tracknet_vod", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "name": "Force_25fps", "fps": "25/1", "group": "tracknet_vod", "src": "v_dec_cuda", "dst": "v_dec_25fps" }

node.add { "type": "split", "src": "v_dec_25fps", "dst": ["v_tracknet_src", "v_yolo_src"], "group": "tracknet_vod" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_tracknet_src", "dst": "v_tracknet_960", "group": "tracknet_vod", "name": "Scale_TrackNet", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "tracknet_ball", "src": "v_tracknet_960", "dst": "v_tracknet_raw", "group": "tracknet_vod", "name": "TrackNet_Ball", "engine": "/home/fedora/tensorrt/tracknet-ball/tracknetv2_basketball_float_512x288.plan", "metadata_key": "yolo_ball", "target_label": "basketball", "conf_thresh": 0.04, "visible_thresh": 0.5, "use_cuda_graph": true, "debug_log_metadata": false, "debug_log_every_n": 0 }
node.add { "type": "ball_tracker", "src": "v_tracknet_raw", "dst": "v_ball_tracked", "group": "tracknet_vod", "metadata_key": "yolo_ball", "target_label": "basketball", "min_conf": 0.04, "coast": true, "coast_max": 6, "coast_edge_jump_veto_enabled": true, "coast_edge_zone_rel": 0.14, "coast_edge_jump_rel": 0.18, "coast_edge_confirm_frames": 9, "debug_log_every_n": 0 }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=540,pad_cuda=960:544:0:2", "src": "v_yolo_src", "dst": "v_pre_yolo", "group": "tracknet_vod", "name": "Scale_Yolo_Shot", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "split", "src": "v_pre_yolo", "dst": ["v_for_players", "v_for_seg"], "group": "tracknet_vod" }
node.add { "type": "cuda_infer_yolo", "src": "v_for_players", "dst": "v_post_players", "group": "tracknet_vod", "name": "Yolo_Players_For_Shot", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 40, "infer_every_n": 1, "metadata_key_detection": "yolo_players", "debug_log_metadata": false, "debug_log_every_n": 0, "mask_gpu_every_n": 0, "mask_cpu_every_n": 0, "models": [{ "engine": "/home/tensorrt/basketball-players-full_960x544.plan", "task_type": "detection", "class_names": ["_suppress", "Hoop", "_suppress", "Player", "Ref", "_suppress", "_suppress", "_suppress", "_suppress"], "output_box_format": "end2end_xyxy" }] }
node.add { "type": "cuda_infer_yolo", "src": "v_for_seg", "dst": "v_post_seg", "group": "tracknet_vod", "name": "Yolo_Court_For_Shot", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 10, "infer_every_n": 1, "metadata_key_detection": "yolo_seg_det", "metadata_key_segmentation": "yolo_seg", "debug_log_metadata": false, "debug_log_every_n": 0, "mask_gpu_every_n": 1, "mask_cpu_every_n": 1, "models": [{ "engine": "/home/tensorrt/court-segmentation_960x544.plan", "task_type": "segmentation", "class_names": ["basketball-court", "three point line"], "output_box_format": "end2end_xyxy", "include_in_detection_metadata": false }] }
node.add { "type": "join_metadata", "src": ["v_post_players", "v_post_seg"], "dst": "v_players_court", "group": "tracknet_vod" }
node.add { "type": "shot_classifier", "src": "v_players_court", "dst": "v_shot_classified", "group": "tracknet_vod", "seg_metadata_key": "yolo_seg", "player_metadata_key": "yolo_players", "player_labels": ["Player"], "court_class_indices": [0], "wide_court_threshold": 0.25, "closeup_court_threshold": 0.05, "ambiguous_min_players": 3, "high_player_override": 5, "player_height_fraction": 0.25, "player_height_tolerance": 0.45, "player_min_aspect_ratio": 0.75, "min_stable_frames": 3, "debug_log_every_n": 0 }

node.add { "type": "join_metadata", "src": ["v_ball_tracked", "v_shot_classified"], "dst": "v_bench_done", "group": "tracknet_vod" }
node.add { "type": "null_sink<av::VideoFrame>", "src": "v_bench_done", "group": "tracknet_vod", "name": "Bench_Sink", "auto_restart": "exit" }

group.start tracknet_vod
