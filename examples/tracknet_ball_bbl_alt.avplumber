hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "/home/fedora/bbl_alt.mp4", "dst": "in_v", "group": "tracknet", "name": "Input_BBL_Alt", "timeout": -1 }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "tracknet" }

node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "tracknet", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "fps": "25/1", "group": "tracknet", "src": "v_dec_cuda", "dst": "v_dec_25fps" }

node.add { "type": "split", "src": "v_dec_25fps", "dst": ["v_fullres", "v_tracknet_src"], "group": "tracknet" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_tracknet_src", "dst": "v_tracknet_960", "group": "tracknet", "name": "Scale_TrackNet", "auto_restart": "group", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

node.add { "type": "tracknet_ball", "src": "v_tracknet_960", "dst": "v_tracknet_raw", "group": "tracknet", "name": "TrackNet_Ball", "engine": "/home/fedora/tensorrt/tracknet-ball/tracknetv2_basketball_float_512x288.plan", "metadata_key": "yolo_ball", "target_label": "basketball", "conf_thresh": 0.04, "visible_thresh": 0.5, "use_cuda_graph": true, "debug_log_metadata": true, "debug_log_every_n": 25 }

node.add { "type": "ball_tracker", "src": "v_tracknet_raw", "dst": "v_ball_tracked", "group": "tracknet", "metadata_key": "yolo_ball", "target_label": "basketball", "min_conf": 0.04, "coast": true, "coast_max": 6, "debug_log_every_n": 25, "dump_file": "/home/fedora/avplumber/tracknet_ball_bbl_alt.csv" }

node.add { "type": "join_metadata", "src": ["v_fullres", "v_ball_tracked"], "dst": "v_fullres_with_ball_md", "group": "tracknet" }

node.add { "type": "draw_trail", "src": "v_fullres_with_ball_md", "dst": "v_trail_drawn", "group": "tracknet", "name": "Draw_Ball_Trail", "metadata_key": "yolo_ball", "color": "red", "thickness": 2, "model_content_width": 960, "model_content_height": 544, "model_content_offset_x": 0, "model_content_offset_y": 0, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12" }

node.add { "type": "draw_bbox", "src": "v_trail_drawn", "dst": "v_annotated_cuda", "group": "tracknet", "name": "Draw_Ball_BBox", "metadata_key": "yolo_ball", "bbox_thickness": 3, "min_conf": 0.04, "allowed_labels": ["basketball"], "label_colors": { "basketball": "green" }, "predicted_color": "yellow", "model_content_width": 960, "model_content_height": 544, "model_content_offset_x": 0, "model_content_offset_y": 0, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "debug_log_every_n": 25 }

node.add { "type": "assume_video_format", "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "group": "tracknet", "src": "v_annotated_cuda", "dst": "v_preenc" }
node.add { "type": "enc_video", "src": "v_preenc", "dst": "v_outenc", "group": "tracknet", "name": "Video_Encode_NVENC", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "6000k", "maxrate": "6000k", "bufsize": "12000k", "g": 50, "bf": 0, "preset": "p3", "profile": "high" } }

node.add { "type": "mux", "src": ["v_outenc"], "dst": "mux_v", "group": "tracknet", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "mpegts", "url": "/home/fedora/avplumber/tracknet_ball_bbl_alt.ts", "src": "mux_v", "group": "tracknet", "auto_restart": "panic" }

group.start tracknet
