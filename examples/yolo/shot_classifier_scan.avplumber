hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input_rec", "url": "__INPUT__", "dst": "in_mux0", "group": "scan", "name": "input", "initial_timeout": 20, "timeout": -1, "loop": false, "auto_restart": "panic" }
node.add { "type": "demux", "src": "in_mux0", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "scan" }
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "scan", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_dec_cuda", "dst": "v_pre_yolo", "group": "scan", "name": "Scale_Yolo", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "split", "src": "v_pre_yolo", "dst": ["v_for_players", "v_for_seg"], "group": "scan" }
node.add { "type": "cuda_infer_yolo", "src": "v_for_players", "dst": "v_post_players", "group": "scan", "name": "Yolo_Players", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 40, "infer_every_n": 1, "metadata_key_detection": "yolo_players", "debug_log_metadata": false, "debug_log_every_n": 0, "mask_gpu_every_n": 0, "mask_cpu_every_n": 0, "models": [{ "engine": "__MODELS_DIR__/basketball-players-full_960x544.plan", "task_type": "detection", "class_names": ["_suppress", "Hoop", "Period", "Player", "Ref", "Shot Clock", "Team Name", "Team Points", "Time Remaining"], "output_box_format": "end2end_xyxy" }] }
node.add { "type": "cuda_infer_yolo", "src": "v_for_seg", "dst": "v_post_seg", "group": "scan", "name": "Yolo_Seg", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 10, "infer_every_n": 1, "metadata_key_detection": "yolo_seg_det", "metadata_key_segmentation": "yolo_seg", "debug_log_metadata": false, "debug_log_every_n": 0, "mask_gpu_every_n": 1, "mask_cpu_every_n": 1, "models": [{ "engine": "__MODELS_DIR__/court-segmentation_960x544.plan", "task_type": "segmentation", "class_names": ["basketball-court", "three point line"], "output_box_format": "end2end_xyxy", "include_in_detection_metadata": false }] }
node.add { "type": "join_metadata", "src": ["v_post_players", "v_post_seg"], "dst": "v_inferred", "group": "scan" }
node.add { "type": "shot_classifier", "src": "v_inferred", "dst": "v_classified", "group": "scan", "seg_metadata_key": "yolo_seg", "player_metadata_key": "yolo_players", "player_labels": ["Player"], "court_class_indices": [0,1], "wide_court_threshold": 0.25, "closeup_court_threshold": 0.05, "ambiguous_min_players": 3, "high_player_override": 5, "player_height_fraction": 0.25, "player_height_tolerance": 0.45, "player_min_aspect_ratio": 0.75, "min_stable_frames": 3, "debug_log_every_n": 1 }
node.add { "type": "null_sink<av::VideoFrame>", "src": "v_classified", "group": "scan", "name": "vnullsink" }

group.start scan
