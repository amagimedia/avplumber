node.add { "type": "cuda_infer_yolo", "src": "v_for_pose", "dst": "v_post_pose", "group": "in", "name": "Yolo_Pose", "auto_restart": "group", "input_format": "RGB", "conf_thresh": 0.05, "max_det": 10, "infer_every_n": 1, "metadata_key_pose": "yolo_pose", "debug_log_metadata": true, "debug_log_every_n": 1, "mask_gpu_every_n": 0, "mask_cpu_every_n": 0, "models": [{ "engine": "/home/fedora/tensorrt/pose-small/pose-small.plan", "task_type": "pose", "class_names": ["court"], "num_classes": 1, "output_box_format": "raw_cxcywh", "include_in_detection_metadata": false }] }
