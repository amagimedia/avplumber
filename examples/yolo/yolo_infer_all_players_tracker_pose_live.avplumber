queue.plan_capacity * 7

hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input_rec", "url": "https://tellyo-docker-dev-images.s3.eu-west-1.amazonaws.com/neural-demo-models/bbl.mp4", "dst": "in_mux0", "group": "in", "name": "input", "initial_timeout": 20, "timeout": 10, "loop": true, "auto_restart": "group" }
node.add { "type": "demux", "src": "in_mux0", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in", "auto_restart": "group" }

