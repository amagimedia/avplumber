hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "/home/fedora/nba.mp4", "dst": "in_v", "group": "in", "name": "input", "timeout": -1, "auto_restart": "panic" }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in" }

# CUDA HW decode (CUVID)
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }

# Scale to 960x540, pad to 960x544
node.add { "type": "filter_video", "graph": "hwdownload,format=nv12,scale=960:540,pad=960:544:0:2,hwupload_cuda", "src": "v_dec_cuda", "dst": "v_pre_yolo", "group": "in", "name": "Scale_Pad_Yolo", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

node.add { "type": "cuda_infer_yolo", "src": "v_pre_yolo", "dst": "v_post_yolo", "group": "in", "name": "Yolo_Players", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 200, "infer_every_n": 1, "metadata_key_detection": "yolo_detections", "debug_log_metadata": true, "debug_log_every_n": 1, "mask_gpu_every_n": 0, "mask_cpu_every_n": 0, "models": [{ "engine": "/home/fedora/tensorrt/basketball-players-full/basketball-players-full_960x544.plan", "task_type": "detection", "class_names": ["Ball", "Hoop", "Period", "Player", "Ref", "Shot Clock", "Team Name", "Team Points", "Time Remaining"], "output_box_format": "end2end_xyxy" }] }

node.add { "type": "null_sink<av::VideoFrame>", "src": "v_post_yolo", "group": "in", "name": "vnullsink" }

group.start in
