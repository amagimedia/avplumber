hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "/home/fedora/nba.mp4", "dst": "in_v", "group": "in", "name": "input", "timeout": -1 }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in" }

# CUDA HW decode (CUVID)
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "fps": "30", "group": "in", "src": "v_dec_cuda", "dst": "v_dec_30fps" }

# Split decoded CUDA frames into:
# 1) full-resolution branch (primary)
# 2) YOLO preprocessing branch (auxiliary)
node.add { "type": "split", "src": "v_dec_30fps", "dst": ["v_dec_1080p", "v_dec_for_yolo"], "group": "in" }

# YOLO preprocess branch: scale 16:9 into a centered 640x640 model canvas
node.add { "type": "filter_video", "graph": "scale_cuda=w=640:h=360", "src": "v_dec_for_yolo", "dst": "v_scaled_640x360", "group": "in", "name": "Cuda_Scale_Yolo", "auto_restart": "group", "dst_width": 640, "dst_height": 360, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "filter_video", "graph": "pad_cuda=w=640:h=640:x=0:y=140", "src": "v_scaled_640x360", "dst": "v_pre_yolo", "group": "in", "name": "Cuda_Pad_Yolo", "auto_restart": "group", "dst_width": 640, "dst_height": 640, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

node.add { "type": "cuda_infer_yolo", "src": "v_pre_yolo", "dst": "v_post_yolo", "group": "in", "name": "Yolo_Infer", "auto_restart": "group", "hwaccel": "@gpu", "engine": "/home/fedora/tensorrt/ball.plan", "input_format": "RGB", "output_box_format": "end2end_xyxy", "yolo_classes": "examples/yolo/basketball3.txt", "conf_thresh": 0.20, "iou_thresh": 0.45, "max_det": 20, "infer_every_n": 1, "metadata_key_out": "yolo_detections_v1", "debug_log_metadata": true, "debug_log_every_n": 1 }

# Long-window single-ball trajectory tracking over YOLO detections.
node.add { "type": "ball_tracker2", "src": "v_post_yolo", "dst": "v_tracked_yolo", "group": "in", "metadata_key_in": "yolo_detections_v1", "metadata_key_out": "ball_track_v2", "target_label": "basketball", "min_conf": 0.20, "history_size": 120, "history_motion_window": 12, "max_missed_frames": 8, "max_jump_frame_fraction": 0.08, "match_max_center_distance": 32, "min_iou_match": 0.01, "max_acceleration": 10.0, "max_jerk": 12.0, "slow_mode_max_prediction_error": 6.0, "min_track_quality_margin": 6.0, "trajectory_max_step_scale": 1.1, "trajectory_step_slack": 2.0, "max_output_jump_frame_fraction": 0.04, "output_switch_margin": 18.0, "min_switch_hits": 8, "selected_track_grace_missed_frames": 5, "suppress_far_switch_output": true, "reacquire_after_empty_frames": 30, "reacquire_min_confirmed_hits": 3, "reacquire_min_track_age": 3, "prediction_decay": 0.92, "velocity_smoothing": 0.60, "min_confirmed_hits": 4, "min_track_age": 4, "max_hypotheses": 3, "debug_log_every_n": 1 }

# Merge raw YOLO detections onto the 1080p branch by exact PTS match
node.add { "type": "join_metadata", "src": ["v_dec_1080p", "v_tracked_yolo"], "dst": "v_1080p_with_md", "group": "in" }

# Draw only the selected long-window basketball track on the full-resolution branch
node.add { "type": "draw_bbox", "src": "v_1080p_with_md", "dst": "v_annotated_cuda", "group": "in", "name": "Draw_Yolo_BBoxes", "metadata_key": "ball_track_v2", "bbox_thickness": 2, "min_conf": 0.20, "allowed_labels": ["basketball"], "model_content_width": 640, "model_content_height": 360, "model_content_offset_x": 0, "model_content_offset_y": 140, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "debug_log_every_n": 1 }

# Re-introduce stable timing/format metadata for the encoder path.
node.add { "type": "force_fps", "fps": "30/1", "group": "in", "src": "v_annotated_cuda", "dst": "v_annotated_fps" }
node.add { "type": "assume_video_format", "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "group": "in", "src": "v_annotated_fps", "dst": "v_preenc", "auto_restart": "panic" }

# Encode merged full-resolution branch using NVENC
node.add { "type": "enc_video", "src": "v_preenc", "dst": "v_outenc", "group": "in", "name": "Video_Encode_NVENC", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "6000k", "maxrate": "6000k", "bufsize": "12000k", "g": 60, "bf": 0, "preset": "p3", "profile": "high" } }

node.add { "type": "mux", "src": ["v_outenc"], "dst": "mux_v", "group": "in", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "mpegts", "url": "yolo_joined_1080p.ts", "src": "mux_v", "group": "in", "auto_restart": "panic" }

group.start in

