queue.plan_capacity * 7

hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input_rec", "url": "/home/fedora/nba.mp4", "dst": "in_mux0", "group": "in", "name": "input", "initial_timeout": 20, "timeout": 10, "loop": false, "on_error": "panic" }
node.add { "type": "demux", "src": "in_mux0", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in" }
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "fps": "30/1", "group": "in", "src": "v_dec_cuda", "dst": "v_dec_30fps" }

node.add { "type": "scoreboard_roi", "src": "v_dec_30fps", "dst": "v_scoreboard_rois", "group": "in", "name": "Scoreboard_ROI", "metadata_key_out": "scoreboard_rois", "preset": "balanced", "lower_third": { "x": 0.0, "y": 0.908, "w": 1.0, "h": 0.075 }, "team_probe_frames": 150, "debug_log_every_n": 300 }
node.add { "type": "scoreboard_ocr", "src": "v_scoreboard_rois", "dst": "v_scoreboard", "group": "in", "name": "Scoreboard_OCR", "detection_metadata_key": "scoreboard_rois", "output_metadata_key": "scoreboard", "ocr_every_n": 3, "ocr_model": "/home/tensorrt/en-ppocr-v4-rec/en_PP-OCRv3_rec_48x320.plan", "ocr_keys": "/home/tensorrt/en-ppocr-v4-rec/en_dict.txt", "scoreboard_labels": ["Period", "Shot Clock", "Team Name", "Team Points", "Time Remaining"], "min_conf": 0.25, "debug_log_every_n": 1 }
node.add { "type": "game_state", "src": "v_scoreboard", "dst": "v_game_state", "group": "in", "scoreboard_metadata_key": "scoreboard", "output_metadata_key": "game_state", "debug_log_every_n": 30 }
node.add { "type": "metadata_dump", "src": "v_game_state", "dst": "v_dumped", "group": "in", "name": "Metadata_Dump_Scoreboard", "output_metadata_key": "frame_dump", "output_file": "scoreboard_ocr_nba_roi.json", "output_file_court": "scoreboard_ocr_nba_roi_court.json", "output_file_outlines": "scoreboard_ocr_nba_roi_outlines.json", "output_file_trail": "scoreboard_ocr_nba_roi_trail.json", "output_file_events": "scoreboard_ocr_nba_roi_events.ndjson", "output_file_possessions": "scoreboard_ocr_nba_roi_possessions.ndjson", "output_file_summary": "scoreboard_ocr_nba_roi_summary.json", "video_label": "nba.mp4", "fps": 30, "dump_every_n": 1, "include_ocr_game_state": true, "debug_log_every_n": 0 }
node.add { "type": "null_sink<av::VideoFrame>", "src": "v_dumped", "group": "in", "name": "Sink", "auto_restart": "exit" }

group.start in
