hwaccel.init { "name": "@gpu", "type": "cuda" }

queue.plan_capacity v_dec_for_yolo 128
queue.plan_capacity v_scaled_960x540 128
queue.plan_capacity v_pre_yolo 128
queue.plan_capacity v_post_yolo 128
queue.plan_capacity v_dec_1080p 128

node.add { "type": "input", "url": "/home/fedora/nba.mp4", "dst": "in_v", "group": "in", "name": "input", "timeout": -1, "auto_restart": "panic" }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in" }

node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "fps": "30", "group": "in", "src": "v_dec_cuda", "dst": "v_dec_30fps" }

node.add { "type": "split", "src": "v_dec_30fps", "dst": ["v_dec_1080p", "v_dec_for_yolo"], "group": "in" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=540", "src": "v_dec_for_yolo", "dst": "v_scaled_960x540", "group": "in", "name": "Cuda_Scale_Yolo", "auto_restart": "group", "dst_width": 960, "dst_height": 540, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "filter_video", "graph": "pad_cuda=w=960:h=960:x=0:y=210", "src": "v_scaled_960x540", "dst": "v_pre_yolo", "group": "in", "name": "Cuda_Pad_Yolo", "auto_restart": "group", "dst_width": 960, "dst_height": 960, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

# Detection + segmentation: ball detection model + court segmentation model
# GPU masks every 3rd frame, CPU masks disabled
node.add { "type": "cuda_infer_yolo", "src": "v_pre_yolo", "dst": "v_post_yolo", "dst_seg": "v_seg_masks", "group": "in", "name": "Yolo_Infer", "auto_restart": "group", "input_format": "RGB", "conf_thresh": 0.20, "max_det": 20, "infer_every_n": 1, "metadata_key_detection": "yolo_detections", "debug_log_metadata": true, "debug_log_every_n": 30, "mask_gpu_every_n": 3, "mask_cpu_every_n": 0, "mask_cpu_resolution": 120, "models": [{ "engine": "/home/fedora/tensorrt/ball.plan", "task_type": "detection", "class_names": ["basketball"], "output_box_format": "end2end_xyxy" }, { "engine": "/home/fedora/tensorrt/court-segmentation.plan", "task_type": "segmentation", "class_names": ["person"], "output_box_format": "raw_cxcywh" }] }

node.add { "type": "null_sink", "src": "v_seg_masks", "group": "in" }

node.add { "type": "join_metadata", "src": ["v_dec_1080p", "v_post_yolo"], "dst": "v_1080p_with_md", "group": "in" }

# Draw segmentation masks on full-res
node.add { "type": "draw_segmask", "src": "v_1080p_with_md", "dst": "v_segmask_cuda", "group": "in", "name": "Draw_SegMask", "metadata_key": "yolo_segmentation", "mask_color": "green", "class_colors": { "0": "light_blue", "1": "green" }, "opacity": 0.4, "threshold": 0.5, "min_conf": 0.20, "model_content_width": 960, "model_content_height": 540, "model_content_offset_x": 0, "model_content_offset_y": 210, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "debug_log_every_n": 30 }

# Draw detection bboxes on top of masks
node.add { "type": "draw_bbox", "src": "v_segmask_cuda", "dst": "v_annotated_cuda", "group": "in", "name": "Draw_Yolo_BBoxes", "metadata_key": "yolo_detections", "bbox_thickness": 2, "min_conf": 0.20, "allowed_labels": ["basketball", "person"], "model_colors": { "0": "red", "1": "green" }, "model_content_width": 960, "model_content_height": 540, "model_content_offset_x": 0, "model_content_offset_y": 210, "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "debug_log_every_n": 30 }

node.add { "type": "force_fps", "fps": "30/1", "group": "in", "src": "v_annotated_cuda", "dst": "v_preenc" }
node.add { "type": "assume_video_format", "width": 1920, "height": 1080, "pixel_format": "cuda", "real_pixel_format": "nv12", "group": "in", "src": "v_preenc", "dst": "v_enc_in", "auto_restart": "panic" }

node.add { "type": "enc_video", "src": "v_enc_in", "dst": "v_outenc", "group": "in", "name": "Video_Encode_NVENC", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "8000k", "maxrate": "14000k", "bufsize": "20000k", "g": 60, "bf": 0, "preset": "p3", "profile": "high" } }

node.add { "type": "mux", "src": ["v_outenc"], "dst": "mux_v", "group": "in", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "mpegts", "url": "yolo_segmentation.ts", "src": "mux_v", "group": "in", "auto_restart": "panic" }

group.start in
