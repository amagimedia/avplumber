queue.plan_capacity * 10

hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input_rec", "url": "/home/fedora/bbl_alt.mp4", "dst": "in_v", "group": "bench", "name": "Input_BBL_Alt_VOD", "initial_timeout": 20, "timeout": 10, "loop": false, "stop_ts": "00:01:00.000", "on_error": "panic" }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "bench" }
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "bench", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "name": "Force_25fps", "fps": "25/1", "group": "bench", "src": "v_dec_cuda", "dst": "v_dec_25fps" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_dec_25fps", "dst": "v_tracknet_960", "group": "bench", "name": "Scale_TrackNet", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "tracknet_ball", "src": "v_tracknet_960", "dst": "v_tracknet_done", "group": "bench", "name": "TrackNet_Ball", "engine": "/home/fedora/tensorrt/tracknet-ball/tracknetv2_basketball_float_512x288.plan", "metadata_key": "tracknet_ball", "target_label": "basketball", "conf_thresh": 0.04, "visible_thresh": 0.5, "use_cuda_graph": true, "debug_log_metadata": false, "debug_log_every_n": 0 }

node.add { "type": "null_sink<av::VideoFrame>", "src": "v_tracknet_done", "group": "bench", "name": "Bench_Sink", "auto_restart": "exit" }

group.start bench
