hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input", "url": "full_game_nba4_000_clip4_from140s_to150s.mp4", "dst": "in_v", "group": "in", "auto_restart": "group", "name": "input", "timeout": -1 }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "in", "auto_restart": "group" }

# CUDA HW decode (CUVID)
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "in", "name": "Video_Dec", "auto_restart": "group", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "fps": "30", "group": "in", "src": "v_dec_cuda", "dst": "v_dec_30fps" }
node.add { "type": "realtime", "team": "@reframer-rt", "negative_time_tolerance": 0.007, "jitter_margin": 0, "discontinuity_threshold": 3, "src": "v_dec_30fps", "dst": "v_rt", "group": "in", "name": "rtsync_video", "set_pts": false }

# Split the 1080p stream into:
# 1) a full-resolution primary branch
# 2) an auxiliary branch for low-resolution reframer inference
node.add { "type": "split", "src": "v_rt", "dst": ["v_dec_1080p", "v_dec_for_reframer"], "group": "in" }

# Reframer preprocess branch: 1920x1080 (16:9) -> 640x360
node.add { "type": "filter_video", "graph": "scale_cuda=w=640:h=360", "src": "v_dec_for_reframer", "dst": "v_pre_reframer", "group": "in", "name": "Cuda_Preprocess_Reframer", "auto_restart": "group", "dst_width": 640, "dst_height": 360, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }

# Run reframer on the small branch; metadata is written onto the auxiliary frames.
node.add { "type": "reframer", "src": "v_pre_reframer", "dst": "v_post_reframer", "group": "in", "name": "Reframer_Infer", "auto_restart": "group", "hwaccel": "@gpu", "engine": "/models/reframer.plan", "full_frame_width": 1920, "full_frame_height": 1080, "input_format": "RGB", "metadata_key_out": "reframer_bbox", "debug_log_every_n": 3 }

# Merge reframer metadata from the 360p auxiliary branch back onto the 1080p branch by exact PTS match.
node.add { "type": "join_metadata", "src": ["v_dec_1080p", "v_post_reframer"], "dst": "v_1080p_with_md", "group": "in" }

# Crop the 1080p CUDA branch using the reframer metadata, producing a real cropped CUDA surface for NVENC.
node.add { "type": "crop_metadata_cuda", "src": "v_1080p_with_md", "dst": "v_cropped_cuda", "group": "in", "name": "Crop_From_Reframer", "auto_restart": "group", "metadata_key": "reframer_bbox", "dst_width": 608, "dst_height": 1080, "debug_log_every_n": 30 }

# Encode the cropped branch using NVENC.
node.add { "type": "enc_video", "src": "v_cropped_cuda", "dst": "v_outenc", "group": "in", "name": "Video_Encode_NVENC", "auto_restart": "group", "codec": "h264_nvenc", "hwaccel": "@gpu", "options": { "b": "6000k", "maxrate": "6000k", "bufsize": "12000k", "g": 60, "bf": 0 } }

node.add { "type": "mux", "src": ["v_outenc"], "dst": "mux_v", "group": "in", "ts_sort_wait": 0 }
node.add { "type": "output", "format": "mpegts", "url": "output.ts", "src": "mux_v", "group": "in", "auto_restart": "panic" }

detach retry group.start in

