queue.plan_capacity * 14

hwaccel.init { "name": "@gpu", "type": "cuda" }

node.add { "type": "input_rec", "url": "/home/fedora/bbl_alt.mp4", "dst": "in_v", "group": "analysis", "name": "Input_BBL_Alt_VOD", "initial_timeout": 20, "timeout": 10, "loop": false, "stop_ts": "00:01:00.000", "on_error": "panic" }
node.add { "type": "demux", "src": "in_v", "wait_for_keyframe": false, "routing": { "?v:0": "v_pkt" }, "group": "analysis" }
node.add { "type": "dec_video", "src": "v_pkt", "dst": "v_dec_cuda", "group": "analysis", "name": "Video_Dec", "optional": true, "pixel_format": "?cuda", "hwaccel": "@gpu", "codec_map": { "h264": "h264_cuvid", "hevc": "hevc_cuvid" }, "hwaccel_only_for_codecs": ["h264", "hevc"] }
node.add { "type": "force_fps", "name": "Force_25fps", "fps": "25/1", "group": "analysis", "src": "v_dec_cuda", "dst": "v_dec_25fps" }
node.add { "type": "split", "src": "v_dec_25fps", "dst": ["v_tracknet_src", "v_yolo_src"], "group": "analysis" }

node.add { "type": "filter_video", "graph": "scale_cuda=w=960:h=544", "src": "v_tracknet_src", "dst": "v_tracknet_960", "group": "analysis", "name": "Scale_TrackNet", "dst_width": 960, "dst_height": 544, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "tracknet_ball", "src": "v_tracknet_960", "dst": "v_tracknet_raw_md", "group": "analysis", "name": "TrackNet_Ball", "engine": "/home/fedora/tensorrt/tracknet-ball/tracknetv2_basketball_float_512x288.plan", "metadata_key": "tracknet_ball", "target_label": "basketball", "conf_thresh": 0.04, "visible_thresh": 0.5, "use_cuda_graph": true, "debug_log_metadata": true, "debug_log_every_n": 1 }
node.add { "type": "metadata_dump_frame", "src": "v_tracknet_raw_md", "dst": "v_tracknet_raw_dumped", "group": "analysis", "name": "Dump_TrackNet_Raw", "ball_metadata_key": "tracknet_ball", "output_file": "/home/fedora/avplumber/artifacts/tracknet_raw_metadata_analysis.jsonl", "dump_every_n": 1 }
node.add { "type": "ball_tracker", "src": "v_tracknet_raw_dumped", "dst": "v_tracknet_tracked", "group": "analysis", "metadata_key": "tracknet_ball", "target_label": "basketball", "min_conf": 0.04, "coast": true, "coast_max": 6, "coast_edge_jump_veto_enabled": true, "coast_edge_zone_rel": 0.14, "coast_edge_jump_rel": 0.18, "coast_edge_confirm_frames": 9, "debug_log_every_n": 0, "dump_file": "/home/fedora/avplumber/artifacts/tracknet_tracker_analysis.csv" }
node.add { "type": "metadata_dump_frame", "src": "v_tracknet_tracked", "dst": "v_tracknet_done", "group": "analysis", "name": "Dump_TrackNet_Tracked", "ball_metadata_key": "tracknet_ball", "output_file": "/home/fedora/avplumber/artifacts/tracknet_tracked_metadata_analysis.jsonl", "output_file_trail": "/home/fedora/avplumber/artifacts/tracknet_tracked_trail_analysis.jsonl", "dump_every_n": 1 }

node.add { "type": "filter_video", "graph": "scale_cuda=w=512:h=288", "src": "v_yolo_src", "dst": "v_yolo_512", "group": "analysis", "name": "Scale_Yolo_512x288", "dst_width": 512, "dst_height": 288, "dst_pixel_format": "cuda", "hwaccel": "@gpu" }
node.add { "type": "cuda_infer_yolo", "src": "v_yolo_512", "dst": "v_yolo_done", "group": "analysis", "name": "Yolo_Player_Referee_Ball_512x288", "input_format": "RGB", "conf_thresh": 0.25, "max_det": 80, "infer_every_n": 1, "metadata_key_detection": "yolo_player_referee_ball", "debug_log_metadata": true, "debug_log_every_n": 1, "mask_gpu_every_n": 0, "mask_cpu_every_n": 0, "models": [{ "engine": "/home/fedora/tensorrt/amagi_player_referee_ball/player_referee_ball_yolo_512x288_fp16_o3.plan", "task_type": "detection", "class_names": ["player", "referee", "ball"], "output_box_format": "end2end_xyxy" }] }

node.add { "type": "join_metadata", "src": ["v_tracknet_done", "v_yolo_done"], "dst": "v_analysis_done", "group": "analysis" }
node.add { "type": "null_sink<av::VideoFrame>", "src": "v_analysis_done", "group": "analysis", "name": "Analysis_Sink", "auto_restart": "exit" }

group.start analysis
