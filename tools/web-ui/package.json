{
  "name": "avplumber-web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only web UI for avplumber (zoomable graph map, queue and node pages, stats viewer) with Svelte frontend",
  "scripts": {
    "start": "node backend/server.js",
    "dev:server": "NODE_ENV=development node backend/server.js",
    "build": "cd frontend && vite build",
    "test": "node --test tests/ frontend/src"
  },
  "dependencies": {
    "golden-layout": "^2.6.0",
    "graphology": "0.25.4",
    "sigma": "3.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "svelte": "^4.0.0",
    "vite": "^5.0.0"
  }
}
