#!/usr/bin/python3

import sys, datetime, re
from collections import namedtuple

top_node = 'input'


def parse_log_time(s):
    return datetime.datetime.strptime(s, '%Y-%m-%d %H:%M:%S.%f %z')

log_line_re = re.compile(r'.*?(?P<time>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{6} [\+\-]\d{4}) \[[^\]]*\] (?P<message>.+)')

node_message_re = {
    'creating': re.compile(r'Creating node (?P<node>[^ ]+) \.\.\.'),
    'created':  re.compile(r'Creating node (?P<node>[^ ]+) done'),
    'starting': re.compile(r'Starting node (?P<node>[^ ]+) \.\.\.'),
    'started':  re.compile(r'Starting node (?P<node>[^ ]+) done')
}

start_time = None
times = dict()

