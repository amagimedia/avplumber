# Dockerfile.neural-autoflip
# Builds the avplumber binary with HAVE_MEDIAPIPE_AUTOFLIP=1 inside the
# avp-builder:courtsegm image (all build deps present), then produces a
# runtime image from avplumber-neural-demo:latest with:
#   - the new avplumber binary (with mediapipe_autoflip_crop_metadata node)
#   - libavp_mediapipe_autoflip.so (pre-built by Dockerfile.mediapipe)
#   - the tracker-autoflip templates
#   - the updated entrypoint.sh
#
# Build (from repo root, run on remote):
#   docker build -f Dockerfile.neural-autoflip -t avplumber-neural-autoflip:latest .
#
# Run:
#   docker run -d --name avp-neural-autoflip \
#     --gpus all --network host --restart unless-stopped \
#     -v /home/fedora/bbl.mp4:/run/avp/input/bbl.mp4:ro \
#     -e AVP_EXAMPLE=tracker-autoflip -e AVP_MODE=live \
#     -e AVP_INPUT=/run/avp/input/bbl.mp4 -e AVP_OUTPUT=janus \
#     avplumber-neural-autoflip:latest

FROM avp-builder:courtsegm AS builder

RUN dnf -y install opencv-devel && dnf clean all

WORKDIR /build/avplumber

COPY deps/   deps/
COPY src/    src/
COPY scripts/ scripts/
COPY generate_node_list Makefile ./
COPY .git/   .git/

# Install the pre-built autoflip .so at the absolute install path
RUN mkdir -p /opt/mediapipe-autoflip/lib && \
    cp deps/mediapipe-autoflip/lib/libavp_mediapipe_autoflip.so /opt/mediapipe-autoflip/lib/ && \
    touch /opt/mediapipe-autoflip/.avp-autoflip-built

RUN git config --global --add safe.directory /build/avplumber

RUN make -j$(nproc) \
        HAVE_MEDIAPIPE_AUTOFLIP=1 \
        NEURAL_NET_COMMON=1 NEURAL_NET_SPECIFIC=1 \
        HAVE_CUDA=1 HAVE_NVOF_FRUC=0 HAVE_NVCC=1 \
        NVCC=/usr/local/cuda-13.0/bin/nvcc \
        TENSORRT_ROOT=/opt/tensorrt \
        MEDIAPIPE_AUTOFLIP_INSTALL_DIR=/opt/mediapipe-autoflip \
        PKG_CONFIG_PATH=/usr/local/lib/pkgconfig \
        "CXXFLAGS+=-I/usr/local/include -I/usr/local/cuda-13.0/include -I/usr/local/cuda-13.0/targets/x86_64-linux/include" \
        "LFLAGS+=-L/usr/local/lib -Wl,-rpath,/usr/local/lib -L/usr/local/cuda-13.0/targets/x86_64-linux/lib -Wl,-rpath,/usr/local/cuda-13.0/targets/x86_64-linux/lib" \
    && ls -lh avplumber

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM avplumber-neural-demo:latest

# Install OpenCV runtime libraries (and mesa-libGL for libGLX needed by highgui)
RUN dnf -y install opencv opencv-core opencv-video mesa-libGL && dnf clean all

# Replace avplumber binary with the autoflip-enabled build
COPY --from=builder /build/avplumber/avplumber /usr/local/bin/avplumber

# Install the autoflip .so (built at absolute path /opt/mediapipe-autoflip in builder stage)
RUN mkdir -p /opt/mediapipe-autoflip/lib
COPY --from=builder /opt/mediapipe-autoflip/lib/libavp_mediapipe_autoflip.so \
                    /opt/mediapipe-autoflip/lib/

# Add the autoflip templates and updated entrypoint (replace both paths the image uses)
COPY neural-demo/templates/ /opt/avp-neural-demo/templates/
COPY neural-demo/entrypoint.sh /opt/avp-neural-demo/entrypoint.sh
COPY neural-demo/entrypoint.sh /usr/local/bin/avp-neural-demo-entrypoint
RUN chmod +x /opt/avp-neural-demo/entrypoint.sh /usr/local/bin/avp-neural-demo-entrypoint

ENV LD_LIBRARY_PATH=/opt/mediapipe-autoflip/lib:/usr/local/lib:/opt/tensorrt/lib:/usr/local/cuda-13.0/targets/x86_64-linux/lib
