# Copy to .dev.env (in this directory) and edit. .dev.env is gitignored.
# Loaded by scripts/*.sh via `source .dev.env`.

# SSH target: the AWS Fedora demo host. No git on that host -- code is
# rsynced. IP changes when the instance is replaced; check the current one
# before relying on this default.
EC2_USER=fedora
EC2_HOST=<HOST_IP>
EC2_PEM=/Users/mateuszsalski/.ssh/awsdev.pem

# Workspace root on the host holding the sibling avplumber/ checkout (and,
# for the audio_video_mixer demo, avplumber-nodes-2/, dyremix/, dyremix-qt/).
EC2_REPO=/home/fedora/audio-video-mixer
