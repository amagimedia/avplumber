# Copy to .dev.env (in this directory) and edit. .dev.env is gitignored.
# Loaded by scripts/*.sh via `source .dev.env`.

# SSH target: the demo host. No git on that host -- code is rsynced. The
# address changes whenever the instance is replaced; ask the team for the
# current one rather than trusting anything committed here.
EC2_USER=<user>
EC2_HOST=<host>
EC2_PEM=~/.ssh/<your-key>.pem

# Workspace root on the host holding the sibling avplumber/ checkout (and the
# other checkouts the audio_video_mixer demo expects next to it).
EC2_REPO=<path/to/workspace>
