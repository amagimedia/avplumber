COMPOSE_PROJECT_NAME=avplumber-auto-mixer
# For a second concurrent stack, use a different project name and non-overlap
# all host-bound ports/ranges below.
JANUS_HOST_IP=<host-ip>
JANUS_REF=v1.4.1
# Optional deployment branch for rebuild-restart-stack.sh. If unset, the
# script uses the currently checked-out branch unless --branch is passed.
# AVP_GIT_BRANCH=<branch>

TENSORRT_CONTEXT=<path-to-tensorrt-directory>
TENSORRT_ARCHIVE=tensorrt-minimal-with-tools.tgz
FACE_ONNX=<path-to-face-yolo-onnx>
FACE_ENGINE_CACHE_DIR=<path-to-face-engine-cache-directory>
MEDIA_INPUT_DIR=<path-to-input-media-directory>
MEDIA_WIPE_DIR=<path-to-media-wipe-directory>
REMOTE_CONTROL_PORT=7777
WEBUI_PORT=22222
JANUS_HTTP_PORT=8088
JANUS_PREVIEW_PORT=8080
# Use false for the neural-demo Janus video-only profile.
JANUS_AUDIO_ENABLED=true
JANUS_AUDIO_PORT=5002
JANUS_AUDIO_RTCP_PORT=5003
JANUS_VIDEO_PORT=5004
JANUS_VIDEO_RTCP_PORT=5005
JANUS_VIDEO_PT=96
JANUS_VIDEO_SSRC=0x41565001
AUTO_MIXER_INSTANCE_NAME=auto-mixer
AUTO_MIXER_JANUS_HOST=127.0.0.1
AUTO_MIXER_LOGFILE=/var/log/avplumber/auto-mixer.log
AUTO_MIXER_CONTAINER=avp-auto-mixer
# Optional: put the auto-mixer CLI here instead of passing it after
# `mixer-stack.sh start --`. Keep values host-generic in committed examples.
# AUTO_MIXER_ARGS=--inputs /media-inputs/cam0.ts /media-inputs/cam1.ts --janus-output --janus-host 127.0.0.1 --media-wipe-dir /media-wipes --html-overlay-url https://example.invalid/overlay

HTML_OVERLAY_URL=https://example.invalid/overlay
HTML_OVERLAY_WIDTH=1080
HTML_OVERLAY_HEIGHT=1920
HTML_OVERLAY_FPS=30
HTML_OVERLAY_DRM_DEVICE=/dev/dri/renderD128

AUTO_MIXER_IMAGE_TAG=latest
DMA_BROWSER_IMAGE_TAG=latest
JANUS_IMAGE_TAG=v1.4.1
JANUS_PREVIEW_IMAGE_TAG=latest
NEURAL_DEMO_IMAGE=avplumber-neural-demo:latest
WAYLAND_IMAGE_TAG=latest
WEBUI_IMAGE_TAG=latest

# Optional neural-demo compose service. Build NEURAL_DEMO_IMAGE first with
# ../../../neural-demo/build-neural-demo-image.sh, then run the neural profile.
NEURAL_DEMO_INPUT=<path-to-input-media-file>
NEURAL_DEMO_ARTIFACT_DIR=<path-to-neural-demo-artifacts-directory>
NEURAL_DEMO_EXAMPLE=metadata
NEURAL_DEMO_MODE=live
NEURAL_DEMO_OUTPUT=janus
NEURAL_DEMO_METADATA_DUMPS=0
NEURAL_DEMO_INSTANCE_NAME=neural-demo
NEURAL_DEMO_LOGFILE=/var/log/avplumber/neural-demo.log

JANUS_RTP_PORT_RANGE=20000-20100
JANUS_DEBUG_LEVEL=4
WAYLAND_DISPLAY=wayland-1
WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128
DMA_BROWSER_REST_PORT=9009
DMA_BROWSER_ALLOWED_DIMS=1080x1920,1920x1080,1280x720
DMA_BROWSER_DMABUF_POOL_SIZE=10
DMA_BROWSER_CHROMIUM_EXTRA_FEATURES=VaapiNvidiaSyncSurfaceAfterEndPicture,VaapiNvidiaSurfaceReuseChecks
