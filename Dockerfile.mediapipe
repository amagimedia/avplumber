# Dockerfile.mediapipe
# Builds avplumber python module with MediaPipe face mesh GPU support (C++ bridge via Bazel).
#
# Strategy:
#   - Switch to Python 3.12 (v0.10.35 has no hermetic Python 3.13 lock files)
#   - Install Bazel via Bazelisk
#   - Build MediaPipe bridge (libavp_mediapipe_face_mesh.so) from source
#   - Build avplumber python module with HAVE_MEDIAPIPE=1
#
# Build (run from repo root on remote):
#   docker build -f Dockerfile.mediapipe -t avp-mediapipe:latest .
#
# Run:
#   docker run --rm --gpus all --network host \
#     -v /home/fedora/test-content:/home/fedora/test-content:ro \
#     -e AVP_INPUT=/home/fedora/test-content/talkshow/Genaro_norm.ts \
#     avp-mediapipe:latest

FROM avp-builder:courtsegm AS builder

# ── Switch default python3 to 3.12 (needed by Bazel hermetic Python rules) ────
# Install python3.12 and point python3 / python3-config at it.
RUN dnf -y install \
        python3.12 python3.12-devel \
        java-21-openjdk-headless \
        zip unzip which patch \
        mesa-libEGL-devel mesa-libGLES-devel \
        opencv-devel \
    && dnf clean all \
    && python3.12 -m ensurepip --upgrade \
    && alternatives --install /usr/bin/python3      python3      /usr/bin/python3.12 20 \
    && alternatives --install /usr/bin/python3-config python3-config /usr/bin/python3.12-config 20 \
    && python3 --version \
    && python3-config --extension-suffix

# ── Install Bazelisk (auto-installs correct Bazel version from .bazelversion) ──
RUN curl -fsSL -o /usr/local/bin/bazel \
        https://github.com/bazelbuild/bazelisk/releases/download/v1.23.0/bazelisk-linux-amd64 \
    && chmod +x /usr/local/bin/bazel \
    && bazel version 2>/dev/null || true

# ── Copy repo into image ───────────────────────────────────────────────────────
WORKDIR /build/avplumber
COPY deps/       deps/
COPY src/        src/
COPY scripts/    scripts/
COPY generate_node_list Makefile ./
# .git is needed for git describe in build date
COPY .git/       .git/

RUN chmod +x scripts/build_mediapipe_face_mesh.sh && \
    git config --global --add safe.directory /build/avplumber

# ── Build MediaPipe bridge ─────────────────────────────────────────────────────
# This clones mediapipe v0.10.35 (~400 MB) and builds ~4700 Bazel targets.
# Estimated time: 15-30 min first run; incremental rebuilds reuse the Bazel cache.
# --mount=type=cache persists Bazel's action + CAS cache across docker builds.
RUN --mount=type=cache,target=/root/.cache/bazel,id=bazel-mediapipe-cache \
    MEDIAPIPE_BRIDGE_SOURCE_DIR=/build/avplumber/deps/mediapipe-bridge \
    MEDIAPIPE_SRC_DIR=/build/avplumber/deps/mediapipe-src \
    MEDIAPIPE_INSTALL_DIR=/build/avplumber/deps/mediapipe-face-mesh \
    ./scripts/build_mediapipe_face_mesh.sh

# ── Build avplumber python module with HAVE_MEDIAPIPE=1 ───────────────────────
RUN make -j$(nproc) python_module \
        HAVE_MEDIAPIPE=1 HAVE_GL=1 \
        NEURAL_NET_COMMON=1 NEURAL_NET_SPECIFIC=1 \
        HAVE_CUDA=1 HAVE_NVOF_FRUC=0 HAVE_NVCC=1 \
        NVCC=/usr/local/cuda-13.0/bin/nvcc \
        TENSORRT_ROOT=/opt/tensorrt \
        MEDIAPIPE_SRC_DIR=/build/avplumber/deps/mediapipe-src \
        MEDIAPIPE_INSTALL_DIR=/build/avplumber/deps/mediapipe-face-mesh \
        "CXXFLAGS+=-I/usr/local/include -I/usr/local/cuda-13.0/include -I/usr/local/cuda-13.0/targets/x86_64-linux/include" \
        "LFLAGS+=-L/usr/local/lib -Wl,-rpath,/usr/local/lib -L/usr/local/cuda-13.0/targets/x86_64-linux/lib -Wl,-rpath,/usr/local/cuda-13.0/targets/x86_64-linux/lib" \
    && ls -lh _avplumber*.so

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM avp-builder:courtsegm

RUN dnf -y install mesa-libEGL mesa-libGLES python3.12 python3.12-devel \
        opencv opencv-video && dnf clean all \
    && python3.12 -m ensurepip --upgrade \
    && python3.12 -m pip install --quiet cupy-cuda13x \
    && alternatives --install /usr/bin/python3       python3       /usr/bin/python3.12 20 \
    && alternatives --install /usr/bin/python3-config python3-config /usr/bin/python3.12-config 20

COPY --from=builder /build/avplumber/_avplumber.cpython-312-x86_64-linux-gnu.so \
                    /opt/avplumber/
COPY --from=builder /build/avplumber/deps/mediapipe-face-mesh/lib/libavp_mediapipe_face_mesh.so \
                    /opt/avplumber/deps/mediapipe-face-mesh/lib/
COPY --from=builder /build/avplumber/deps/mediapipe-face-mesh/share/ \
                    /opt/avplumber/deps/mediapipe-face-mesh/share/
COPY pyplumber/ /opt/avplumber/pyplumber/

# The _avplumber.so has RPATH /build/avplumber/deps/mediapipe-face-mesh/lib/ baked in at build time.
# Symlink that path to where the .so actually lives in the runtime image.
RUN mkdir -p /build/avplumber/deps/mediapipe-face-mesh && \
    ln -s /opt/avplumber/deps/mediapipe-face-mesh/lib \
          /build/avplumber/deps/mediapipe-face-mesh/lib

ENV PYTHONPATH=/opt/avplumber
ENV LD_LIBRARY_PATH=/usr/local/lib:/opt/tensorrt/lib:/usr/local/cuda-13.0/targets/x86_64-linux/lib:/opt/avplumber/deps/mediapipe-face-mesh/lib
ENV AVP_FACE_RESOURCE_ROOT=/opt/avplumber/deps/mediapipe-face-mesh/share

WORKDIR /opt/avplumber
ENTRYPOINT ["python3.12", "pyplumber/examples/mediapipe-face-landmarker.py"]
