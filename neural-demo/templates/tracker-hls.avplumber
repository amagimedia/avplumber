hwaccel.init { "name": "@gpu", "type": "cuda" }

queue.plan_capacity * 14

node.add { "type": "input", "url": "__INPUT__", "dst": "in_v", "group": "in", "name": "input", "timeout": -1, "auto_restart": "panic", "stop_delay": 5000 }
