node.add { "type": "player_tracker", "src": "v_classified", "dst": "v_tracked_players", "group": "in", "metadata_key": "yolo_players", "target_labels": ["Player"], "frame_rate": 25, "track_buffer": 90, "predict_on_empty": true, "track_thresh": 0.2, "high_thresh": 0.85, "camera_shot_metadata_key": "camera_shot_info", "debug_log_every_n": 30 }
