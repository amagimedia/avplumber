+
+void OffScreenVideoConsumer::Invalidate() {
+  // RequestRefreshFrame() may resend the last captured buffer. Reapplying the
+  // unchanged constraints invalidates captured content and requests a new GPU
+  // copy without restarting the capturer or replacing its buffer pool.
+  video_capturer_->SetResolutionConstraints(
+      gfx::Size(1, 1),
+      gfx::Size(media::limits::kMaxDimension, media::limits::kMaxDimension),
+      false);
 }

