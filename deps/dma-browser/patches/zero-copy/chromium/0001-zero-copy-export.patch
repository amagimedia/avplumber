+class SkSurface;
+
+namespace gpu {
+class MemoryTracker;
+class SharedImageFactory;
+class SharedImageRepresentationFactory;
+}  // namespace gpu
+
+namespace viz {
+
+// avplumber: an offscreen output device (Linux, Ozone, Ganesh GL only) that
+// paints the root render pass straight into native-pixmap SharedImages
+// allocated like the video capturer's native-handle pool buffers (GBM
+// RENDERING|SCANOUT|TEXTURING). The buffer that was just drawn can be lent to
+// a CopyOutputRequest (see SkiaOutputSurfaceImplOnGpu::CopyOutputAvpExport);
+// a lent buffer is never painted again until ReleaseBuffer() is called for it.
+//
+// Buffer states:
+//   kFree      idle, in `free_`
+//   kPainting  the current frame is being drawn into it (at most one)
+//   kLent      handed to a consumer; untouchable until released
+//   kRetired   lent, but Reshape() changed the geometry; destroyed on release
+//
+// The pool is a bounded queue of exactly capacity() buffers (the feature
+// parameter, 2 to 16): allocated lazily up to the capacity and never freed
+// while the display keeps its size, format and colour space (not on
+// DiscardBackbuffer, not when idle), because every allocation or destruction
+// of a native pixmap, and every fresh import of one by the consumer, is a
+// heavy driver call that was seen to stall other processes' GPU work. There is
+// no spare and no scratch texture: when every buffer is lent, the owner
+// (SkiaOutputSurfaceImplOnGpu) asks CanBeginPaint() first and skips painting
+// that frame altogether (counted in `skipped`), so nothing blocks and nothing
+// is overwritten. Free buffers are reused in FIFO order so that every buffer
+// reaches the consumer regularly and its import stays warm there (the mixer
+// forgets an import that was not used for a few seconds).
+//
+// Correctness of content does not depend on buffer history: the device reports
+// supports_post_sub_buffer = false, so DirectRenderer redraws the whole root
+// pass every frame.
+//
+// All methods run on the GPU thread.
+class VIZ_SERVICE_EXPORT SkiaOutputDeviceAvpExport : public SkiaOutputDevice {
+ public:
+  struct ExportedBuffer {
+    ExportedBuffer();
+    ExportedBuffer(ExportedBuffer&&);
+    ExportedBuffer& operator=(ExportedBuffer&&);
+    ~ExportedBuffer();
+
+    uint64_t buffer_id = 0;
+    gpu::Mailbox mailbox;
+    SharedImageFormat format = SinglePlaneFormat::kRGBA_8888;
+    gfx::Size size;
+    gfx::ColorSpace color_space;
+    // A dup of the buffer's native handle, owned by the caller.
+    gfx::GpuMemoryBufferHandle handle;
+  };
+
+  // The queue's capacity: features::kAvpZeroCopyExportBuffers, 2 to 16.
+  size_t capacity() const { return capacity_; }
+
+  // Whether BeginPaint() would find or make a buffer. False when every buffer
+  // is lent: the caller skips the frame (and calls OnPaintSkipped()).
+  bool CanBeginPaint() const;
+  void OnPaintSkipped();
+
+  // Returns nullptr when this configuration is not supported (not Ganesh GL),
+  // in which case the caller should fall back to SkiaOutputDeviceOffscreen.
+  static std::unique_ptr<SkiaOutputDeviceAvpExport> Create(
+      scoped_refptr<gpu::SharedContextState> context_state,
+      gpu::SharedImageFactory* shared_image_factory,
+      gpu::SharedImageRepresentationFactory* representation_factory,
+      bool has_alpha,
+      scoped_refptr<gpu::MemoryTracker> memory_tracker,
+      DidSwapBufferCompleteCallback did_swap_buffer_complete_callback);
+
+  SkiaOutputDeviceAvpExport(const SkiaOutputDeviceAvpExport&) = delete;
+  SkiaOutputDeviceAvpExport& operator=(const SkiaOutputDeviceAvpExport&) =
+      delete;
+
+  ~SkiaOutputDeviceAvpExport() override;
+
+  // SkiaOutputDevice:
+  bool Reshape(const ReshapeParams& params) override;
+  void Present(const std::optional<gfx::Rect>& update_rect,
+               BufferPresentedCallback feedback,
+               OutputSurfaceFrame frame) override;
+  void EnsureBackbuffer() override;
+  void DiscardBackbuffer() override;
+  SkSurface* BeginPaint(
+      std::vector<GrBackendSemaphore>* end_semaphores) override;
+  void EndPaint() override;
+
+  // Lends the buffer the current frame is being painted into. Must be called
+  // between BeginPaint() and EndPaint(), after the root pass was flushed. Fails
+  // (nullopt) when this frame's buffer was already lent.
+  // The buffer becomes kLent at EndPaint() and stays so until ReleaseBuffer().
+  std::optional<ExportedBuffer> ExportCurrentBuffer();
+
+  // Returns a lent buffer to the free list (or destroys it if its geometry is
+  // stale). Unknown ids are ignored.
+  void ReleaseBuffer(uint64_t buffer_id);
+
+  // Recycling a matching buffer only changes its queue state. A GL context
+  // is needed only when release destroys a retired backing after a reshape.
+  bool ReleaseNeedsContext(uint64_t buffer_id) const;
+
+  size_t lent_count_for_testing() const { return lent_count_; }
+  size_t allocated_count_for_testing() const { return buffers_.size(); }
+  uint64_t allocations_for_testing() const { return allocations_; }
+  uint64_t frees_for_testing() const { return frees_; }
+  uint64_t skipped_paints_for_testing() const { return skipped_paints_; }
+
+ private:
+  enum class State { kFree, kPainting, kLent, kRetired };
+
+  struct Buffer {
+    Buffer();
+    ~Buffer();
+
+    uint64_t id = 0;
+    gpu::Mailbox mailbox;
+    std::unique_ptr<gpu::SkiaImageRepresentation> representation;
+    gfx::GpuMemoryBufferHandle handle;
+    gfx::Size size;
+    SharedImageFormat format = SinglePlaneFormat::kRGBA_8888;
+    gfx::ColorSpace color_space;
+    State state = State::kFree;
+    // A release that arrived while the buffer was still kPainting (should not
+    // happen in practice: the release travels through two processes).
+    bool released_while_painting = false;
+    uint64_t estimated_size = 0;
+  };
+
+  SkiaOutputDeviceAvpExport(
+      scoped_refptr<gpu::SharedContextState> context_state,
+      gpu::SharedImageFactory* shared_image_factory,
+      gpu::SharedImageRepresentationFactory* representation_factory,
+      bool has_alpha,
+      scoped_refptr<gpu::MemoryTracker> memory_tracker,
+      DidSwapBufferCompleteCallback did_swap_buffer_complete_callback);
+
+  bool MatchesCurrentGeometry(const Buffer& buffer) const;
+  Buffer* AllocateBuffer();
+  void DestroyBuffer(Buffer* buffer);
+  Buffer* FindBuffer(uint64_t buffer_id);
+  void FreeStaleIdleBuffers();
+  void LogCounters();
+
+  scoped_refptr<gpu::SharedContextState> context_state_;
+  const raw_ptr<gpu::SharedImageFactory> shared_image_factory_;
+  const raw_ptr<gpu::SharedImageRepresentationFactory> representation_factory_;
+  const size_t capacity_;
+
+  // Current geometry from Reshape().
+  gfx::Size size_;
+  SkColorType sk_color_type_ = kUnknown_SkColorType;
+  sk_sp<SkColorSpace> sk_color_space_;
+  gfx::ColorSpace color_space_;
+  SkAlphaType alpha_type_ = kPremul_SkAlphaType;
+  SharedImageFormat format_ = SinglePlaneFormat::kRGBA_8888;
+  int sample_count_ = 1;
+
+  std::vector<std::unique_ptr<Buffer>> buffers_;
+  // Free buffers in FIFO order: the least recently used one is painted next.
+  base::circular_deque<raw_ptr<Buffer>> free_;
+  raw_ptr<Buffer> current_ = nullptr;
+  std::unique_ptr<gpu::SkiaImageRepresentation::ScopedWriteAccess>
+      current_access_;
+  bool current_donated_ = false;
+  uint64_t next_buffer_id_ = 1;
+  size_t lent_count_ = 0;
+
+  // Lifetime counters, logged every 5 s.
+  uint64_t allocations_ = 0;
+  uint64_t frees_ = 0;
+  uint64_t exported_frames_ = 0;
+  uint64_t skipped_paints_ = 0;
+  uint64_t painted_frames_ = 0;
+  base::TimeTicks last_counter_log_;
+};
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_SKIA_OUTPUT_DEVICE_AVP_EXPORT_H_
