+    scoped_refptr<gpu::SharedContextState> context_state,
+    gpu::SharedImageFactory* shared_image_factory,
+    gpu::SharedImageRepresentationFactory* representation_factory,
+    bool has_alpha,
+    scoped_refptr<gpu::MemoryTracker> memory_tracker,
+    DidSwapBufferCompleteCallback did_swap_buffer_complete_callback) {
+  if (!context_state || !context_state->gr_context() ||
+      !context_state->GrContextIsGL()) {
+    LOG(WARNING) << "AvpExport: not Ganesh GL, falling back to the offscreen "
+                    "device.";
+    return nullptr;
+  }
+  if (!shared_image_factory || !representation_factory) {
+    return nullptr;
+  }
+  return std::unique_ptr<SkiaOutputDeviceAvpExport>(
+      new SkiaOutputDeviceAvpExport(
+          std::move(context_state), shared_image_factory,
+          representation_factory, has_alpha, std::move(memory_tracker),
+          std::move(did_swap_buffer_complete_callback)));
+}
+
+SkiaOutputDeviceAvpExport::SkiaOutputDeviceAvpExport(
+    scoped_refptr<gpu::SharedContextState> context_state,
+    gpu::SharedImageFactory* shared_image_factory,
+    gpu::SharedImageRepresentationFactory* representation_factory,
+    bool /*has_alpha: each Reshape() says whether the buffers carry alpha*/,
+    scoped_refptr<gpu::MemoryTracker> memory_tracker,
+    DidSwapBufferCompleteCallback did_swap_buffer_complete_callback)
+    : SkiaOutputDevice(context_state->gr_context(),
+                       /*graphite_shared_context=*/nullptr,
+                       std::move(memory_tracker),
+                       std::move(did_swap_buffer_complete_callback)),
+      context_state_(std::move(context_state)),
+      shared_image_factory_(shared_image_factory),
+      representation_factory_(representation_factory),
+      capacity_(static_cast<size_t>(
+          std::clamp(features::kAvpZeroCopyExportBuffers.Get(), 2, 16))) {
+  LOG(INFO) << "AvpExport: capacity " << capacity_
+            << " buffers per display, total; a frame with no free buffer is "
+               "not painted";
+  capabilities_.uses_default_gl_framebuffer = false;
+  capabilities_.output_surface_origin = gfx::SurfaceOrigin::kTopLeft;
+  // No partial swap: buffers rotate, so the renderer must redraw the whole
+  // root pass every frame (DirectRenderer::DrawFrame, use_partial_swap_).
+  capabilities_.supports_post_sub_buffer = false;
+  capabilities_.renderer_allocates_images = false;
+  capabilities_.avp_zero_copy_export = true;
+
+  // Same map as SkiaOutputDeviceOffscreen. The display pipeline asks for
+  // RGBA_8888 for our windows, which becomes a DRM ABGR8888 pixmap; the
+  // consumer sees the format it actually gets through the result.
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kRGBA_8888] =
+      kRGBA_8888_SkColorType;
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kRGBX_8888] =
+      kRGBA_8888_SkColorType;
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kBGRA_8888] =
+      kBGRA_8888_SkColorType;
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kBGRX_8888] =
+      kBGRA_8888_SkColorType;
+  capabilities_.sk_color_type_map[SinglePlaneFormat::kRGBA_F16] =
+      kRGBA_F16_SkColorType;
+}
+
+SkiaOutputDeviceAvpExport::~SkiaOutputDeviceAvpExport() {
+  DCHECK(!current_access_);
+  // Release the representations here; the backings are destroyed by the
+  // owner's SharedImageFactory (DestroyAllSharedImages) right after this
+  // device, with the context current or marked lost as appropriate. Lent
+  // buffers stay readable by their consumers through the dma-buf fds.
+  const bool context_lost = context_state_->context_lost();
+  for (auto& buffer : buffers_) {
+    if (buffer->representation) {
+      if (context_lost) {
+        buffer->representation->OnContextLost();
+      }
+      buffer->representation.reset();
+    }
+    memory_type_tracker_->TrackMemFree(buffer->estimated_size);
+  }
+  free_.clear();
+  current_ = nullptr;
+  buffers_.clear();
+}
+
+bool SkiaOutputDeviceAvpExport::Reshape(const ReshapeParams& params) {
+  DCHECK_EQ(params.transform, gfx::OVERLAY_TRANSFORM_NONE);
+  DCHECK(!current_);
+  const gfx::Size size = params.GfxSize();
+  if (size.width() > capabilities_.max_texture_size ||
+      size.height() > capabilities_.max_texture_size) {
+    LOG(ERROR) << "AvpExport: the requested size (" << size.ToString()
+               << ") exceeds the max texture size ("
+               << capabilities_.max_texture_size << ")";
+    return false;
+  }
+  size_ = size;
+  sk_color_type_ = params.image_info.colorType();
+  sk_color_space_ = params.image_info.refColorSpace();
+  color_space_ = params.color_space;
+  alpha_type_ = params.image_info.alphaType();
+  sample_count_ = params.sample_count;
+  format_ = SkColorTypeToSinglePlaneSharedImageFormat(sk_color_type_);
+  LOG(INFO) << "AvpExport: reshape " << size_.ToString() << " format "
+            << format_.ToString() << " sk_color_type "
+            << static_cast<int>(sk_color_type_) << " alpha_type "
+            << static_cast<int>(alpha_type_)
+            << " (SkAlphaType: 1=opaque, 2=premul, 3=unpremul) color_space "
+            << color_space_.ToString() << " samples " << sample_count_;
+
+  // Idle buffers of the old geometry go now; lent ones go when released.
+  // Buffers that still match are kept: this is the only place (besides the
+  // destructor) where a matching buffer could have been dropped.
+  FreeStaleIdleBuffers();
+  for (auto& buffer : buffers_) {
+    if (buffer->state == State::kLent && !MatchesCurrentGeometry(*buffer)) {
+      buffer->state = State::kRetired;
+    }
+  }
+  return true;
+}
+
+void SkiaOutputDeviceAvpExport::Present(
+    const std::optional<gfx::Rect>& update_rect,
+    BufferPresentedCallback feedback,
+    OutputSurfaceFrame frame) {
+  // Nothing to present to: the frame is consumed through ExportCurrentBuffer.
+  StartSwapBuffers(std::move(feedback));
+  FinishSwapBuffers(gfx::SwapCompletionResult(gfx::SwapResult::SWAP_ACK),
+                    size_, std::move(frame));
+}
+
+void SkiaOutputDeviceAvpExport::EnsureBackbuffer() {
+  // Buffers are allocated lazily in BeginPaint().
+}
+
+void SkiaOutputDeviceAvpExport::DiscardBackbuffer() {
+  // Deliberately keeps the buffers: freeing and re-allocating native pixmaps
+  // is what must not happen while the display lives.
+}
+
+bool SkiaOutputDeviceAvpExport::CanBeginPaint() const {
+  if (current_) {
+    return false;
+  }
+  for (const Buffer* buffer : free_) {
+    if (MatchesCurrentGeometry(*buffer)) {
+      return true;
+    }
+  }
+  return buffers_.size() < capacity_ && !size_.IsEmpty();
+}
+
+void SkiaOutputDeviceAvpExport::OnPaintSkipped() {
+  ++skipped_paints_;
+  LogCounters();
+  AVP_LOG_WARNING_RATE_LIMITED(
+      "paint skipped: all " << buffers_.size() << " of " << capacity_
+                            << " buffers are lent (" << skipped_paints_
+                            << " skipped so far)");
+}
+
+bool SkiaOutputDeviceAvpExport::MatchesCurrentGeometry(
+    const Buffer& buffer) const {
+  return buffer.size == size_ && buffer.format == format_ &&
+         buffer.color_space == color_space_;
+}
+
+void SkiaOutputDeviceAvpExport::FreeStaleIdleBuffers() {
+  base::circular_deque<raw_ptr<Buffer>> keep;
+  std::vector<Buffer*> destroy;
+  for (Buffer* buffer : free_) {
+    if (MatchesCurrentGeometry(*buffer)) {
+      keep.push_back(buffer);
+    } else {
+      destroy.push_back(buffer);
+    }
+  }
+  free_.swap(keep);
+  for (Buffer* buffer : destroy) {
+    DestroyBuffer(buffer);
+  }
+}
+
+void SkiaOutputDeviceAvpExport::LogCounters() {
+  // The macro's static timer is shared by every display on this GPU thread.
+  // Keep a timer per device so an exhausted window cannot hide behind a
+  // healthy one's log; also called when no BeginPaint can run.
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!last_counter_log_.is_null() &&
+      now - last_counter_log_ < base::Seconds(5)) {
+    return;
+  }
+  last_counter_log_ = now;
+  LOG(INFO) << "AvpExport: buffers: device=" << this
+                           << " capacity=" << capacity_ << " pool=" << buffers_.size()
+                           << " free=" << free_.size()
+                           << " lent=" << lent_count_
+                           << " allocations=" << allocations_
+                           << " frees=" << frees_
+                           << " painted=" << painted_frames_
+                           << " exported=" << exported_frames_
+                           << " skipped=" << skipped_paints_ << " size "
+                           << size_.ToString();
+}
+
+SkiaOutputDeviceAvpExport::Buffer* SkiaOutputDeviceAvpExport::FindBuffer(
+    uint64_t buffer_id) {
+  for (auto& buffer : buffers_) {
+    if (buffer->id == buffer_id) {
+      return buffer.get();
+    }
+  }
+  return nullptr;
+}
+
+SkiaOutputDeviceAvpExport::Buffer* SkiaOutputDeviceAvpExport::AllocateBuffer() {
+  TRACE_EVENT0("viz", "SkiaOutputDeviceAvpExport::AllocateBuffer");
+  if (size_.IsEmpty() || sk_color_type_ == kUnknown_SkColorType) {
+    return nullptr;
+  }
+
+  // 1. A native pixmap, exactly as the capturer's native-handle pool gets it:
+  //    BufferUsage::SCANOUT -> GBM RENDERING|SCANOUT|TEXTURING, no LINEAR.
+  gfx::GpuMemoryBufferHandle handle =
+      shared_image_factory_->CreateNativeGpuMemoryBufferHandle(
+          size_, format_, gfx::BufferUsage::SCANOUT);
+  if (handle.is_null() || handle.type != gfx::NATIVE_PIXMAP) {
+    LOG(ERROR) << "AvpExport: CreateNativeGpuMemoryBufferHandle failed for "
+               << size_.ToString() << " " << format_.ToString();
+    return nullptr;
+  }
+  // Keep a dup for export; the backing takes the original.
+  gfx::GpuMemoryBufferHandle export_handle = handle.Clone();
+  if (export_handle.is_null()) {
+    LOG(ERROR) << "AvpExport: failed to clone the native handle";
+    return nullptr;
+  }
+
+  // 2. The backing (OzoneImageBacking) around it.
+  const gpu::Mailbox mailbox = gpu::Mailbox::Generate();
+  gpu::SharedImageInfo info(format_, size_, color_space_,
+                            kTopLeft_GrSurfaceOrigin, alpha_type_,
+                            BufferUsage(), "AvpZeroCopyExport");
+  if (!shared_image_factory_->CreateSharedImage(mailbox, info,
+                                                std::move(handle))) {
+    LOG(ERROR) << "AvpExport: CreateSharedImage failed";
+    return nullptr;
+  }
+
+  // 3. A Skia representation to paint through.
+  auto representation =
+      representation_factory_->ProduceSkia(mailbox, context_state_);
+  if (!representation) {
+    LOG(ERROR) << "AvpExport: ProduceSkia failed";
+    shared_image_factory_->DestroySharedImage(mailbox);
+    return nullptr;
+  }
+
+  auto buffer = std::make_unique<Buffer>();
+  buffer->id = next_buffer_id_++;
+  buffer->mailbox = mailbox;
+  buffer->representation = std::move(representation);
+  buffer->handle = std::move(export_handle);
+  buffer->size = size_;
+  buffer->format = format_;
+  buffer->color_space = color_space_;
+  buffer->state = State::kFree;
+  buffer->estimated_size =
+      SkImageInfo::Make(size_.width(), size_.height(), sk_color_type_,
+                        alpha_type_)
+          .computeMinByteSize();
+  memory_type_tracker_->TrackMemAlloc(buffer->estimated_size);
+
+  buffers_.push_back(std::move(buffer));
+  ++allocations_;
+  LOG(INFO) << "AvpExport: allocated buffer " << buffers_.back()->id << " "
+            << size_.ToString() << " " << format_.ToString() << " ("
+            << buffers_.size() << " allocated, " << lent_count_
+            << " lent, " << allocations_ << " allocations so far)";
+  return buffers_.back().get();
+}
+
+void SkiaOutputDeviceAvpExport::DestroyBuffer(Buffer* buffer) {
+  DCHECK(buffer);
+  DCHECK_NE(buffer, current_.get());
+  if (buffer->representation) {
+    if (context_state_->context_lost()) {
+      buffer->representation->OnContextLost();
+    }
+    buffer->representation.reset();
+  }
+  shared_image_factory_->DestroySharedImage(buffer->mailbox);
+  memory_type_tracker_->TrackMemFree(buffer->estimated_size);
+  ++frees_;
+  LOG(INFO) << "AvpExport: destroyed buffer " << buffer->id << " ("
+            << frees_ << " frees so far)";
+  for (auto it = free_.begin(); it != free_.end();) {
+    it = (it->get() == buffer) ? free_.erase(it) : it + 1;
+  }
+  std::erase_if(buffers_, [buffer](const std::unique_ptr<Buffer>& b) {
+    return b.get() == buffer;
+  });
+}
+
+SkSurface* SkiaOutputDeviceAvpExport::BeginPaint(
+    std::vector<GrBackendSemaphore>* end_semaphores) {
+  TRACE_EVENT0("viz", "SkiaOutputDeviceAvpExport::BeginPaint");
+  DCHECK(!current_);
+  DCHECK(!current_access_);
+  current_donated_ = false;
+  ++painted_frames_;
+  LogCounters();
+
+  // Oldest free buffer first (FIFO), see the class comment.
+  Buffer* buffer = nullptr;
+  while (!free_.empty()) {
+    Buffer* candidate = free_.front();
+    free_.pop_front();
+    if (MatchesCurrentGeometry(*candidate)) {
+      buffer = candidate;
+      break;
+    }
+    DestroyBuffer(candidate);
+  }
+  if (!buffer && buffers_.size() < capacity_) {
+    buffer = AllocateBuffer();
+  }
+  if (!buffer) {
+    // The owner checks CanBeginPaint() first; reaching this means an
+    // allocation failed. Returning null marks the context lost, like the
+    // other output devices do when they cannot provide a surface.
+    LOG(ERROR) << "AvpExport: no buffer to paint into (" << buffers_.size()
+               << " of " << capacity_ << " allocated, " << lent_count_
+               << " lent)";
+    return nullptr;
+  }
+
+  std::vector<GrBackendSemaphore> begin_semaphores;
+  current_access_ = buffer->representation->BeginScopedWriteAccess(
+      sample_count_, SkSurfaceProps(), &begin_semaphores, end_semaphores,
+      gpu::SharedImageRepresentation::AllowUnclearedAccess::kYes);
+  if (!current_access_) {
+    LOG(ERROR) << "AvpExport: BeginScopedWriteAccess failed for buffer "
+               << buffer->id;
+    free_.push_back(buffer);
+    return nullptr;
+  }
+  SkSurface* surface = current_access_->surface();
+  if (!surface) {
+    LOG(ERROR) << "AvpExport: no SkSurface for buffer " << buffer->id;
+    current_access_.reset();
+    free_.push_back(buffer);
+    return nullptr;
+  }
+  if (!begin_semaphores.empty()) {
+    surface->wait(begin_semaphores.size(), begin_semaphores.data(),
+                  /*deleteSemaphoresAfterWait=*/false);
+  }
+  buffer->state = State::kPainting;
+  buffer->released_while_painting = false;
+  current_ = buffer;
+  return surface;
+}
+
+void SkiaOutputDeviceAvpExport::EndPaint() {
+  TRACE_EVENT0("viz", "SkiaOutputDeviceAvpExport::EndPaint");
+  DCHECK(current_);
+  DCHECK(current_access_);
+  Buffer* buffer = current_;
+  buffer->representation->SetCleared();
+  // Ends the GL access; OzoneImageBacking records its own write fence, which
+  // only matters for other Chromium-side readers.
+  current_access_.reset();
+
+  if (current_donated_ && !buffer->released_while_painting) {
+    buffer->state = State::kLent;
+    ++lent_count_;
+  } else {
+    buffer->state = State::kFree;
+    free_.push_back(buffer);
+  }
+  buffer->released_while_painting = false;
+  current_ = nullptr;
+  current_donated_ = false;
+}
+
+std::optional<SkiaOutputDeviceAvpExport::ExportedBuffer>
+SkiaOutputDeviceAvpExport::ExportCurrentBuffer() {
+  if (!current_ || current_donated_) {
+    return std::nullopt;
+  }
+  current_donated_ = true;
+  ++exported_frames_;
+  ExportedBuffer exported;
+  exported.buffer_id = current_->id;
+  exported.mailbox = current_->mailbox;
+  exported.format = current_->format;
+  exported.size = current_->size;
+  exported.color_space = current_->color_space;
+  exported.handle = current_->handle.Clone();
+  if (exported.handle.is_null()) {
+    LOG(ERROR) << "AvpExport: failed to clone the handle of buffer "
+               << current_->id;
+    current_donated_ = false;
+    return std::nullopt;
+  }
+  return exported;
+}
+
+bool SkiaOutputDeviceAvpExport::ReleaseNeedsContext(uint64_t buffer_id) const {
+  for (const auto& buffer : buffers_) {
+    if (buffer->id == buffer_id) {
+      return buffer->state == State::kRetired ||
+             (buffer->state == State::kLent && !MatchesCurrentGeometry(*buffer));
+    }
+  }
+  return false;
+}
+
+void SkiaOutputDeviceAvpExport::ReleaseBuffer(uint64_t buffer_id) {
+  Buffer* buffer = FindBuffer(buffer_id);
+  if (!buffer) {
+    // Already destroyed (device recreated or the buffer was retired and
+    // destroyed on an earlier release). Nothing to do.
+    return;
+  }
+  switch (buffer->state) {
+    case State::kLent:
+    case State::kRetired:
+      DCHECK_GT(lent_count_, 0u);
+      --lent_count_;
+      if (buffer->state == State::kLent && MatchesCurrentGeometry(*buffer)) {
+        buffer->state = State::kFree;
+        free_.push_back(buffer);
+      } else {
+        DestroyBuffer(buffer);
+      }
+      break;
+    case State::kPainting:
+      // The release overtook EndPaint(); EndPaint() will free it.
+      buffer->released_while_painting = true;
+      break;
+    case State::kFree:
+      DLOG(WARNING) << "AvpExport: release of a free buffer " << buffer_id;
+      break;
+  }
+}
+
+}  // namespace viz
