--- /dev/null
+++ b/components/viz/common/avp_log.h
@@ -0,0 +1,37 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_VIZ_COMMON_AVP_LOG_H_
+#define COMPONENTS_VIZ_COMMON_AVP_LOG_H_
+
+#include "base/logging.h"
+#include "base/time/time.h"
+
+// avplumber: LOG(WARNING) at most once per second per call site, with a count
+// of the suppressed repetitions. Used on every branch of the zero-copy export
+// path that drops a frame, so that a run with no frames tells where they stop.
+// Each call site is expected to run on one thread; the statics are not locked.
+#define AVP_LOG_RATE_LIMITED(severity, period, message)                  \
+  do {                                                                   \
+    static base::TimeTicks avp_last_log_time;                            \
+    static int avp_suppressed = 0;                                       \
+    const base::TimeTicks avp_now = base::TimeTicks::Now();              \
+    if (avp_last_log_time.is_null() ||                                   \
+        avp_now - avp_last_log_time >= (period)) {                       \
+      LOG(severity) << "AvpExport: " << message                          \
+                    << " [suppressed since last: " << avp_suppressed     \
+                    << "]";                                              \
+      avp_last_log_time = avp_now;                                       \
+      avp_suppressed = 0;                                                \
+    } else {                                                             \
+      ++avp_suppressed;                                                  \
+    }                                                                    \
+  } while (0)
+
+#define AVP_LOG_WARNING_RATE_LIMITED(message) \
+  AVP_LOG_RATE_LIMITED(WARNING, base::Seconds(1), message)
+#define AVP_LOG_INFO_RATE_LIMITED(message) \
+  AVP_LOG_RATE_LIMITED(INFO, base::Seconds(5), message)
+
+#endif  // COMPONENTS_VIZ_COMMON_AVP_LOG_H_
