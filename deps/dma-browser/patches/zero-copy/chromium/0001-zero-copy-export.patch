+      : impl_on_gpu(std::move(impl)),
+        request(std::move(request)),
+        result(std::move(result)) {}
+
+  static void OnFinished(GrGpuFinishedContext c) {
+    std::unique_ptr<AvpExportFinishedContext> context(
+        static_cast<AvpExportFinishedContext*>(c));
+    if (context->impl_on_gpu) {
+      context->impl_on_gpu->ReadbackDone();
+    }
+    context->request->SendResult(std::move(context->result));
+  }
+
+  base::WeakPtr<SkiaOutputSurfaceImplOnGpu> impl_on_gpu;
+  std::unique_ptr<CopyOutputRequest> request;
+  std::unique_ptr<CopyOutputResult> result;
+};
