+void SkiaOutputSurfaceImplOnGpu::CopyOutputAvpExport(
+    const copy_output::RenderPassGeometry& geometry,
+    std::unique_ptr<CopyOutputRequest> request,
+    bool from_framebuffer) {
+  TRACE_EVENT0("viz", "SkiaOutputSurfaceImplOnGpu::CopyOutputAvpExport");
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  DCHECK(request->avp_zero_copy_export());
+
+  auto fail = [&]() {
+    request->SendError(CopyOutputResult::Error::kUnknown);
+  };
+
+#if !BUILDFLAG(IS_LINUX)
+  AVP_LOG_WARNING_RATE_LIMITED("cannot lend: zero-copy export is Linux only");
+  fail();
+  return;
+#else
+  if (!from_framebuffer) {
+    AVP_LOG_WARNING_RATE_LIMITED(
+        "cannot lend: request is for a render pass, not the root framebuffer");
+    fail();
+    return;
+  }
+  if (!avp_export_device_) {
+    AVP_LOG_WARNING_RATE_LIMITED(
+        "cannot lend: this output surface has no zero-copy export device");
+    fail();
+    return;
+  }
+  if (!scoped_output_device_paint_) {
+    AVP_LOG_WARNING_RATE_LIMITED(
+        "cannot lend: this frame was not painted (every buffer of the queue "
+        "is lent; the consumer holds them)");
+    fail();
+    return;
+  }
+  if (request->has_blit_request() || request->is_scaled() ||
+      request->result_format() != CopyOutputRequest::ResultFormat::RGBA ||
+      request->result_destination() !=
+          CopyOutputRequest::ResultDestination::kSharedImage) {
+    AVP_LOG_WARNING_RATE_LIMITED(
+        "cannot lend: request is not an unscaled RGBA shared-image request "
+        "(blit=" << request->has_blit_request()
+                 << " scaled=" << request->is_scaled() << ")");
+    fail();
+    return;
+  }
+  if (geometry.result_selection != gfx::Rect(size_) ||
+      geometry.sampling_bounds != gfx::Rect(size_)) {
+    AVP_LOG_WARNING_RATE_LIMITED(
+        "cannot lend: request does not cover the whole surface (selection "
+        << geometry.result_selection.ToString() << ", sampling "
+        << geometry.sampling_bounds.ToString() << ", surface "
+        << size_.ToString() << ")");
+    fail();
+    return;
+  }
+
+  std::optional<SkiaOutputDeviceAvpExport::ExportedBuffer> exported =
+      avp_export_device_->ExportCurrentBuffer();
+  if (!exported) {
+    AVP_LOG_WARNING_RATE_LIMITED(
+        "cannot lend: this frame's buffer was already lent to another request");
+    fail();
+    return;
+  }
+
+  // The root pass was flushed in FinishPaintCurrentFrame(); a fence created
+  // now is ordered after it in this context's command stream.
+  const bool fence_supported = gl::GLFence::IsGpuFenceSupported();
+  gfx::GpuFenceHandle acquire_fence;
+  if (fence_supported) {
+    acquire_fence = CreateReleaseFenceForGL();
+  }
+
+  auto result = std::make_unique<CopyOutputAvpExportResult>(
+      geometry.result_selection, exported->format, exported->color_space,
+      std::move(exported->handle),
+      CreateAvpExportReleaseCallback(exported->buffer_id));
+
+  if (!acquire_fence.is_null()) {
+    result->set_acquire_fence(std::move(acquire_fence));
+    request->SendResult(std::move(result));
+    return;
+  }
+
+  // No native fence available: hold the result until Skia says the GPU is
+  // done, using the same finished-proc poll as mappable readbacks. Correct,
+  // but with the 2 ms poll this build otherwise avoids.
+  static bool logged_fallback = false;
+  if (!logged_fallback) {
+    logged_fallback = true;
+    LOG(WARNING) << "AvpExport: no EGL native fence support; frames are "
+                    "delivered after Skia's finished-proc instead.";
+  }
+  ++num_readbacks_pending_;
+  auto* context = new AvpExportFinishedContext(weak_ptr_, std::move(request),
+                                               std::move(result));
+  std::vector<GrBackendSemaphore> no_semaphores;
+  if (!FlushSurface(/*surface=*/nullptr, no_semaphores,
+                    /*scoped_write_access=*/nullptr,
+                    &AvpExportFinishedContext::OnFinished,
+                    /*graphite_finished_proc=*/nullptr, context)) {
+    // With no semaphores FlushSurface cannot fail for Ganesh; keep the
+    // bookkeeping consistent anyway.
+    FailedSkiaFlush("CopyOutputAvpExport flush");
+  }
+  ScheduleCheckReadbackCompletion();
+#endif  // !BUILDFLAG(IS_LINUX)
+}
+
+ReleaseCallback SkiaOutputSurfaceImplOnGpu::CreateAvpExportReleaseCallback(
+    uint64_t buffer_id) {
+  // Same route as CreateDestroyCopyOutputResourcesOnGpuThreadCallback: the
+  // callback may run on any thread; it posts to the viz thread, which
+  // schedules a GPU task behind the sync token.
+  auto closure_on_gpu_thread =
+      base::BindOnce(&SkiaOutputSurfaceImplOnGpu::ReleaseAvpExportBuffer,
+                     weak_ptr_, buffer_id);
+  ReleaseCallback release_callback = base::BindOnce(
+      [](ScheduleGpuTaskCallback schedule_gpu_task, base::OnceClosure callback,
+         const gpu::SyncToken& sync_token,
+         bool) { schedule_gpu_task.Run(std::move(callback), {sync_token}); },
+      schedule_gpu_task_, std::move(closure_on_gpu_thread));
+  return base::BindPostTask(dependency_->GetClientTaskRunner(),
+                            std::move(release_callback));
+}
+
+void SkiaOutputSurfaceImplOnGpu::ReleaseAvpExportBuffer(uint64_t buffer_id) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+#if BUILDFLAG(IS_LINUX)
+  if (!avp_export_device_) {
+    return;
+  }
+  // Ordinary releases only return a buffer to a CPU-side queue. MakeCurrent()
+  // also invalidates Skia's cached GL state, so doing it on every frame release
+  // forces needless state restoration in the next draw. Only destruction of a
+  // retired backing requires the context here.
+  if (!context_is_lost_ &&
+      avp_export_device_->ReleaseNeedsContext(buffer_id) &&
+      !MakeCurrent(/*need_framebuffer=*/false)) {
+    return;
+  }
+  avp_export_device_->ReleaseBuffer(buffer_id);
+#endif
+}
