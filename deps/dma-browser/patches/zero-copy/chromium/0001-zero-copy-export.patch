+scoped_refptr<media::VideoFrame>
+FrameSinkVideoCapturerImpl::CreateAvpPlaceholderFrame(
+    media::VideoPixelFormat format,
+    const gfx::Size& size,
+    const gfx::ColorSpace& color_space) const {
+  // A VideoFrame with no storage of its own: it only carries format, sizes,
+  // colour space, timestamp and metadata through the delivery code. The
+  // pixels live in the compositor's buffer, which travels as a native handle.
+  gpu::SharedImageMetadata metadata{
+      media::VideoPixelFormatToSharedImageFormat(format).value(),
+      size,
+      color_space,
+      kTopLeft_GrSurfaceOrigin,
+      kPremul_SkAlphaType,
+      gpu::SHARED_IMAGE_USAGE_DISPLAY_READ};
+  scoped_refptr<gpu::ClientSharedImage> shared_image =
+      gpu::ClientSharedImage::CreateForTesting(metadata);  // IN-TEST
+  scoped_refptr<media::VideoFrame> frame = media::VideoFrame::WrapSharedImage(
+      format, std::move(shared_image), gpu::SyncToken(),
+      media::VideoFrame::ReleaseMailboxCB(), gfx::Rect(size), size,
+      base::TimeDelta());
+  CHECK(frame);
+  frame->set_color_space(color_space);
+  return frame;
+}
+
+void FrameSinkVideoCapturerImpl::NotifyAvpFrameReleased(
+    scoped_refptr<media::VideoFrame> frame,
+    std::shared_ptr<AvpExport> avp_export) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  NotifyFrameReleased(std::move(frame));
+  if (avp_zero_copy_mode_) {
+    --avp_outstanding_;
+  }
+  // Return the buffer to the compositor now (the destructor would, too).
+  if (avp_export && avp_export->release_callback) {
+    std::move(avp_export->release_callback)
+        .Run(gpu::SyncToken(), /*is_lost=*/false);
+  }
+}
