+bool SkiaOutputDeviceAvpExport::PreallocatePool() {
+  pool_ready_ = false;
+  if (context_state_->context_lost() || size_.IsEmpty() ||
+      sk_color_type_ == kUnknown_SkColorType) {
+    return false;
+  }
+  // Retired buffers still consume slots until their actual release. Reshape
+  // fills the free slots; ReleaseBuffer fills each retired slot as it returns.
+  // No steady-state paint or matching release can allocate a native buffer.
+  while (buffers_.size() < capacity_) {
+    Buffer* buffer = AllocateBuffer();
+    if (!buffer) {
+      LOG(ERROR) << "AvpExport: pool preallocation failed after "
+                 << buffers_.size() << " of " << capacity_ << " buffers";
+      return false;
+    }
+    free_.push_back(buffer);
+  }
+  CHECK_EQ(buffers_.size(), capacity_);
+  pool_ready_ = true;
+  LOG(INFO) << "AvpExport: pool preallocated: " << buffers_.size()
+            << " buffers, " << free_.size() << " available, size "
+            << size_.ToString();
+  return true;
 }

