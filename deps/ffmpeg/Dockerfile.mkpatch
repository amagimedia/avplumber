# Build the MXL patch on top of the avplumber FFmpeg 8/ or 9/ series.
#
# Usage from the repository root (8/ series example; see mkpatch-mxl.sh for
# the full list of overridable env vars):
#
#   docker build -f deps/ffmpeg/Dockerfile.mkpatch \
#       -t avplumber-mxl-mkpatch:local deps/ffmpeg
#   docker run --rm \
#       -v "$PWD/deps/ffmpeg/8:/out" \
#       -v "$PWD/deps/ffmpeg/8:/patches:ro" \
#       -e OUT_PATCH_NUM=0013 \
#       avplumber-mxl-mkpatch:local
#
# For the 9/ series, point at dmf-mxl/9.0 and the pinned development
# revision instead, with SERIES=9 so mkpatch-finish skips the n8.0/n8.1
# configure re-anchoring:
#
#   docker run --rm \
#       -v "$PWD/deps/ffmpeg/9:/out" \
#       -v "$PWD/deps/ffmpeg/9:/patches:ro" \
#       -e FFMPEG_TAG=98e92563a3b60dbf6d370fd3491d7f896398e4c1 \
#       -e MXL_REMOTE_REF=dmf-mxl/9.0 \
#       -e MXL_PIN=<pinned dmf-mxl/9.0 commit> \
#       -e OUT_PATCH_NUM=0019 \
#       -e SERIES=9 \
#       avplumber-mxl-mkpatch:local
#
# On success this overwrites the numbered
# 0NNN-avformat-libmxl-demuxer-muxer.patch in the mounted /out dir.
#
# Then refresh the matching bases.env from deps/ffmpeg/verify.sh (it prints
# the actual tree for each base when the pinned one no longer matches).
#
# On cherry-pick conflicts the container exits with instructions; drop
# into it with `-it --entrypoint bash` on the same image to finish by hand.

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY mkpatch-mxl.sh    /usr/local/bin/mkpatch-mxl
COPY mkpatch-finish.sh /usr/local/bin/mkpatch-finish
COPY mkpatch-fixups    /fixups
RUN chmod +x /usr/local/bin/mkpatch-mxl /usr/local/bin/mkpatch-finish

ENTRYPOINT ["/usr/local/bin/mkpatch-mxl"]
