From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AVPlumber contributors <avplumber@users.noreply.github.com>
Date: Thu, 19 Nov 2026 14:32:42 +0100
Subject: [PATCH] avformat/mxl: wait for audio tail history at startup

The SDK publishes the continuous flow with headIndex zero before its first audio commit. Wait when the requested historical offset would underflow.

Start the finite FATE readers after their writers have committed every packet and entered the existing teardown handshake. Starting earlier can read pre-roll before the bounded audio and video fixtures are complete.
---
 libavformat/mxldec.c | 19 +++++++------------
 tests/fate/mxl.mak   | 34 ++++++++++++----------------------
 2 files changed, 19 insertions(+), 34 deletions(-)

diff --git a/libavformat/mxldec.c b/libavformat/mxldec.c
index 3c2911af82..b6e9c10f22 100644
--- a/libavformat/mxldec.c
+++ b/libavformat/mxldec.c
@@ -1633,20 +1633,15 @@ static int read_audio_packet(AVFormatContext *s, AVStream *st, AVPacket *pkt,
             // max_audio_samples smaller than readableBufLen and, in
             // that case, align to the final (possibly partial) read
             // block.
-            int readableBufLen = (int)(flow_info->config.continuous.bufferLength / 2);
-            if (0 < p->max_audio_samples && p->max_audio_samples < readableBufLen) {
+            uint64_t lookback = flow_info->config.continuous.bufferLength / 2;
+            if (p->max_audio_samples > 0 && (uint64_t)p->max_audio_samples < lookback) {
                 int rem = p->max_audio_samples % max_samples_per_read;
-                uint64_t start_index = flow_info->runtime.headIndex -
-                    (uint64_t)(p->max_audio_samples - (rem ? rem : max_samples_per_read));
-                av_assert0(flow_info->runtime.headIndex >= start_index);
-                stream_ctx->flow.audio.mxl_sample_index = start_index;
-            }
-            else {
-                uint64_t start_index =
-                    flow_info->runtime.headIndex - readableBufLen;
-                av_assert0(flow_info->runtime.headIndex >= start_index);
-                stream_ctx->flow.audio.mxl_sample_index = start_index;
+                lookback = p->max_audio_samples - (rem ? rem : max_samples_per_read);
             }
+            // The SDK publishes the flow with a zero head before its first commit.
+            if (flow_info->runtime.headIndex < lookback)
+                return AVERROR(EAGAIN);
+            stream_ctx->flow.audio.mxl_sample_index = flow_info->runtime.headIndex - lookback;
             logv(s, "init audio sample index = %"PRIu64", policy: tail index\n",
                  stream_ctx->flow.audio.mxl_sample_index);
             break;
diff --git a/tests/fate/mxl.mak b/tests/fate/mxl.mak
index af850bbb4e..517de1e530 100644
--- a/tests/fate/mxl.mak
+++ b/tests/fate/mxl.mak
@@ -49,11 +49,9 @@ PROBE_LOG_FILTER = $(FILTER_PWD_FROM_MXL_URI) | $(FILTER_MXL_LOG_PREFIX) | \
 # local MXL domain directory is created in the working directory at
 # ./domain, and `mux-command` is executed in the background.
 #
-# It then retries the supplied `demux-command` until it succeeds or
-# the retry limit is reached. On success it touches the local
-# ./sentinel file so the `mux-command` can perform synchronized
-# teardown. The macro waits for the muxer to exit before completing.
-#
+# Wait for the finite writer to enter its synchronized teardown: at that
+# point every input packet has been committed and the flow is still alive.
+# Starting a tail reader before this barrier can read pre-roll instead.
 define MXL_MUX_DEMUX_TEST
     ( \
         set -e; \
@@ -62,30 +60,22 @@ define MXL_MUX_DEMUX_TEST
         rm -rf "$$TEST_DIR"; \
         mkdir -p "$$TEST_DIR"; \
         cd "$$TEST_DIR"; \
-        rm -f sentinel; \
         mkdir domain; \
         echo $(MXL_OPTIONS) > domain/options.json; \
-        $(2) & \
+        $(2) -loglevel verbose -nostats > mux.log 2>&1 & \
         MUX_PID=$$!; \
         trap "kill $$MUX_PID 2>/dev/null || true" INT TERM EXIT; \
-        set +e; \
         RETRIES=0; \
-        while [ $$RETRIES -lt $(RETRY_LIMIT) ]; do \
-            sleep $(RETRY_SLEEP); \
-            OUTFILE=$$(mktemp "$$TEST_DIR"/demux.out.XXXXXX) || exit 1; \
-            $(3) > "$$OUTFILE" 2>&1; \
-            STATUS=$$?; \
-            $(FILTER_PWD_FROM_MXL_URI) < "$$OUTFILE"; \
-            rm -f "$$OUTFILE"; \
-            if [ $$STATUS -eq 0 ]; then \
-                touch sentinel; \
-                break; \
-            else \
-                RETRIES=$$((RETRIES+1)); \
+        until grep -Fq "waiting for sentinel: sentinel" mux.log; do \
+            if ! kill -0 $$MUX_PID 2>/dev/null || [ $$RETRIES -ge $(RETRY_LIMIT) ]; then \
+                cat mux.log >&2; exit 1; \
             fi; \
+            RETRIES=$$((RETRIES+1)); \
+            sleep $(RETRY_SLEEP); \
         done; \
-        set -e; \
-        if [ $$RETRIES -ge $(RETRY_LIMIT) ]; then echo "$(4) failed"; exit 1; fi; \
+        $(3) > demux.log 2>&1 || { cat demux.log >&2; echo "$(4) failed" >&2; exit 1; }; \
+        $(FILTER_PWD_FROM_MXL_URI) < demux.log; \
+        touch sentinel; \
         wait $$MUX_PID; \
         trap - INT TERM EXIT; \
     )
