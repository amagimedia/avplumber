 }
 
+/**
+ * Parse the dip color "Y:Cb:Cr": 8-bit limited-range codes, fractions allowed
+ * so a 10-bit frame keeps full precision. Invalid input keeps the old color.
+ */
+static int set_dip_color(AVFilterContext *avctx, const char *arg)
+{
+    TransitionCUDAContext *s = avctx->priv;
+    float v[3];
+    char tail;
+
+    if (!arg || sscanf(arg, "%f:%f:%f%c", &v[0], &v[1], &v[2], &tail) != 3 ||
+        !(v[0] >= 0.f && v[0] <= 255.f && v[1] >= 0.f && v[1] <= 255.f &&
+          v[2] >= 0.f && v[2] <= 255.f)) {
+        av_log(avctx, AV_LOG_ERROR, "Invalid dip color '%s': expected Y:Cb:Cr codes from 0 to 255\n",
+               arg ? arg : "");
+        return AVERROR(EINVAL);
+    }
+    memcpy(s->dip_color, v, sizeof(v));
+    return 0;
+}
+
+/**
+ * The dip color in the codes of the frame's depth and range, per plane:
+ * [p][0] for even samples and [p][1] for odd ones, so an interleaved Cb/Cr
+ * plane gets Cb then Cr and every other plane one component twice.
+ */
+static void dip_plane_codes(const float color[3], enum AVColorRange range,
+                            const AVPixFmtDescriptor *desc, float codes[4][2])
+{
+    const int depth = desc->comp[0].depth;
+    const float max = (1 << depth) - 1;
+    int seen[4] = { 0 };
+
+    for (int c = 0; c < 3; c++) {
+        const int p = desc->comp[c].plane;
+        float v = color[c];
+        if (range == AVCOL_RANGE_JPEG)
+            v = c ? (v - 128.f) / 224.f * max + (1 << (depth - 1)) : (v - 16.f) / 219.f * max;
+        else
+            v *= 1 << (depth - 8);
+        codes[p][1] = av_clipf(v, 0.f, max);
+        if (!seen[p]++)
+            codes[p][0] = codes[p][1];
+    }
+}
+
