index 0000000000..62a1f3b1e6
--- /dev/null
+++ b/libavdevice/libndi_newtek_dec.c
@@ -0,0 +1,213 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <Processing.NDI.Lib.h>
+#include "libavcodec/avcodec.h"
+#include "libavformat/demux.h"
+#include "libavformat/internal.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/opt.h"
+#include "libavutil/time.h"
+
+typedef struct {
+    const AVClass *class;
+    char *extra_ips;
+    int list, fields, bgra;
+    int64_t wait;
+    NDIlib_recv_instance_t receiver;
+    AVStream *video, *audio;
+} NDIInput;
+
+static int interrupted(AVFormatContext *s)
+{
+    return s->interrupt_callback.callback &&
+           s->interrupt_callback.callback(s->interrupt_callback.opaque);
+}
+
+static int ndi_open(AVFormatContext *s)
+{
+    NDIInput *n = s->priv_data;
+    NDIlib_find_create_t opts = { .show_local_sources = true, .p_extra_ips = n->extra_ips };
+    NDIlib_find_instance_t finder;
+    int64_t until = av_gettime_relative() + n->wait;
+    int ret = AVERROR(ENOENT);
+
+    if (!NDIlib_initialize() || !(finder = NDIlib_find_create_v2(&opts)))
+        return AVERROR_EXTERNAL;
+    for (;;) {
+        uint32_t count = 0;
+        const NDIlib_source_t *sources = NDIlib_find_get_current_sources(finder, &count);
+        int64_t remaining = until - av_gettime_relative();
+
+        if (interrupted(s)) {
+            ret = AVERROR_EXIT;
+            break;
+        }
+        for (uint32_t i = 0; i < count; i++) {
+            if (n->list) {
+                if (remaining <= 0)
+                    av_log(s, AV_LOG_INFO, "%s\n", sources[i].p_ndi_name);
+            } else if (!strcmp(sources[i].p_ndi_name, s->url)) {
+                NDIlib_recv_create_v3_t cfg = {
+                    .source_to_connect_to = sources[i],
+                    .color_format = n->bgra ? NDIlib_recv_color_format_BGRX_BGRA
+                                            : NDIlib_recv_color_format_UYVY_BGRA,
+                    .bandwidth = NDIlib_recv_bandwidth_highest,
+                    .allow_video_fields = n->fields,
+                };
+                n->receiver = NDIlib_recv_create_v3(&cfg);
+                ret = n->receiver ? 0 : AVERROR_EXTERNAL;
+                goto done;
+            }
+        }
+        if (remaining <= 0) {
+            if (n->list)
+                ret = AVERROR_EXIT;
+            break;
+        }
+        NDIlib_find_wait_for_sources(finder, FFMIN(40, (remaining + 999) / 1000));
+    }
+done:
+    NDIlib_find_destroy(finder);
+    s->ctx_flags |= AVFMTCTX_NOHEADER;
+    return ret;
+}
+
+static AVStream *new_stream(AVFormatContext *s, enum AVMediaType type, enum AVCodecID codec)
+{
+    AVStream *st = avformat_new_stream(s, NULL);
+    if (st) {
+        st->codecpar->codec_type = type;
+        st->codecpar->codec_id = codec;
+        avpriv_set_pts_info(st, 64, 1, 10000000);
+    }
+    return st;
+}
+
+static int video_packet(AVFormatContext *s, AVPacket *pkt, NDIlib_video_frame_v2_t *v)
+{
+    NDIInput *n = s->priv_data;
+    AVStream *st = n->video;
+    enum AVPixelFormat fmt;
+    int bytes, stride, ret;
+
+    switch (v->FourCC) {
+    case NDIlib_FourCC_video_type_UYVY: fmt = AV_PIX_FMT_UYVY422; break;
+    case NDIlib_FourCC_video_type_BGRA: fmt = AV_PIX_FMT_BGRA; break;
+    case NDIlib_FourCC_video_type_BGRX:
+        /* The NDI SDK guarantees BGRX carries 255 in every alpha byte. */
+        fmt = n->bgra ? AV_PIX_FMT_BGRA : AV_PIX_FMT_BGR0;
+        break;
+    default: return AVERROR_INVALIDDATA;
+    }
+    bytes = av_image_get_buffer_size(fmt, v->xres, v->yres, 1);
+    stride = av_image_get_linesize(fmt, v->xres, 0);
+    if (bytes < 0 || stride <= 0 || stride > v->line_stride_in_bytes ||
+        !v->p_data || v->frame_rate_N <= 0 || v->frame_rate_D <= 0)
+        return AVERROR_INVALIDDATA;
+    if (!st) {
+        st = n->video = new_stream(s, AVMEDIA_TYPE_VIDEO, AV_CODEC_ID_RAWVIDEO);
+        if (!st)
+            return AVERROR(ENOMEM);
+        st->codecpar->format = fmt;
+        st->codecpar->codec_tag = avcodec_pix_fmt_to_codec_tag(fmt);
+        st->codecpar->width = v->xres;
+        st->codecpar->height = v->yres;
+        st->avg_frame_rate = (AVRational){ v->frame_rate_N, v->frame_rate_D };
+        st->r_frame_rate = st->avg_frame_rate;   // else probing falls back to 1/time_base: 10 MHz
+        st->codecpar->field_order = v->frame_format_type == NDIlib_frame_format_type_interleaved ?
+                                    AV_FIELD_TT : AV_FIELD_PROGRESSIVE;
+    }
+    if (st->codecpar->format != fmt || st->codecpar->width != v->xres || st->codecpar->height != v->yres)
+        return AVERROR_INPUT_CHANGED;
+    if ((ret = av_new_packet(pkt, bytes)) < 0)
+        return ret;
+    av_image_copy_plane(pkt->data, stride, v->p_data, v->line_stride_in_bytes, stride, v->yres);
+    pkt->stream_index = st->index;
+    pkt->pts = pkt->dts = v->timecode;
+    pkt->duration = av_rescale_q(1, (AVRational){v->frame_rate_D, v->frame_rate_N}, st->time_base);
+    pkt->flags |= AV_PKT_FLAG_KEY;
+    return 0;
+}
+
+static int audio_packet(AVFormatContext *s, AVPacket *pkt, NDIlib_audio_frame_v2_t *a)
+{
+    NDIInput *n = s->priv_data;
+    AVStream *st = n->audio;
+    NDIlib_audio_frame_interleaved_16s_t dst = { 0 };
+    int bytes = av_samples_get_buffer_size(NULL, a->no_channels, a->no_samples, AV_SAMPLE_FMT_S16, 1);
+    int ret;
+
+    if (bytes <= 0 || !a->p_data || a->sample_rate <= 0)
+        return AVERROR_INVALIDDATA;
+    if (!st) {
+        st = n->audio = new_stream(s, AVMEDIA_TYPE_AUDIO, AV_CODEC_ID_PCM_S16LE);
+        if (!st)
+            return AVERROR(ENOMEM);
+        st->codecpar->format = AV_SAMPLE_FMT_S16;
+        st->codecpar->sample_rate = a->sample_rate;
+        av_channel_layout_default(&st->codecpar->ch_layout, a->no_channels);
+    }
+    if (st->codecpar->ch_layout.nb_channels != a->no_channels || st->codecpar->sample_rate != a->sample_rate)
+        return AVERROR_INPUT_CHANGED;
+    if ((ret = av_new_packet(pkt, bytes)) < 0)
+        return ret;
+    dst.p_data = (int16_t *)pkt->data;
+    NDIlib_util_audio_to_interleaved_16s_v2(a, &dst);
+    pkt->stream_index = st->index;
+    pkt->pts = pkt->dts = a->timecode;
+    pkt->duration = av_rescale_q(a->no_samples, (AVRational){1, a->sample_rate}, st->time_base);
+    return 0;
+}
+
+static int ndi_read(AVFormatContext *s, AVPacket *pkt)
+{
+    NDIInput *n = s->priv_data;
+    while (!interrupted(s)) {
+        NDIlib_video_frame_v2_t v;
+        NDIlib_audio_frame_v2_t a;
+        int ret;
+        switch (NDIlib_recv_capture_v2(n->receiver, &v, &a, NULL, 40)) {
+        case NDIlib_frame_type_video:
+            ret = video_packet(s, pkt, &v);
+            NDIlib_recv_free_video_v2(n->receiver, &v);
+            return ret;
+        case NDIlib_frame_type_audio:
+            ret = audio_packet(s, pkt, &a);
+            NDIlib_recv_free_audio_v2(n->receiver, &a);
+            return ret;
+        case NDIlib_frame_type_error: return AVERROR(EIO);
+        default: break;
+        }
+    }
+    return AVERROR_EXIT;
+}
+
+static int ndi_close(AVFormatContext *s)
+{
+    NDIInput *n = s->priv_data;
+    if (n->receiver)
+        NDIlib_recv_destroy(n->receiver);
+    return 0;
+}
+
+#define OFFSET(x) offsetof(NDIInput, x)
+#define DEC AV_OPT_FLAG_DECODING_PARAM
+static const AVOption options[] = {
+    { "color_format", "Video output format", OFFSET(bgra), AV_OPT_TYPE_INT, {.i64=0}, 0, 1, DEC, .unit="color_format" },
+    { "auto", "UYVY or BGRA according to the source", 0, AV_OPT_TYPE_CONST, {.i64=0}, 0, 0, DEC, .unit="color_format" },
+    { "bgra", "Always output BGRA", 0, AV_OPT_TYPE_CONST, {.i64=1}, 0, 0, DEC, .unit="color_format" },
+    { "find_sources", "List discovered NDI sources", OFFSET(list), AV_OPT_TYPE_BOOL, {.i64=0}, 0, 1, DEC },
+    { "wait_sources", "Source discovery timeout", OFFSET(wait), AV_OPT_TYPE_DURATION, {.i64=500000}, 0, INT_MAX, DEC },
+    { "extra_ips", "Additional discovery addresses", OFFSET(extra_ips), AV_OPT_TYPE_STRING, {.str=NULL}, 0, 0, DEC },
+    { "allow_video_fields", "Allow interlaced video", OFFSET(fields), AV_OPT_TYPE_BOOL, {.i64=1}, 0, 1, DEC },
+    { NULL }
+};
+static const AVClass ndi_class = {
+    .class_name = "NDI input", .item_name = av_default_item_name, .option = options,
+    .version = LIBAVUTIL_VERSION_INT, .category = AV_CLASS_CATEGORY_DEVICE_VIDEO_INPUT,
+};
+const FFInputFormat ff_libndi_newtek_demuxer = {
+    .p.name = "libndi_newtek", .p.long_name = NULL_IF_CONFIG_SMALL("NDI SDK input"),
+    .p.flags = AVFMT_NOFILE, .p.priv_class = &ndi_class,
+    .priv_data_size = sizeof(NDIInput), .read_header = ndi_open,
+    .read_packet = ndi_read, .read_close = ndi_close,
+};
