# nv-codec-headers n13.0.19.0 matches the NVENC API 13.0 of driver 595.x, which is
# what the AWS g6f/g6 instances ship today. 13.1 headers (driver 610+) fail at
# runtime with "Driver does not support the required nvenc API version". These
# headers do not load the host-pin calls of pinned staging and the v210 unpack;
# patch 0025 takes them from the driver library instead.
nv_codec_headers_tag=n13.0.19.0
