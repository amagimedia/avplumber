+
+/* Direct array sampling: transforms write only the final output image. */
+#ifndef AVFILTER_TRANSITION_CUDA_ARRAY_H
+#define AVFILTER_TRANSITION_CUDA_ARRAY_H
+
+static int transition_cuda_array(AVFilterContext *avctx, AVFrame *main, AVFrame *overlay)
+{
+    TransitionCUDAContext *ctx = avctx->priv;
+    AVFilterLink *outlink = avctx->outputs[0];
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(ctx->in_format_main);
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    CUtexObject textures[8] = { 0 };
+    AVFrame *out = av_frame_alloc();
+    CUcontext dummy;
+    float dip[4][2] = { { 0 } };
+    float alpha = overlay ? ctx->alpha_coef : 0.f;
+    int mode = overlay ? ctx->transition_mode : TRANSITION_MODE_FADE;
+    const int bytes = desc->comp[0].depth > 8 ? 2 : 1;
+    const int planes = av_pix_fmt_count_planes(ctx->in_format_main);
+    int ret, err;
+
+    if (!out) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ret = av_hwframe_get_buffer(ff_filter_link(outlink)->hw_frames_ctx, out, 0);
+    if (ret < 0)
+        goto fail;
+    out->width = main->width;
+    out->height = main->height;
+    ret = av_frame_copy_props(out, main);
+    if (ret < 0)
+        goto fail;
+    if (!overlay)
+        overlay = main;
+    if (mode == TRANSITION_MODE_DIP)
+        dip_plane_codes(ctx->dip_color, main->color_range, desc, dip);
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->hwctx->cuda_ctx));
+    if (ret < 0)
+        goto fail;
+    ret = ff_cuda_input_wait(avctx, cu, ctx->hwctx, main);
+    if (ret >= 0)
+        ret = ff_cuda_input_wait(avctx, cu, ctx->hwctx, overlay);
+    for (int p = 0; p < planes && ret >= 0; p++) {
+        const int sx = p == 1 || p == 2 ? desc->log2_chroma_w : 0;
+        const int sy = p == 1 || p == 2 ? desc->log2_chroma_h : 0;
+        int lanes = p == 1 && planes == 2 ? 2 : 1;
+        int width = AV_CEIL_RSHIFT(main->width, sx) * lanes;
+        int height = AV_CEIL_RSHIFT(main->height, sy);
+        int overlay_width = AV_CEIL_RSHIFT(overlay->width, sx) * lanes;
+        int overlay_height = AV_CEIL_RSHIFT(overlay->height, sy);
+        int out_pitch = out->linesize[p] / bytes;
+        int main_pitch = main->linesize[p] / bytes, overlay_pitch = overlay->linesize[p] / bytes;
+        int shift = desc->comp[0].shift;
+        uint8_t *main_data = main->format == AV_PIX_FMT_CUDA ? main->data[p] : NULL;
+        uint8_t *overlay_data = overlay->format == AV_PIX_FMT_CUDA ? overlay->data[p] : NULL;
+        uint8_t *alpha_data = overlay->format == AV_PIX_FMT_CUDA ? overlay->data[3] : NULL;
+        int alpha_pitch = alpha_data ? overlay->linesize[3] : 0;
+        int alpha_x = 1 << sx, alpha_y = 1 << sy;
+        void *args[] = {
+            &out->data[p], &out_pitch, &main_data, &main_pitch, &textures[p],
+            &overlay_data, &overlay_pitch, &textures[4 + p],
+            &width, &height, &overlay_width, &overlay_height,
+            &alpha_data, &alpha_pitch, &alpha_x, &alpha_y,
+            &lanes, &shift, &alpha, &mode, &dip[p][0], &dip[p][1],
+        };
+        ret = ff_cuda_input_texture(avctx, cu, main, p, &textures[p]);
+        if (ret >= 0)
+            ret = ff_cuda_input_texture(avctx, cu, overlay, p, &textures[4 + p]);
+        if (ret >= 0)
+            ret = CHECK_CU(cu->cuLaunchKernel(bytes == 2 ? ctx->cu_func_input_word : ctx->cu_func_input,
+                              DIV_UP(width, BLOCK_X), DIV_UP(height, BLOCK_Y), 1,
+                              BLOCK_X, BLOCK_Y, 1, 0, ctx->cu_stream, args, NULL));
+    }
+    err = ff_cuda_input_finish(avctx, cu, ctx->cu_stream, textures, 8);
+    if (ret >= 0)
+        ret = err;
+    err = CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    if (ret >= 0)
+        ret = err;
+fail:
+    av_frame_free(&main);
+    if (ret < 0) {
+        av_frame_free(&out);
+        return ret;
+    }
+    return ff_filter_frame(outlink, out);
+}
+#endif
