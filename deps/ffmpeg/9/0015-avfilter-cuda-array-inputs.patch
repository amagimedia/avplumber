+#ifndef AVFILTER_CUDA_FRAME_INPUT_CUH
+#define AVFILTER_CUDA_FRAME_INPUT_CUH
+
+template<typename T> struct CudaInputPair;
+template<> struct CudaInputPair<unsigned char> { typedef uchar2 type; };
+template<> struct CudaInputPair<unsigned short> { typedef ushort2 type; };
+
+/* Scalar x counts samples; a UV texture contains two channels per texel. */
+template<typename T>
+__device__ static T cuda_input_sample(const T *data, int pitch,
+                                     cudaTextureObject_t texture,
+                                     int lanes, int x, int y)
+{
+    if (!texture)
+        return data[y * pitch + x];
+    if (lanes == 1)
+        return tex2D<T>(texture, x + 0.5f, y + 0.5f);
+    typename CudaInputPair<T>::type uv =
+        tex2D<typename CudaInputPair<T>::type>(texture, x / 2 + 0.5f, y + 0.5f);
+    return x & 1 ? uv.y : uv.x;
+}
+#endif
