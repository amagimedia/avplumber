+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* CUDA/CUarray filter inputs. No intermediate pixel buffers are allocated. */
+#ifndef AVFILTER_CUDA_FRAME_INPUT_H
+#define AVFILTER_CUDA_FRAME_INPUT_H
+
+#include "libavutil/cuda_check.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_cuda_internal.h"
+#include "libavutil/pixdesc.h"
+#include "libavfilter/formats.h"
+#include "libavfilter/filters.h"
+
+/* Each input negotiates independently, including mixed array/linear inputs. */
+static inline int ff_cuda_input_query_formats(const AVFilterContext *ctx,
+                                      AVFilterFormatsConfig **cfg_in,
+                                      AVFilterFormatsConfig **cfg_out)
+{
+    static const enum AVPixelFormat inputs[] = {
+        AV_PIX_FMT_CUDA,
+#if HAVE_FFNVCODEC_CUARRAY
+        AV_PIX_FMT_CUARRAY,
+#endif
+        AV_PIX_FMT_NONE
+    };
+    static const enum AVPixelFormat outputs[] = { AV_PIX_FMT_CUDA, AV_PIX_FMT_NONE };
+    int ret;
+    for (int i = 0; i < ctx->nb_inputs; i++) {
+        ret = ff_formats_ref(ff_make_pixel_format_list(inputs), &cfg_in[i]->formats);
+        if (ret < 0)
+            return ret;
+    }
+    return ff_formats_ref(ff_make_pixel_format_list(outputs), &cfg_out[0]->formats);
+}
+
+/* Commit a replacement pool only after both the first image and link
+ * reference exist, so allocation failure preserves the previous output pool. */
+static inline int ff_cuda_output_init(AVBufferRef *device, enum AVPixelFormat format,
+                                      int width, int height, AVBufferRef **frames_ref,
+                                      AVBufferRef **link_ref, AVFrame *frame, AVFrame *temporary)
+{
+    AVBufferRef *next = av_hwframe_ctx_alloc(device);
+    AVHWFramesContext *frames;
+    int ret;
+    if (!next)
+        return AVERROR(ENOMEM);
+    frames = (AVHWFramesContext*)next->data;
+    frames->format = AV_PIX_FMT_CUDA;
+    frames->sw_format = format;
+    frames->width = FFALIGN(width, 32);
+    frames->height = FFALIGN(height, 32);
+    ret = av_hwframe_ctx_init(next);
+    if (ret >= 0)
+        ret = av_hwframe_get_buffer(next, temporary, 0);
+    if (ret >= 0)
+        ret = av_buffer_replace(link_ref, next);
+    if (ret < 0) {
+        av_frame_unref(temporary);
+        av_buffer_unref(&next);
+        return ret;
+    }
+    av_buffer_unref(frames_ref);
+    *frames_ref = next;
+    av_frame_unref(frame);
+    av_frame_move_ref(frame, temporary);
+    frame->width = width;
+    frame->height = height;
+    return 0;
+}
+
+static inline int ff_cuda_input_array(void *log_ctx, CudaFunctions *cu,
+                               const AVFrame *frame, int plane, CUarray *array)
+{
+#if HAVE_FFNVCODEC_CUARRAY
+    CUresult err;
+    if (!cu->cuArrayGetPlane)
+        return AVERROR(ENOSYS);
+    err = cu->cuArrayGetPlane(array, (CUarray)frame->data[0], plane);
+    if (err == CUDA_ERROR_INVALID_VALUE && plane == 0) {
+        *array = (CUarray)frame->data[0];
+        return 0;
+    }
+    return FF_CUDA_CHECK_DL(log_ctx, cu, err);
+#else
+    return AVERROR(ENOSYS);
+#endif
+}
+
+static inline int ff_cuda_input_texture(void *log_ctx, CudaFunctions *cu,
+                                 const AVFrame *frame, int plane,
+                                 CUtexObject *texture)
+{
+    CUDA_RESOURCE_DESC resource = { .resType = CU_RESOURCE_TYPE_ARRAY };
+    CUDA_TEXTURE_DESC sampler = {
+        .addressMode = { CU_TR_ADDRESS_MODE_CLAMP, CU_TR_ADDRESS_MODE_CLAMP },
+        .filterMode = CU_TR_FILTER_MODE_POINT,
+        .flags = CU_TRSF_READ_AS_INTEGER,
+    };
+    int ret;
+    *texture = 0;
+    if (frame->format != AV_PIX_FMT_CUARRAY)
+        return 0;
+    ret = ff_cuda_input_array(log_ctx, cu, frame, plane, &resource.res.array.hArray);
+    if (ret < 0)
+        return ret;
+    return FF_CUDA_CHECK_DL(log_ctx, cu,
+                           cu->cuTexObjectCreate(texture, &resource, &sampler, NULL));
+}
+
+static inline int ff_cuda_input_copy(void *log_ctx, CudaFunctions *cu, CUstream stream,
+                              const AVFrame *in, AVFrame *out, int plane,
+                              int x_bytes, int y, int width_bytes, int height)
+{
+    CUDA_MEMCPY2D copy = {
+        .srcXInBytes = x_bytes, .srcY = y,
+        .dstMemoryType = CU_MEMORYTYPE_DEVICE,
+        .dstDevice = (CUdeviceptr)out->data[plane],
+        .dstPitch = out->linesize[plane],
+        .WidthInBytes = width_bytes, .Height = height,
+    };
+    int ret;
+    if (in->format == AV_PIX_FMT_CUARRAY) {
+        copy.srcMemoryType = CU_MEMORYTYPE_ARRAY;
+        ret = ff_cuda_input_array(log_ctx, cu, in, plane, &copy.srcArray);
+        if (ret < 0)
+            return ret;
+    } else {
+        copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.srcDevice = (CUdeviceptr)in->data[plane];
+        copy.srcPitch = in->linesize[plane];
+    }
+    return FF_CUDA_CHECK_DL(log_ctx, cu, cu->cuMemcpy2DAsync(&copy, stream));
+}
+
+static inline AVCUDADeviceContext *ff_cuda_input_device(const AVFrame *frame)
+{
+    AVHWFramesContext *frames = (AVHWFramesContext*)frame->hw_frames_ctx->data;
+    return frames->device_ctx->hwctx;
+}
+
+/* A filter may combine inputs from different streams in the same context. */
+static inline int ff_cuda_input_wait(void *log_ctx, CudaFunctions *cu,
+                                    AVCUDADeviceContext *destination, const AVFrame *frame)
+{
+    AVCUDADeviceContext *source = ff_cuda_input_device(frame);
+    CUevent ready;
+    int ret;
+    if (source->cuda_ctx != destination->cuda_ctx)
+        return AVERROR(EINVAL);
+    if (source->stream == destination->stream)
+        return 0;
+    ret = FF_CUDA_CHECK_DL(log_ctx, cu, cu->cuEventCreate(&ready, CU_EVENT_DISABLE_TIMING));
+    if (ret < 0)
+        return ret;
+    ret = FF_CUDA_CHECK_DL(log_ctx, cu, cu->cuEventRecord(ready, source->stream));
+    if (ret >= 0)
+        ret = FF_CUDA_CHECK_DL(log_ctx, cu, cu->cuStreamWaitEvent(destination->stream, ready, 0));
+    {
+        int err = FF_CUDA_CHECK_DL(log_ctx, cu, cu->cuEventDestroy(ready));
+        return ret < 0 ? ret : err;
+    }
+}
+
+/* Array slots can be recycled by NVDEC as soon as the input AVFrame is freed.
+ * Finish all reads before releasing that reference or its texture objects. */
+static inline int ff_cuda_input_finish(void *log_ctx, CudaFunctions *cu, CUstream stream,
+                                CUtexObject *textures, int count)
+{
+    int ret = FF_CUDA_CHECK_DL(log_ctx, cu, cu->cuStreamSynchronize(stream));
+    for (int i = 0; i < count; i++) {
+        if (textures[i]) {
+            int err = FF_CUDA_CHECK_DL(log_ctx, cu, cu->cuTexObjectDestroy(textures[i]));
+            if (ret >= 0)
+                ret = err;
+        }
+    }
+    return ret;
+}
+
+#endif
