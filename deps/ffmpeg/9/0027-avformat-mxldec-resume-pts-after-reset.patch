From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: avplumber mxl builder <avplumber-mxl@local>
Date: Thu, 19 Nov 2026 12:50:18 +0100
Subject: [PATCH] avformat/mxldec: resume after the full preceding packet on
 ring reset

---
 libavformat/mxldec.c | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/libavformat/mxldec.c b/libavformat/mxldec.c
index 404f0577fd..681170bd6f 100644
--- a/libavformat/mxldec.c
+++ b/libavformat/mxldec.c
@@ -79,6 +79,8 @@ typedef struct VideoState {
     uint64_t mxl_start_grain_index;
     uint64_t mxl_grain_index;
     uint64_t last_pts;
+    uint64_t pts_offset;
+    uint64_t next_packet_pts;
     int frame_count;
 } VideoState;
 
@@ -89,6 +91,8 @@ typedef struct AudioState {
     struct SwrContext *swr_context;
     int sample_point_count;
     uint64_t last_pts;
+    uint64_t pts_offset;
+    uint64_t next_packet_pts;
 } AudioState;
 
 typedef enum FlowType {
@@ -1278,7 +1282,8 @@ static int read_video_packet(AVFormatContext *s, AVStream *st, AVPacket *pkt,
         }
 
         if (p->reset_on_drop) {
-            // presentation timestamp is mxl_start_grain_index relative
+            // Resume after the complete previous packet, including a packet at PTS zero.
+            stream_ctx->flow.video.pts_offset = stream_ctx->flow.video.next_packet_pts;
             stream_ctx->flow.video.mxl_start_grain_index = stream_ctx->flow.video.mxl_grain_index;
         }
     }
@@ -1387,7 +1392,8 @@ static int read_video_packet(AVFormatContext *s, AVStream *st, AVPacket *pkt,
     }
 
     int64_t next_pts =
-        stream_ctx->flow.video.mxl_grain_index - stream_ctx->flow.video.mxl_start_grain_index;
+        stream_ctx->flow.video.mxl_grain_index - stream_ctx->flow.video.mxl_start_grain_index
+        + stream_ctx->flow.video.pts_offset;
 
     // monotonic pts sanity check
     av_assert0(next_pts >= 0 &&
@@ -1398,6 +1404,7 @@ static int read_video_packet(AVFormatContext *s, AVStream *st, AVPacket *pkt,
         logi(s, "video pts jumped %d frames\n", next_pts - stream_ctx->flow.video.last_pts);
 
     stream_ctx->flow.video.last_pts = next_pts;
+    stream_ctx->flow.video.next_packet_pts = next_pts + 1;
 
     pkt->pos = -1;
     pkt->pts = next_pts;
@@ -1649,7 +1656,8 @@ static int read_audio_packet(AVFormatContext *s, AVStream *st, AVPacket *pkt,
         }
 
         if (p->reset_on_drop) {
-            // presentation timestamp is mxl_start_grain_index relative
+            // Resume after the complete previous packet, including a packet at PTS zero.
+            stream_ctx->flow.audio.pts_offset = stream_ctx->flow.audio.next_packet_pts;
             stream_ctx->flow.audio.mxl_start_sample_index = stream_ctx->flow.audio.mxl_sample_index;
         }
     }
@@ -1755,7 +1763,8 @@ static int read_audio_packet(AVFormatContext *s, AVStream *st, AVPacket *pkt,
     }
 
     int64_t next_pts =
-        stream_ctx->flow.audio.mxl_sample_index - stream_ctx->flow.audio.mxl_start_sample_index;
+        stream_ctx->flow.audio.mxl_sample_index - stream_ctx->flow.audio.mxl_start_sample_index
+        + stream_ctx->flow.audio.pts_offset;
 
     // monotonic pts sanity check
     av_assert0(next_pts >= 0 &&
@@ -1766,6 +1775,7 @@ static int read_audio_packet(AVFormatContext *s, AVStream *st, AVPacket *pkt,
         logi(s, "audio pts jumped %d samples\n", next_pts - stream_ctx->flow.audio.last_pts);
 
     stream_ctx->flow.audio.last_pts = next_pts;
+    stream_ctx->flow.audio.next_packet_pts = next_pts + samples_this_read;
 
     pkt->pts      = next_pts;
     pkt->dts      = next_pts;
