+
+    .uri =
+        "mxl://host1.local/domain/path?"
+        "id=3645f1e2-90fc-49cb-af9c-236c2ac124cd&"
+        "empty&"
+        "id=876fc244-9c99-48a8-a461-927e43a05bdc",
