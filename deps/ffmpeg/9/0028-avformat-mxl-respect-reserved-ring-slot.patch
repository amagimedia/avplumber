From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AVPlumber contributors <avplumber@users.noreply.github.com>
Date: Thu, 19 Nov 2026 13:09:46 +0100
Subject: [PATCH] avformat/mxl: respect the SDK reserved ring slot in tail
 reads

SDK v1.1.0 reserves the slot following headIndex for the writer. Start at the first readable grain when selecting the tail. Size the 50 Hz FATE ring for five readers-visible frames plus that reserved slot. Generate native yuv422p10le test video so transport checksums do not depend on the default scaling conversion. Reference values also match direct v210 encode and decode.
---
 libavformat/mxldec.c            |  6 ++++--
 tests/fate/mxl.mak              | 12 +++++-------
 tests/ref/fate/mxl-av-encdec    | 10 +++++-----
 tests/ref/fate/mxl-video-encdec | 10 +++++-----
 4 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/libavformat/mxldec.c b/libavformat/mxldec.c
index 681170bd6f..3c2911af82 100644
--- a/libavformat/mxldec.c
+++ b/libavformat/mxldec.c
@@ -1270,8 +1270,10 @@ static int read_video_packet(AVFormatContext *s, AVStream *st, AVPacket *pkt,
                  stream_ctx->flow.video.mxl_grain_index);
             break;
         case GRAIN_INDEX_INIT_TAIL:
-            stream_ctx->flow.video.mxl_grain_index = flow_info->runtime.headIndex -
-                flow_info->config.discrete.grainCount + 1;
+            // SDK 1.1 reserves headIndex+1's ring slot for the writer.
+            stream_ctx->flow.video.mxl_grain_index =
+                flow_info->runtime.headIndex >= flow_info->config.discrete.grainCount
+                ? flow_info->runtime.headIndex - flow_info->config.discrete.grainCount + 2 : 0;
             logv(s, "init video grain index = %"PRIu64", policy: tail index\n",
                  stream_ctx->flow.video.mxl_grain_index);
             break;
diff --git a/tests/fate/mxl.mak b/tests/fate/mxl.mak
index c7a23d68cc..af850bbb4e 100644
--- a/tests/fate/mxl.mak
+++ b/tests/fate/mxl.mak
@@ -14,12 +14,10 @@ fate-mxl-diag: libavformat/tests/mxl_diag$(EXESUF)
 fate-mxl-diag: CMD = run libavformat/tests/mxl_diag$(EXESUF)
 FATE-yes += $(if $(filter yes,$(CONFIG_MXL_DEMUXER)),fate-mxl-diag)

-# Note: MXL_OPTIONS is defined explicitly (even though it matches the
-# default MXL value) to make the test's dependency on this
-# history_duration setting unambiguous and intentional.
-
+# Five readable video frames at 50 Hz plus the SDK's reserved writer slot.
 MXL_TMP_DIR := $(TARGET_PATH)/tests/data/tmp/mxl
-MXL_OPTIONS := "{"\"urn:x-mxl:option:history_duration/v1.0\"":100000000}"
+MXL_OPTIONS := "{"\"urn:x-mxl:option:history_duration/v1.0\"":120000000}"
+MXL_TEST_VIDEO := testsrc2=size=1920x1080:rate=50,format=yuv422p10le
 MXL_VIDEO_FLOW_ID := 717f834b-4224-4c9b-8a64-ecb7726803b8
 MXL_AUDIO_FLOW_ID := ff39f65b-d760-4a7c-808d-4f2778de5658
 MXL_AUDIO_MAX_SAMPLES := 2559
@@ -104,7 +102,7 @@ fate-mxl-video-encdec: CMD = \
     $(call MXL_MUX_DEMUX_TEST, \
         mxl-video-encdec, \
         $(TARGET_PATH)/ffmpeg -hide_banner -v error -re \
-            -f lavfi -i testsrc2=size=1920x1080:rate=50 -frames:v 5 -c:v v210 \
+            -f lavfi -i $(MXL_TEST_VIDEO) -frames:v 5 -c:v v210 \
             -f mxl -video_flow_id $(MXL_VIDEO_FLOW_ID) \
             -teardown_sync_file sentinel -teardown_sync_timeout $(MXL_SENTINEL_TIMEOUT) \
             domain, \
@@ -141,7 +139,7 @@ fate-mxl-av-encdec: CMD = \
     $(call MXL_MUX_DEMUX_TEST, \
         mxl-av-encdec, \
         $(TARGET_PATH)/ffmpeg -hide_banner -v error -re \
-            -f lavfi -i testsrc2=size=1920x1080:rate=50 \
+            -f lavfi -i $(MXL_TEST_VIDEO) \
             -f lavfi -i "anoisesrc=sample_rate=48000:nb_samples=$(MXL_AUDIO_SAMPLES_PER_PACKET):seed=0$(COMMA)aformat=sample_fmts=flt:channel_layouts=stereo$(COMMA)atrim=end_sample=$(MXL_AUDIO_MAX_SAMPLES)" \
             -map 0:v:0 -map 1:a:0 -frames:v 5 \
             -c:v v210 -c:a pcm_f32le \
