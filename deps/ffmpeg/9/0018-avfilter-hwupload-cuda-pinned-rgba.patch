From afe32e1f6b4b2aba51d75edb30b81c32e9109161 Mon Sep 17 00:00:00 2001
From: avplumber patches <patches@local>
Date: Tue, 6 Oct 2026 14:49:45 +0200
Subject: [PATCH] avfilter/hwupload_cuda: preserve RGBA alpha in pinned uploads

---
 doc/filters.texi               | 3 ++-
 libavfilter/vf_hwupload_cuda.c | 4 ++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/doc/filters.texi b/doc/filters.texi
index 3f2b22e825..0f4c904690 100644
--- a/doc/filters.texi
+++ b/doc/filters.texi
@@ -16108,7 +16108,8 @@ It accepts the following optional parameters:
 The number of the CUDA device to use
 @item pinned
 Use reusable pinned host staging and a private nonblocking CUDA stream for
-software NV12/P010 uploads. Default is disabled. If a CUDA filter device is
+software NV12/P010/RGBA uploads. RGBA alpha bytes are preserved without
+conversion. Default is disabled. If a CUDA filter device is
 provided, reuse its context. Upload completion is synchronized before the
 output frame is forwarded; this option does not eliminate CPU waits.
 
diff --git a/libavfilter/vf_hwupload_cuda.c b/libavfilter/vf_hwupload_cuda.c
index 2df767e0ca..e39f62f5e4 100644
--- a/libavfilter/vf_hwupload_cuda.c
+++ b/libavfilter/vf_hwupload_cuda.c
@@ -260,7 +260,7 @@ static int cudaupload_query_formats(const AVFilterContext *ctx,
                                                 : output_cuda_fmts;
     static const enum AVPixelFormat v210_fmts[] = { AV_PIX_FMT_GRAY8, AV_PIX_FMT_NONE };
     static const enum AVPixelFormat pinned_fmts[] = {
-        AV_PIX_FMT_NV12, AV_PIX_FMT_P010, AV_PIX_FMT_NONE,
+        AV_PIX_FMT_NV12, AV_PIX_FMT_P010, AV_PIX_FMT_RGBA, AV_PIX_FMT_NONE,
     };
     AVFilterFormats *in_fmts = ff_make_pixel_format_list(
         ((const CudaUploadContext *)ctx->priv)->v210_width ? v210_fmts :
@@ -386,7 +386,7 @@ fail:
 #define FLAGS (AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_VIDEO_PARAM)
 static const AVOption cudaupload_options[] = {
     { "v210_width", "Unpack gray-wrapped v210 rows into P210 on the GPU (implies pinned)", OFFSET(v210_width), AV_OPT_TYPE_INT, { .i64 = 0 }, 0, INT_MAX, FLAGS },
-    { "pinned", "Upload software NV12/P010 through pinned staging on a private stream", OFFSET(pinned), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, FLAGS },
+    { "pinned", "Upload software NV12/P010/RGBA through pinned staging on a private stream", OFFSET(pinned), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, FLAGS },
     { "device", "Number of the device to use", OFFSET(device_idx), AV_OPT_TYPE_INT, { .i64 = 0 }, 0, INT_MAX, FLAGS },
     { "output_format", "Output frame format", OFFSET(output_format), AV_OPT_TYPE_INT, { .i64 = CUDAUPLOAD_FMT_CUDA }, 0, CUDAUPLOAD_FMT_NB - 1, FLAGS, .unit = "output_format" },
         { "cuda",    "Pitch-linear device memory (default)", 0, AV_OPT_TYPE_CONST, { .i64 = CUDAUPLOAD_FMT_CUDA },    .flags = FLAGS, .unit = "output_format" },
-- 
2.55.0

