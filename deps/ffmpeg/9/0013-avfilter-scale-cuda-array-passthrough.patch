From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: avplumber patches <patches@local>
Date: Sat, 3 Oct 2026 00:38:23 +0200
Subject: [PATCH] avfilter/scale_cuda: allow CUarray identity passthrough

---
 libavfilter/vf_scale_cuda.c | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/libavfilter/vf_scale_cuda.c b/libavfilter/vf_scale_cuda.c
index 94946af..8799132 100644
--- a/libavfilter/vf_scale_cuda.c
+++ b/libavfilter/vf_scale_cuda.c
@@ -769,6 +769,12 @@ static av_cold int init_processing_chain(AVFilterContext *ctx, int in_width, int
 
         s->use_filters = 0;
     } else {
+        if (in_frames_ctx->format == AV_PIX_FMT_CUARRAY) {
+            av_log(ctx, AV_LOG_ERROR,
+                   "CUarray input supports passthrough only; dimensions and "
+                   "pixel format must match and passthrough must be enabled\n");
+            return AVERROR(ENOSYS);
+        }
         s->passthrough = 0;
 
         ret = init_hwframe_ctx(s, in_frames_ctx->device_ref, out_width, out_height);
@@ -1411,7 +1417,7 @@ static int cudascale_query_formats(const AVFilterContext *ctx,
                                    AVFilterFormatsConfig **cfg_out)
 {
     const CUDAScaleContext *s = ctx->priv;
-    static const enum AVPixelFormat pix_fmts[] = { AV_PIX_FMT_CUDA, AV_PIX_FMT_NONE };
+    static const enum AVPixelFormat pix_fmts[] = { AV_PIX_FMT_CUDA, AV_PIX_FMT_CUARRAY, AV_PIX_FMT_NONE };
     static const int rgb_ranges[] = { AVCOL_RANGE_JPEG, AVCOL_RANGE_UNSPECIFIED, -1 };
     static const int yuv_ranges[] = { AVCOL_RANGE_MPEG, AVCOL_RANGE_JPEG, -1 };
     const AVPixFmtDescriptor *out_desc = s->format != AV_PIX_FMT_NONE ?
@@ -1543,15 +1549,18 @@ static av_cold int cudascale_config_props(AVFilterLink *outlink)
            outlink->w, outlink->h, av_get_pix_fmt_name(s->out_fmt),
            s->passthrough ? " (passthrough)" : "");
 
+    /* Identity frames are forwarded without launching a kernel. Avoid loading
+     * and JIT-compiling the CUDA module for every passthrough instance. */
+    if (s->passthrough)
+        return 0;
+
     ret = cudascale_load_functions(ctx);
     if (ret < 0)
         return ret;
 
-    if (!s->passthrough) {
-        ret = cudascale_setup_filters(ctx, inlink->w, inlink->h);
-        if (ret < 0)
-            return ret;
-    }
+    ret = cudascale_setup_filters(ctx, inlink->w, inlink->h);
+    if (ret < 0)
+        return ret;
 
     return 0;
 
