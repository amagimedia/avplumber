From 231ceafed3d1fd26e859521f80922e43a77a8855 Mon Sep 17 00:00:00 2001
From: Jan Pietek <jan.pietek@gmail.com>
Date: Wed, 18 Mar 2026 09:29:06 +0100
Subject: [PATCH 18/40] no nvidia for now

---
 .github/workflows/ubuntu-25.04-deb.yml | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/.github/workflows/ubuntu-25.04-deb.yml b/.github/workflows/ubuntu-25.04-deb.yml
index 4ec0765ac6..867dacadfe 100644
--- a/.github/workflows/ubuntu-25.04-deb.yml
+++ b/.github/workflows/ubuntu-25.04-deb.yml
@@ -13,6 +13,11 @@ on:
         required: true
         default: ffmpeg-nvidia
         type: string
+      build_nvidia_package:
+        description: Also build the NVIDIA/CUDA package on a self-hosted runner
+        required: true
+        default: false
+        type: boolean
       extra_configure_flags:
         description: Additional flags appended to both ./configure commands
         required: false
@@ -88,6 +93,13 @@ jobs:
             --disable-libx265 \
             --disable-libaom \
             --disable-libvpx \
+            --disable-cuda \
+            --disable-cuda-nvcc \
+            --disable-cuda-llvm \
+            --disable-cuvid \
+            --disable-ffnvcodec \
+            --disable-nvdec \
+            --disable-nvenc \
             --disable-libvpl \
             --disable-libsrt \
             --disable-libvmaf \
@@ -239,6 +251,7 @@ jobs:
 
   build-nvidia-deb:
     name: Build Ubuntu 25.04 NVIDIA .deb
+    if: ${{ inputs.build_nvidia_package }}
     # This workflow is intended for a self-hosted Ubuntu 25.04 x86_64 runner
     # with CUDA 13.0 already installed at /usr/local/cuda-13.0.
     runs-on: [self-hosted, linux, x64, ubuntu-25.04, cuda]
-- 
2.53.0

