From c9ab42fd6b075ffa39deb5c55a568ad57fdafe5a Mon Sep 17 00:00:00 2001
From: avplumber docker builder <auto-mixer@avplumber.local>
Date: Mon, 25 May 2026 19:19:52 +0200
Subject: [PATCH] ffmpeg: match host CUDA overlay edge handling

---
 libavfilter/vf_overlay_many_cuda.c           |  64 +++++++++---
 libavfilter/vf_overlay_many_cuda_generator.c |  22 ++--
 libavfilter/vf_scale_cuda.c                  |   5 +
 libavfilter/vf_scale_cuda.cu                 | 104 ++++++++++++++++---
 4 files changed, 160 insertions(+), 35 deletions(-)

diff --git a/libavfilter/vf_overlay_many_cuda.c b/libavfilter/vf_overlay_many_cuda.c
index 63dab62..5af276f 100644
--- a/libavfilter/vf_overlay_many_cuda.c
+++ b/libavfilter/vf_overlay_many_cuda.c
@@ -67,6 +67,8 @@ typedef struct OverlayManyCUDAContext {
     CUfunction cu_func_combined;
     CUstream cu_stream;
 
+    AVBufferRef *frames_ctx;
+
     FFFrameSync fs;
 
     uint8_t main_log2_chroma_w, main_log2_chroma_h;
@@ -116,7 +118,7 @@ static int overlay_many_cuda_blend(FFFrameSync *fs)
 
     AVFrame *input_frames[MAX_INPUT_COUNT] = {0};
     AVFrame *output = NULL;
-    void* kernel_args[12 + (8*MAX_OVERLAY_COUNT)];
+    void* kernel_args[14 + (8*MAX_OVERLAY_COUNT)];
 
     ctx->cu_ctx = cuda_ctx;
 
@@ -160,9 +162,12 @@ static int overlay_many_cuda_blend(FFFrameSync *fs)
         // arg layout: y_dst, y_dst_pitch, y_src, y_src_pitch,
         //             u_dst, u_dst_pitch, u_src, u_src_pitch,
         //             v_dst, v_dst_pitch, v_src, v_src_pitch,
+        //             width, height,
         //             [ov_y, ov_y_pitch, ov_u, ov_u_pitch, ov_v, ov_v_pitch, ov_alpha, ov_alpha_pitch] * N
-        int grid_dim_x = DIV_UP(input_frames[0]->width,  BLOCK_X);
-        int grid_dim_y = DIV_UP(input_frames[0]->height, BLOCK_Y);
+        int frame_width = input_frames[0]->width;
+        int frame_height = input_frames[0]->height;
+        int grid_dim_x = DIV_UP(frame_width,  BLOCK_X);
+        int grid_dim_y = DIV_UP(frame_height, BLOCK_Y);
         int p, input_index, base;
         for (p = 0; p < 3; p++) {
             kernel_args[p*4 + 0] = &output->data[p];
@@ -170,8 +175,10 @@ static int overlay_many_cuda_blend(FFFrameSync *fs)
             kernel_args[p*4 + 2] = &input_frames[0]->data[p];
             kernel_args[p*4 + 3] = &input_frames[0]->linesize[p];
         }
+        kernel_args[12] = &frame_width;
+        kernel_args[13] = &frame_height;
         for (input_index = 1; input_index < ctx->nb_inputs; input_index++) {
-            base = 12 + (input_index-1)*8;
+            base = 14 + (input_index-1)*8;
             kernel_args[base + 0] = &input_frames[input_index]->data[0];
             kernel_args[base + 1] = &input_frames[input_index]->linesize[0];
             kernel_args[base + 2] = &input_frames[input_index]->data[1];
@@ -186,13 +193,16 @@ static int overlay_many_cuda_blend(FFFrameSync *fs)
                  0, ctx->cu_stream, kernel_args, NULL));
     } else {
         // Fallback: separate kernel launch per plane (YUV420P+YUVA444P and any unhandled combos)
-        // arg layout: dst_ptr, dst_pitch, src_ptr, src_pitch, [alpha_adj_x, alpha_adj_y,] ov0..ovN
+        // arg layout: dst_ptr, dst_pitch, src_ptr, src_pitch, width, height,
+        //             [alpha_adj_x, alpha_adj_y,] ov0..ovN
         for (int plane_index = 0; plane_index < 3; plane_index++) {
             uint8_t main_log2_chroma_w = (plane_index == 0 ? 0 : ctx->main_log2_chroma_w);
             uint8_t main_log2_chroma_h = (plane_index == 0 ? 0 : ctx->main_log2_chroma_h);
+            int plane_width = input_frames[0]->width  >> main_log2_chroma_w;
+            int plane_height = input_frames[0]->height >> main_log2_chroma_h;
 
-            int grid_dim_x = DIV_UP(input_frames[0]->width  >> main_log2_chroma_w, BLOCK_X);
-            int grid_dim_y = DIV_UP(input_frames[0]->height >> main_log2_chroma_h, BLOCK_Y);
+            int grid_dim_x = DIV_UP(plane_width, BLOCK_X);
+            int grid_dim_y = DIV_UP(plane_height, BLOCK_Y);
             int alpha_adjust_x = (1 << main_log2_chroma_w);
             int alpha_adjust_y = (1 << main_log2_chroma_h);
 
@@ -203,17 +213,19 @@ static int overlay_many_cuda_blend(FFFrameSync *fs)
             kernel_args[1] = &output->linesize[plane_index];
             kernel_args[2] = &input_frames[0]->data[plane_index];
             kernel_args[3] = &input_frames[0]->linesize[plane_index];
+            kernel_args[4] = &plane_width;
+            kernel_args[5] = &plane_height;
 
             if (plane_index > 0 && ctx->cu_func_420and444) {
                 cu_func = ctx->cu_func_420and444;
-                header_arg_count = 4;
+                header_arg_count = 6;
             } else if (plane_index > 0 && ctx->cu_func_420to420_chroma) {
                 cu_func = ctx->cu_func_420to420_chroma;
-                header_arg_count = 4;
-            } else {
-                kernel_args[4] = &alpha_adjust_x;
-                kernel_args[5] = &alpha_adjust_y;
                 header_arg_count = 6;
+            } else {
+                kernel_args[6] = &alpha_adjust_x;
+                kernel_args[7] = &alpha_adjust_y;
+                header_arg_count = 8;
             }
 
             for (int input_index = 1; input_index < ctx->nb_inputs; input_index++) {
@@ -284,6 +296,7 @@ static av_cold void overlay_many_cuda_uninit(AVFilterContext *avctx)
     }
 
     av_buffer_unref(&ctx->hw_device_ctx);
+    av_buffer_unref(&ctx->frames_ctx);
     ctx->hwctx = NULL;
 }
 
@@ -383,8 +396,15 @@ static int overlay_many_cuda_config_output(AVFilterLink *outlink)
         }
     }
 
+    outlink->w = inlink_main->w;
+    outlink->h = inlink_main->h;
+    outlink->time_base = inlink_main->time_base;
+
     // initialize
     {
+        AVHWFramesContext *out_ctx;
+        AVBufferRef *out_ref;
+
         ctx->hw_device_ctx = av_buffer_ref(frames_ctx_main->device_ref);
         if (!ctx->hw_device_ctx)
             return AVERROR(ENOMEM);
@@ -395,7 +415,25 @@ static int overlay_many_cuda_config_output(AVFilterLink *outlink)
 
         ctx->cu_stream = ctx->hwctx->stream;
 
-        outl->hw_frames_ctx = av_buffer_ref(inl_main->hw_frames_ctx);
+        out_ref = av_hwframe_ctx_alloc(ctx->hw_device_ctx);
+        if (!out_ref)
+            return AVERROR(ENOMEM);
+
+        out_ctx = (AVHWFramesContext*)out_ref->data;
+        out_ctx->format = AV_PIX_FMT_CUDA;
+        out_ctx->sw_format = ctx->format_main;
+        out_ctx->width = outlink->w;
+        out_ctx->height = outlink->h;
+
+        err = av_hwframe_ctx_init(out_ref);
+        if (err < 0) {
+            av_buffer_unref(&out_ref);
+            return err;
+        }
+
+        ctx->frames_ctx = out_ref;
+
+        outl->hw_frames_ctx = av_buffer_ref(ctx->frames_ctx);
         if (!outl->hw_frames_ctx)
             return AVERROR(ENOMEM);
     }
diff --git a/libavfilter/vf_overlay_many_cuda_generator.c b/libavfilter/vf_overlay_many_cuda_generator.c
