     int x2 = x*2;
     int y2 = y*2;
 
@@ -135,7 +139,8 @@ static void write_420_to_420_chroma_function(FILE *file, int input_count)
 
 __global__ void AlignedOverlay420to420Chroma__%d(
     unsigned char *main_dst, int main_dst_pitch,
-    const unsigned char * __restrict__ main_src, int main_src_pitch,)RAW_STR",
+    const unsigned char * __restrict__ main_src, int main_src_pitch,
+    int width, int height,)RAW_STR",
             input_count);
 
     for (int ov_index = 0; ov_index < ov_count; ov_index++)
@@ -152,6 +157,7 @@ __global__ void AlignedOverlay420to420Chroma__%d(
 {
     int x = blockIdx.x * blockDim.x + threadIdx.x;
     int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= width || y >= height) return;
     int x2 = x * 2;
     int y2 = y * 2;
 
@@ -192,7 +198,8 @@ static void write_combined_420_420_function(FILE *file, int input_count)
             "    unsigned char *u_dst, int u_dst_pitch,\n"
             "    const unsigned char * __restrict__ u_src, int u_src_pitch,\n"
             "    unsigned char *v_dst, int v_dst_pitch,\n"
-            "    const unsigned char * __restrict__ v_src, int v_src_pitch",
+            "    const unsigned char * __restrict__ v_src, int v_src_pitch,\n"
+            "    int width, int height",
             input_count);
 
     for (int ov_index = 0; ov_index < ov_count; ov_index++)
@@ -211,7 +218,8 @@ static void write_combined_420_420_function(FILE *file, int input_count)
 
     fprintf(file, "\n{\n"
             "    int x = blockIdx.x * blockDim.x + threadIdx.x;\n"
-            "    int y = blockIdx.y * blockDim.y + threadIdx.y;\n\n");
+            "    int y = blockIdx.y * blockDim.y + threadIdx.y;\n"
+            "    if (x >= width || y >= height) return;\n\n");
 
     for (int ov_index = 0; ov_index < ov_count; ov_index++)
     {
@@ -272,7 +280,8 @@ static void write_combined_444_444_function(FILE *file, int input_count)
             "    unsigned char *u_dst, int u_dst_pitch,\n"
             "    const unsigned char * __restrict__ u_src, int u_src_pitch,\n"
             "    unsigned char *v_dst, int v_dst_pitch,\n"
-            "    const unsigned char * __restrict__ v_src, int v_src_pitch",
+            "    const unsigned char * __restrict__ v_src, int v_src_pitch,\n"
+            "    int width, int height",
             input_count);
 
     for (int ov_index = 0; ov_index < ov_count; ov_index++)
@@ -291,7 +300,8 @@ static void write_combined_444_444_function(FILE *file, int input_count)
 
     fprintf(file, "\n{\n"
             "    int x = blockIdx.x * blockDim.x + threadIdx.x;\n"
-            "    int y = blockIdx.y * blockDim.y + threadIdx.y;\n\n");
+            "    int y = blockIdx.y * blockDim.y + threadIdx.y;\n"
