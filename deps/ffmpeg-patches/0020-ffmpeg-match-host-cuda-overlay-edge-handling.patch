+++ b/libavfilter/vf_overlay_many_cuda_generator.c
@@ -10,6 +10,7 @@ static void write_standard_function(FILE *file, int input_count)
 __global__ void AlignedOverlay__%d(
     unsigned char *main_dst, int main_dst_pitch,
     const unsigned char * __restrict__ main_src, int main_src_pitch,
+    int width, int height,
     int alpha_adj_x, int alpha_adj_y,)RAW_STR",
             input_count);
 
@@ -27,6 +28,7 @@ __global__ void AlignedOverlay__%d(
 {
     int x = blockIdx.x * blockDim.x + threadIdx.x;
     int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= width || y >= height) return;
 
     int alpha_x = alpha_adj_x * x;
     int alpha_y = alpha_adj_y * y;
@@ -57,7 +59,8 @@ static void write_420_plus_444_function(FILE *file, int input_count)
 
 __global__ void AlignedOverlay420and444to420__%d(
     unsigned char *main_dst, int main_dst_pitch,
-    const unsigned char * __restrict__ main_src, int main_src_pitch,)RAW_STR",
+    const unsigned char * __restrict__ main_src, int main_src_pitch,
+    int width, int height,)RAW_STR",
             input_count);
 
     for (int ov_index = 0; ov_index < ov_count; ov_index++)
@@ -74,6 +77,7 @@ __global__ void AlignedOverlay420and444to420__%d(
 {
     int x = blockIdx.x * blockDim.x + threadIdx.x;
     int y = blockIdx.y * blockDim.y + threadIdx.y;
