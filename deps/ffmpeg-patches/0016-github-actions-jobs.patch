From: Jan Pietek <jan.pietek@gmail.com>
Date: Wed, 18 Mar 2026 09:19:58 +0100
Subject: [PATCH 16/40] github actions jobs

---
 .github/workflows/ci.yml               |  41 +++
 .github/workflows/ubuntu-25.04-deb.yml | 473 +++++++++++++++++++++++++
 2 files changed, 514 insertions(+)
 create mode 100644 .github/workflows/ci.yml
 create mode 100644 .github/workflows/ubuntu-25.04-deb.yml

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000000..eb24c9363f
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,41 @@
+name: CI
+
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Ubuntu minimal build
+    runs-on: ubuntu-24.04
+
+    steps:
+      - name: Check out sources
+        uses: actions/checkout@v4
+
+      - name: Install build dependencies
+        run: |
+          sudo apt-get update
+          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+            build-essential \
+            nasm \
+            pkg-config
+
+      - name: Configure
+        run: ./configure --disable-debug --disable-doc --disable-autodetect
+
+      - name: Build
+        run: make -j"$(nproc)"
+
+      - name: Smoke test binaries
+        run: |
+          ./ffmpeg -version
+          ./ffprobe -version
diff --git a/.github/workflows/ubuntu-25.04-deb.yml b/.github/workflows/ubuntu-25.04-deb.yml
new file mode 100644
index 0000000000..4a72ce0644
--- /dev/null
+++ b/.github/workflows/ubuntu-25.04-deb.yml
@@ -0,0 +1,473 @@
+name: Ubuntu 25.04 CUDA deb package
+
+on:
+  workflow_dispatch:
+    inputs:
+      regular_package_name:
+        description: Debian package basename for the non-NVIDIA build
+        required: true
+        default: ffmpeg
+        type: string
+      nvidia_package_name:
+        description: Debian package basename for the NVIDIA build
+        required: true
+        default: ffmpeg-nvidia
+        type: string
+      extra_configure_flags:
+        description: Additional flags appended to both ./configure commands
+        required: false
+        default: ""
+        type: string
+      strip_binaries:
+        description: Strip installed binaries and shared libraries
+        required: true
+        default: true
+        type: boolean
+
+permissions:
+  contents: read
+
+jobs:
+  build-regular-deb:
+    name: Build Ubuntu 25.04 regular .deb
+    runs-on: ubuntu-24.04
+
+    # GitHub-hosted runners do not currently expose an ubuntu-25.04 label,
+    # so the regular package build runs inside a 25.04 container.
+    container:
+      image: ubuntu:25.04
+
+    env:
+      DEBIAN_FRONTEND: noninteractive
+      FFMPEG_PREFIX: /usr/local
+
+    steps:
+      - name: Check out sources
+        uses: actions/checkout@v4
+
+      - name: Install packaging dependencies
+        run: |
+          apt-get update
+          apt-get install -y --no-install-recommends \
+            build-essential \
+            ca-certificates \
+            dpkg-dev \
+            git \
+            libgnutls28-dev \
+            libwebp-dev \
+            nasm \
+            pkg-config
+
+      - name: Configure and build
+        shell: bash
+        run: |
+          set -euxo pipefail
+          export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig"
+          ./configure \
+            --prefix="${FFMPEG_PREFIX}" \
+            --libdir="${FFMPEG_PREFIX}/lib" \
+            --incdir="${FFMPEG_PREFIX}/include" \
+            --pkgconfigdir="${FFMPEG_PREFIX}/lib/pkgconfig" \
+            --enable-gpl \
+            --enable-nonfree \
+            --extra-ldflags=-lm \
+            --extra-ldflags=-ldl \
+            --enable-pthreads \
+            --extra-libs=-lpthread \
+            --enable-encoders \
+            --enable-decoders \
+            --enable-avfilter \
+            --enable-muxers \
+            --enable-demuxers \
+            --enable-parsers \
+            --enable-x86asm \
+            --disable-debug \
+            --disable-ffplay \
+            --enable-ffprobe \
+            --disable-libx264 \
+            --disable-libx265 \
+            --disable-libaom \
+            --disable-libvpx \
+            --disable-libvpl \
+            --disable-libsrt \
+            --disable-libvmaf \
+            --enable-shared \
+            --disable-doc \
+            --disable-htmlpages \
+            --disable-manpages \
+            --disable-podpages \
+            --disable-txtpages \
+            --enable-libwebp \
+            --enable-gnutls \
+            --enable-bsf=scte35ptsadjust \
+            --enable-bsf=h264_mp4toannexb \
+            --enable-bsf=h264_redundant_pps \
+            --enable-bsf=extract_extradata \
+            --enable-bsf=aac_adtstoasc \
+            --enable-protocol=file \
+            --enable-protocol=udp \
+            --enable-protocol=pipe \
+            --enable-protocol=tls \
+            --enable-protocol=http \
+            --enable-protocol=https \
+            --enable-protocol=rtmp \
+            --enable-protocol=rtmps \
+            --enable-protocol=tcp \
+            --enable-protocol=fd \
+            --enable-protocol=crypto \
+            --enable-protocol=tee \
+            --enable-protocol=concat \
+            --enable-protocol=hls \
+            --enable-protocol=rtp \
+            --enable-protocol=rtsp \
+            --enable-muxer=flv \
+            --enable-muxer=rtp_mpegts \
+            --enable-muxer=mpegts \
+            --enable-muxer=mp4 \
+            --enable-muxer=matroska \
+            --enable-demuxer=mpegts \
+            --enable-demuxer=mov \
+            --enable-demuxer=matroska \
+            --enable-demuxer=flv \
+            --enable-demuxer=aac \
+            --enable-filter=aformat \
+            --enable-filter=aresample \
+            --enable-encoder=aac \
+            --enable-encoder=ac3 \
+            --enable-encoder=mp2 \
+            --enable-encoder=mp3 \
+            --enable-encoder=opus \
+            --enable-decoder=aac \
+            --enable-decoder=h264 \
+            --enable-decoder=h265 \
+            --enable-decoder=ac3 \
+            --enable-decoder=mp2 \
+            --enable-decoder=mp3 \
+            --enable-decoder=opus \
+            --enable-parser=aac \
+            --enable-parser=h264 \
+            --enable-parser=hevc \
+            --enable-parser=h265 \
+            --enable-parser=ac3 \
+            --enable-parser=mp3 \
+            --enable-parser=mp2 \
+            --enable-parser=opus \
+            ${{ inputs.extra_configure_flags }}
+          make -j"$(nproc)"
+
+      - name: Stage package contents
+        id: stage
+        shell: bash
+        run: |
+          set -euxo pipefail
+          raw_pkg_name="${{ inputs.regular_package_name }}"
+          pkg_name="$(printf '%s' "${raw_pkg_name}" | tr '[:upper:]_' '[:lower:]-' | sed 's/[^a-z0-9.+-]/-/g; s/^-*//; s/-*$//')"
+          version="$(tr -d '\n' < RELEASE)"
+          commit="$(git rev-parse --short HEAD)"
+          arch="$(dpkg --print-architecture)"
+          pkg_version="${version}+git${commit}-1"
+          stage_dir="${GITHUB_WORKSPACE}/out/package-root"
+          artifact_dir="${GITHUB_WORKSPACE}/out/artifacts"
+          package_file="${artifact_dir}/${pkg_name}_${pkg_version}_ubuntu2504_${arch}.deb"
+
+          if [[ -z "${pkg_name}" ]]; then
+            echo "regular_package_name must resolve to a valid Debian package name" >&2
+            exit 1
+          fi
+
+          rm -rf "${GITHUB_WORKSPACE}/out"
+          mkdir -p "${stage_dir}" "${artifact_dir}"
+          export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig"
+          make DESTDIR="${stage_dir}" install
+
+          if [[ -x "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" ]]; then
+            "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" -version
+          fi
+
+          if [[ "${{ inputs.strip_binaries }}" == "true" ]]; then
+            find "${stage_dir}${FFMPEG_PREFIX}" -type f \
+              \( -name '*.so' -o -name '*.so.*' -o -perm -0100 \) \
+              -exec strip --strip-unneeded {} + || true
+          fi
+
+          mkdir -p "${stage_dir}/DEBIAN" "${stage_dir}/usr/bin"
+          for tool in ffmpeg ffprobe ffplay; do
+            if [[ -x "${stage_dir}${FFMPEG_PREFIX}/bin/${tool}" ]]; then
+              cat > "${stage_dir}/usr/bin/${tool}" <<EOF
+#!/bin/sh
+exec ${FFMPEG_PREFIX}/bin/${tool} "\$@"
+EOF
+              chmod 0755 "${stage_dir}/usr/bin/${tool}"
+            fi
+          done
+
+          installed_size="$(du -sk "${stage_dir}" | cut -f1)"
+          maintainer="${GITHUB_REPOSITORY_OWNER} <noreply@github.com>"
+
+          cat > "${stage_dir}/DEBIAN/control" <<EOF
+Package: ${pkg_name}
+Version: ${pkg_version}
+Section: video
+Priority: optional
+Architecture: ${arch}
+Maintainer: ${maintainer}
+Installed-Size: ${installed_size}
+Description: FFmpeg build from ${GITHUB_REPOSITORY}
+ Self-contained FFmpeg build produced by GitHub Actions for Ubuntu 25.04.
+ Installed under ${FFMPEG_PREFIX} with launcher scripts in /usr/bin.
+EOF
+
+          dpkg-deb --build --root-owner-group "${stage_dir}" "${package_file}"
+
+          {
+            echo "package_file=${package_file}"
+            echo "package_name=$(basename "${package_file}")"
+          } >> "${GITHUB_OUTPUT}"
+
+      - name: Verify package metadata
+        shell: bash
+        run: |
+          set -euxo pipefail
+          dpkg-deb --info "${{ steps.stage.outputs.package_file }}"
+          dpkg-deb --contents "${{ steps.stage.outputs.package_file }}" | sed -n '1,120p'
+
+      - name: Upload deb artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ steps.stage.outputs.package_name }}
+          path: ${{ steps.stage.outputs.package_file }}
+
+  build-nvidia-deb:
+    name: Build Ubuntu 25.04 NVIDIA .deb
+    # This workflow is intended for a self-hosted Ubuntu 25.04 x86_64 runner
+    # with CUDA 13.0 already installed at /usr/local/cuda-13.0.
+    runs-on: [self-hosted, linux, x64, ubuntu-25.04, cuda]
+
+    env:
+      DEBIAN_FRONTEND: noninteractive
+      FFMPEG_PREFIX: /usr/local
+      CUDA_PREFIX: /usr/local/cuda-13.0
+
+    steps:
+      - name: Check out sources
+        uses: actions/checkout@v4
+
+      - name: Install packaging dependencies
+        run: |
+          apt-get update
+          apt-get install -y --no-install-recommends \
+            build-essential \
+            ca-certificates \
+            dpkg-dev \
+            git \
+            libgnutls28-dev \
+            libwebp-dev \
+            nasm \
+            pkg-config
+
+      - name: Validate CUDA toolchain
+        shell: bash
+        run: |
+          set -euxo pipefail
+          test "$(uname -m)" = "x86_64"
+          test -x "${CUDA_PREFIX}/bin/nvcc"
+          test -d "${CUDA_PREFIX}/targets/x86_64-linux/include"
+          test -d "${CUDA_PREFIX}/targets/x86_64-linux/lib"
+
+      - name: Install nv-codec-headers
+        shell: bash
+        run: |
+          set -euxo pipefail
+          if ! pkg-config --exists ffnvcodec; then
+            git clone --depth=1 https://github.com/FFmpeg/nv-codec-headers.git /tmp/nv-codec-headers
+            make -C /tmp/nv-codec-headers -j"$(nproc)"
+            make -C /tmp/nv-codec-headers install PREFIX=/usr/local
+          fi
+
+      - name: Configure and build
+        shell: bash
+        run: |
+          set -euxo pipefail
+          export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig"
+          ./configure \
+            --prefix="${FFMPEG_PREFIX}" \
+            --libdir="${FFMPEG_PREFIX}/lib" \
+            --incdir="${FFMPEG_PREFIX}/include" \
+            --pkgconfigdir="${FFMPEG_PREFIX}/lib/pkgconfig" \
+            --enable-gpl \
+            --enable-nonfree \
+            --extra-ldflags=-lm \
+            --extra-ldflags=-ldl \
+            --enable-pthreads \
+            --extra-libs=-lpthread \
+            --enable-encoders \
+            --enable-decoders \
+            --enable-avfilter \
+            --enable-muxers \
+            --enable-demuxers \
+            --enable-parsers \
+            --enable-x86asm \
+            --disable-debug \
+            --disable-ffplay \
+            --enable-ffprobe \
+            --disable-libx264 \
+            --disable-libx265 \
+            --disable-libaom \
+            --disable-libvpx \
+            --extra-cflags=-I"${CUDA_PREFIX}/targets/x86_64-linux/include" \
+            --extra-ldflags=-L"${CUDA_PREFIX}/targets/x86_64-linux/lib" \
+            --enable-ffnvcodec \
+            --enable-cuda-nvcc \
+            --enable-cuda \
+            --disable-libvpl \
+            --enable-cuvid \
+            --enable-nvdec \
+            --enable-nvenc \
+            --disable-libsrt \
+            --disable-libvmaf \
+            --enable-shared \
+            --disable-doc \
+            --disable-htmlpages \
+            --disable-manpages \
+            --disable-podpages \
+            --disable-txtpages \
+            --enable-libwebp \
+            --enable-gnutls \
+            --enable-bsf=scte35ptsadjust \
+            --enable-bsf=h264_mp4toannexb \
+            --enable-bsf=h264_redundant_pps \
+            --enable-bsf=extract_extradata \
+            --enable-bsf=aac_adtstoasc \
+            --enable-protocol=file \
+            --enable-protocol=udp \
+            --enable-protocol=pipe \
+            --enable-protocol=tls \
+            --enable-protocol=http \
+            --enable-protocol=https \
+            --enable-protocol=rtmp \
+            --enable-protocol=rtmps \
+            --enable-protocol=tcp \
+            --enable-protocol=fd \
+            --enable-protocol=crypto \
+            --enable-protocol=tee \
+            --enable-protocol=concat \
+            --enable-protocol=hls \
+            --enable-protocol=rtp \
+            --enable-protocol=rtsp \
+            --enable-muxer=flv \
+            --enable-muxer=rtp_mpegts \
+            --enable-muxer=mpegts \
+            --enable-muxer=mp4 \
+            --enable-muxer=matroska \
+            --enable-demuxer=mpegts \
+            --enable-demuxer=mov \
+            --enable-demuxer=matroska \
+            --enable-demuxer=flv \
+            --enable-demuxer=aac \
+            --enable-filter=aformat \
+            --enable-filter=aresample \
+            --enable-encoder=aac \
+            --enable-encoder=ac3 \
+            --enable-encoder=mp2 \
+            --enable-encoder=mp3 \
+            --enable-encoder=opus \
+            --enable-decoder=aac \
+            --enable-decoder=h264 \
+            --enable-decoder=h265 \
+            --enable-decoder=ac3 \
+            --enable-decoder=mp2 \
+            --enable-decoder=mp3 \
+            --enable-decoder=opus \
+            --enable-parser=aac \
+            --enable-parser=h264 \
+            --enable-parser=hevc \
+            --enable-parser=h265 \
+            --enable-parser=ac3 \
+            --enable-parser=mp3 \
+            --enable-parser=mp2 \
+            --enable-parser=opus \
+            --nvcc="${CUDA_PREFIX}/bin/nvcc" \
+            ${{ inputs.extra_configure_flags }}
+          make -j"$(nproc)"
+
+      - name: Stage package contents
+        id: stage
+        shell: bash
+        run: |
+          set -euxo pipefail
+          raw_pkg_name="${{ inputs.nvidia_package_name }}"
+          pkg_name="$(printf '%s' "${raw_pkg_name}" | tr '[:upper:]_' '[:lower:]-' | sed 's/[^a-z0-9.+-]/-/g; s/^-*//; s/-*$//')"
+          version="$(tr -d '\n' < RELEASE)"
+          commit="$(git rev-parse --short HEAD)"
+          arch="$(dpkg --print-architecture)"
+          pkg_version="${version}+git${commit}-1"
+          stage_dir="${GITHUB_WORKSPACE}/out/package-root"
+          artifact_dir="${GITHUB_WORKSPACE}/out/artifacts"
+          package_file="${artifact_dir}/${pkg_name}_${pkg_version}_ubuntu2504_${arch}.deb"
+
+          if [[ -z "${pkg_name}" ]]; then
+            echo "nvidia_package_name must resolve to a valid Debian package name" >&2
+            exit 1
+          fi
+
+          rm -rf "${GITHUB_WORKSPACE}/out"
+          mkdir -p "${stage_dir}" "${artifact_dir}"
+          export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig"
+          make DESTDIR="${stage_dir}" install
+
+          if [[ -x "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" ]]; then
+            "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" -version
+          fi
+
+          if [[ "${{ inputs.strip_binaries }}" == "true" ]]; then
+            find "${stage_dir}${FFMPEG_PREFIX}" -type f \
+              \( -name '*.so' -o -name '*.so.*' -o -perm -0100 \) \
+              -exec strip --strip-unneeded {} + || true
+          fi
+
+          mkdir -p "${stage_dir}/DEBIAN" "${stage_dir}/usr/bin"
+          for tool in ffmpeg ffprobe ffplay; do
+            if [[ -x "${stage_dir}${FFMPEG_PREFIX}/bin/${tool}" ]]; then
+              cat > "${stage_dir}/usr/bin/${tool}" <<EOF
+#!/bin/sh
+exec ${FFMPEG_PREFIX}/bin/${tool} "\$@"
+EOF
+              chmod 0755 "${stage_dir}/usr/bin/${tool}"
+            fi
+          done
+
+          installed_size="$(du -sk "${stage_dir}" | cut -f1)"
+          maintainer="${GITHUB_REPOSITORY_OWNER} <noreply@github.com>"
+
+          cat > "${stage_dir}/DEBIAN/control" <<EOF
+Package: ${pkg_name}
+Version: ${pkg_version}
+Section: video
+Priority: optional
+Architecture: ${arch}
+Maintainer: ${maintainer}
+Installed-Size: ${installed_size}
+Description: FFmpeg build from ${GITHUB_REPOSITORY}
+ Self-contained FFmpeg build produced by GitHub Actions for Ubuntu 25.04.
+ Installed under ${FFMPEG_PREFIX} with launcher scripts in /usr/bin.
+EOF
+
+          dpkg-deb --build --root-owner-group "${stage_dir}" "${package_file}"
+
+          {
+            echo "package_file=${package_file}"
+            echo "package_name=$(basename "${package_file}")"
+          } >> "${GITHUB_OUTPUT}"
+
+      - name: Verify package metadata
+        shell: bash
+        run: |
+          set -euxo pipefail
+          dpkg-deb --info "${{ steps.stage.outputs.package_file }}"
+          dpkg-deb --contents "${{ steps.stage.outputs.package_file }}" | sed -n '1,120p'
+
+      - name: Upload deb artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ steps.stage.outputs.package_name }}
+          path: ${{ steps.stage.outputs.package_file }}
