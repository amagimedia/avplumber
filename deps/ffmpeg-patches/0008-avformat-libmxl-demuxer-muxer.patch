diff --git a/libavformat/jsmn.h b/libavformat/jsmn.h
new file mode 100644
index 0000000000..b95368a206
--- /dev/null
+++ b/libavformat/jsmn.h
@@ -0,0 +1,468 @@
+/*
+ * MIT License
+ *
+ * Copyright (c) 2010 Serge Zaitsev
+ *
