+
+    rc = mxl_diag_client_close(&client);
+    if (rc) {
+        fprintf(stderr, "client close failed\n");
+        exit_status = rc;
+        goto finally;
+    }
+
+    exit_status = 0;
+
+finally:
+
+    if (client.fd >= 0) {
+        rc = mxl_diag_client_close(&client);
+        av_assert0(rc == 0);
+    }
+
+
+    return exit_status;
