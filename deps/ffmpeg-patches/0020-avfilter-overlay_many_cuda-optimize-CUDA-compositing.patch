-    unsigned char *ov0alpha, int ov0alpha_pitch)
+    const unsigned char * __restrict__ ov0, int ov0_pitch,
+    const unsigned char * __restrict__ ov0alpha, int ov0alpha_pitch)
 {
     int x = blockIdx.x * blockDim.x + threadIdx.x;
     int y = blockIdx.y * blockDim.y + threadIdx.y;
 
     int alpha_x = alpha_adj_x * x;
     int alpha_y = alpha_adj_y * y;
-    float alpha0 = ov0alpha[alpha_x + alpha_y * ov0alpha_pitch] / 255.f;
+    unsigned int alpha0 = ov0alpha[alpha_x + alpha_y * ov0alpha_pitch];
 
-    unsigned char m = main[x + y*main_pitch];
-    m = alpha0 * ov0[x + y*ov0_pitch] + (1.f - alpha0) * m;
-    main[x + y*main_pitch] = m;
+    unsigned int m = main_src[x + y*main_src_pitch];
+    m = (alpha0 * (unsigned int)ov0[x + y*ov0_pitch] + (255u - alpha0) * m + 127u) >> 8;
+    main_dst[x + y*main_dst_pitch] = (unsigned char)m;
 }
 
 
