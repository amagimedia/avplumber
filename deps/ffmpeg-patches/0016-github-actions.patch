+name: Ubuntu CPU deb packages
+
+on:
+  workflow_dispatch:
+    inputs:
+      regular_package_name:
+        description: Debian package basename for the non-NVIDIA build
+        required: true
+        default: ffmpeg
+        type: string
+      regular_extra_configure_flags:
+        description: Additional flags appended to the regular non-NVIDIA configure command
+        required: false
+        default: ""
+        type: string
+      strip_binaries:
+        description: Strip installed binaries and shared libraries
+        required: true
+        default: true
+        type: boolean
+
+permissions:
+  contents: read
+
+jobs:
+  build-regular-deb:
+    name: Build Ubuntu 25.04 CPU .deb
+    runs-on: ubuntu-24.04
+
+    container:
+      image: ubuntu:25.04
+
+    env:
+      DEBIAN_FRONTEND: noninteractive
+      FFMPEG_PREFIX: /usr
+      SOURCE_COMMIT: ${{ github.sha }}
+
+    steps:
+      - name: Check out sources
+        uses: actions/checkout@v4
+
+      - name: Install packaging dependencies
+        run: |
+          apt-get update
+          apt-get install -y --no-install-recommends \
+            build-essential \
+            ca-certificates \
+            dpkg-dev \
+            git \
+            libgnutls28-dev \
+            libwebp-dev \
+            nasm \
+            pkg-config
+
+      - name: Install nv-codec-headers compatibility headers
+        shell: bash
+        run: |
+          set -euxo pipefail
+          if ! pkg-config --exists ffnvcodec; then
+            git clone --depth=1 https://github.com/FFmpeg/nv-codec-headers.git /tmp/nv-codec-headers
+            make -C /tmp/nv-codec-headers -j"$(nproc)"
+            make -C /tmp/nv-codec-headers install PREFIX=/usr/local
+          fi
+
+      - name: Configure and build
+        shell: bash
+        run: |
+          set -euxo pipefail
+          case " ${{ inputs.regular_extra_configure_flags }} " in
+            *"cuda"*|*"nvcc"*|*"ffnvcodec"*|*"cuvid"*|*"nvdec"*|*"nvenc"*|*"npp"*)
+              echo "regular_extra_configure_flags must not include NVIDIA/CUDA-related options" >&2
+              exit 1
+              ;;
+          esac
+          export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig"
+          ./configure \
+            --prefix="${FFMPEG_PREFIX}" \
+            --libdir="${FFMPEG_PREFIX}/lib" \
+            --incdir="${FFMPEG_PREFIX}/include" \
+            --pkgconfigdir="${FFMPEG_PREFIX}/lib/pkgconfig" \
+            --enable-gpl \
+            --enable-nonfree \
+            --extra-ldflags=-lm \
+            --extra-ldflags=-ldl \
+            --enable-pthreads \
+            --extra-libs=-lpthread \
+            --enable-encoders \
+            --enable-decoders \
+            --enable-avfilter \
+            --enable-muxers \
+            --enable-demuxers \
+            --enable-parsers \
+            --enable-x86asm \
+            --disable-debug \
+            --disable-ffplay \
+            --enable-ffprobe \
+            --disable-libx264 \
+            --disable-libx265 \
+            --disable-libaom \
+            --disable-libvpx \
+            --disable-cuda \
+            --disable-cuda-nvcc \
+            --disable-cuda-llvm \
+            --disable-cuvid \
+            --disable-ffnvcodec \
+            --disable-nvdec \
+            --disable-nvenc \
+            --disable-filter=bilateral_cuda \
+            --disable-filter=bwdif_cuda \
+            --disable-filter=chromakey_cuda \
+            --disable-filter=colorspace_cuda \
+            --disable-filter=convert_cuda \
+            --disable-filter=crop_cuda \
+            --disable-filter=hwupload_cuda \
+            --disable-filter=libvmaf_cuda \
+            --disable-filter=overlay_cuda \
+            --disable-filter=overlay_many_cuda \
+            --disable-filter=pad_cuda \
+            --disable-filter=scale_cuda \
+            --disable-filter=scale_npp \
+            --disable-filter=scale2ref_npp \
+            --disable-filter=sharpen_npp \
+            --disable-filter=thumbnail_cuda \
+            --disable-filter=transition_cuda \
+            --disable-filter=transpose_npp \
+            --disable-filter=yadif_cuda \
+            --disable-libvpl \
+            --disable-libsrt \
+            --disable-libvmaf \
+            --enable-shared \
+            --disable-doc \
+            --disable-htmlpages \
+            --disable-manpages \
+            --disable-podpages \
+            --disable-txtpages \
+            --enable-libwebp \
+            --enable-gnutls \
+            --enable-bsf=scte35ptsadjust \
+            --enable-bsf=h264_mp4toannexb \
+            --enable-bsf=h264_redundant_pps \
+            --enable-bsf=extract_extradata \
+            --enable-bsf=aac_adtstoasc \
+            --enable-protocol=file \
+            --enable-protocol=udp \
+            --enable-protocol=pipe \
+            --enable-protocol=tls \
+            --enable-protocol=http \
+            --enable-protocol=https \
+            --enable-protocol=rtmp \
+            --enable-protocol=rtmps \
+            --enable-protocol=tcp \
+            --enable-protocol=fd \
+            --enable-protocol=crypto \
+            --enable-protocol=tee \
+            --enable-protocol=concat \
+            --enable-protocol=hls \
+            --enable-protocol=rtp \
+            --enable-protocol=rtsp \
+            --enable-muxer=flv \
+            --enable-muxer=rtp_mpegts \
+            --enable-muxer=mpegts \
+            --enable-muxer=mp4 \
+            --enable-muxer=matroska \
+            --enable-demuxer=mpegts \
+            --enable-demuxer=mov \
+            --enable-demuxer=matroska \
+            --enable-demuxer=flv \
+            --enable-demuxer=aac \
+            --enable-filter=aformat \
+            --enable-filter=aresample \
+            --enable-encoder=aac \
+            --enable-encoder=ac3 \
+            --enable-encoder=mp2 \
+            --enable-encoder=mp3 \
+            --enable-encoder=opus \
+            --enable-decoder=aac \
+            --enable-decoder=h264 \
+            --enable-decoder=h265 \
+            --enable-decoder=ac3 \
+            --enable-decoder=mp2 \
+            --enable-decoder=mp3 \
+            --enable-decoder=opus \
+            --enable-parser=aac \
+            --enable-parser=h264 \
+            --enable-parser=hevc \
+            --enable-parser=h265 \
+            --enable-parser=ac3 \
+            --enable-parser=mp3 \
+            --enable-parser=mp2 \
+            --enable-parser=opus \
+            ${{ inputs.regular_extra_configure_flags }}
+          make -j"$(nproc)"
+
+      - name: Stage package contents
+        id: stage
+        shell: bash
+        run: |
+          set -euxo pipefail
+          raw_pkg_name="${{ inputs.regular_package_name }}"
+          pkg_name="$(printf '%s' "${raw_pkg_name}" | tr '[:upper:]_' '[:lower:]-' | sed 's/[^a-z0-9.+-]/-/g; s/^-*//; s/-*$//')"
+          version="$(tr -d '\n' < RELEASE)"
+          commit="${SOURCE_COMMIT:0:7}"
+          arch="$(dpkg --print-architecture)"
+          pkg_version="${version}+git${commit}-1"
+          stage_dir="${GITHUB_WORKSPACE}/out/package-root"
+          artifact_dir="${GITHUB_WORKSPACE}/out/artifacts"
+          package_file="${artifact_dir}/${pkg_name}_${pkg_version}_ubuntu2504_${arch}.deb"
+
+          if [[ -z "${pkg_name}" ]]; then
+            echo "regular_package_name must resolve to a valid Debian package name" >&2
+            exit 1
+          fi
+
+          rm -rf "${GITHUB_WORKSPACE}/out"
+          mkdir -p "${stage_dir}" "${artifact_dir}"
+          export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig"
+          make DESTDIR="${stage_dir}" install
+
+          if [[ -x "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" ]]; then
+            LD_LIBRARY_PATH="${stage_dir}${FFMPEG_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
+              "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" -version
+          fi
+
+          if [[ "${{ inputs.strip_binaries }}" == "true" ]]; then
+            find "${stage_dir}${FFMPEG_PREFIX}" -type f \
+              \( -name '*.so' -o -name '*.so.*' -o -perm -0100 \) \
+              -exec strip --strip-unneeded {} + || true
+          fi
+
+          mkdir -p "${stage_dir}/DEBIAN"
+
+          installed_size="$(du -sk "${stage_dir}" | cut -f1)"
+          maintainer="${GITHUB_REPOSITORY_OWNER} <noreply@github.com>"
+
+          printf '%s\n' \
+            "Package: ${pkg_name}" \
+            "Version: ${pkg_version}" \
+            'Section: video' \
+            'Priority: optional' \
+            "Architecture: ${arch}" \
+            "Maintainer: ${maintainer}" \
+            "Installed-Size: ${installed_size}" \
+            "Description: FFmpeg build from ${GITHUB_REPOSITORY}" \
+            ' Self-contained FFmpeg build produced by GitHub Actions for Ubuntu 25.04.' \
+            " Installed under ${FFMPEG_PREFIX}." \
+            > "${stage_dir}/DEBIAN/control"
+
+          dpkg-deb --build --root-owner-group "${stage_dir}" "${package_file}"
+
+          {
+            echo "package_file=${package_file}"
+            echo "package_name=$(basename "${package_file}")"
+          } >> "${GITHUB_OUTPUT}"
+
+      - name: Verify package metadata
+        shell: bash
+        run: |
+          set -euxo pipefail
+          dpkg-deb --info "${{ steps.stage.outputs.package_file }}"
+          dpkg-deb --contents "${{ steps.stage.outputs.package_file }}" | sed -n '1,120p'
+
+      - name: Upload deb artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ steps.stage.outputs.package_name }}
+          path: ${{ steps.stage.outputs.package_file }}
+
