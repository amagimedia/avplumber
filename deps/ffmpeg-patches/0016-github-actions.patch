diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..a9fd934
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,80 @@
+name: CI
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Ubuntu non-NVIDIA build
+    runs-on: ubuntu-24.04
+
+    steps:
+      - name: Check out sources
+        uses: actions/checkout@v4
+
+      - name: Install build dependencies
+        run: |
+          sudo apt-get update
+          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+            build-essential \
+            git \
+            nasm \
+            pkg-config
+
+      - name: Install nv-codec-headers compatibility headers
+        shell: bash
+        run: |
+          set -euxo pipefail
+          if ! pkg-config --exists ffnvcodec; then
+            git clone --depth=1 https://github.com/FFmpeg/nv-codec-headers.git /tmp/nv-codec-headers
+            make -C /tmp/nv-codec-headers -j"$(nproc)"
+            sudo make -C /tmp/nv-codec-headers install PREFIX=/usr/local
+          fi
+
+      - name: Configure
+        run: |
+          ./configure \
+            --disable-debug \
+            --disable-doc \
+            --disable-autodetect \
+            --disable-cuda \
+            --disable-cuda-nvcc \
+            --disable-cuda-llvm \
+            --disable-cuvid \
+            --disable-ffnvcodec \
+            --disable-nvdec \
+            --disable-nvenc \
+            --disable-filter=bilateral_cuda \
+            --disable-filter=bwdif_cuda \
+            --disable-filter=chromakey_cuda \
+            --disable-filter=colorspace_cuda \
+            --disable-filter=convert_cuda \
+            --disable-filter=crop_cuda \
+            --disable-filter=hwupload_cuda \
+            --disable-filter=libvmaf_cuda \
+            --disable-filter=overlay_cuda \
+            --disable-filter=overlay_many_cuda \
+            --disable-filter=pad_cuda \
+            --disable-filter=scale_cuda \
+            --disable-filter=scale_npp \
+            --disable-filter=scale2ref_npp \
+            --disable-filter=sharpen_npp \
+            --disable-filter=thumbnail_cuda \
+            --disable-filter=transition_cuda \
+            --disable-filter=transpose_npp \
+            --disable-filter=yadif_cuda
+
+      - name: Build
+        run: make -j"$(nproc)"
+
+      - name: Smoke test binaries
+        run: |
+          ./ffmpeg -version
+          ./ffprobe -version
