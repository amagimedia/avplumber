+static int pack_frame(OverlayManyCUDAFrame *descriptor,
+                      const AVFrame *frame, int plane_count)
+{
+    for (int plane = 0; plane < plane_count; plane++) {
+        if (!frame->data[plane] || frame->linesize[plane] <= 0)
+            return AVERROR(EINVAL);
+
+        descriptor->plane[plane].ptr = (uint64_t)(uintptr_t)frame->data[plane];
+        descriptor->plane[plane].pitch = frame->linesize[plane];
+    }
+
+    return 0;
