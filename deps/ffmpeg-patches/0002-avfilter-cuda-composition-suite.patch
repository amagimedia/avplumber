+typedef unsigned char uint8_t;
+typedef unsigned short uint16_t;
+
+// @todo: 3 shaders here are indentical to Convert_YUVA444P12LE_ya_to_YUVA420P
+// Boilerplate/organization code in vf_convert_cuda.c
+// could be refactored a bit so there is less copypasta.
