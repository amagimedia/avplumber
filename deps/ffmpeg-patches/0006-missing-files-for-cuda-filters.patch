+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    int x2 = x*2;
+    int y2 = y*2;
+
+)RAW_STR");
+
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        for (int i = 0; i < 4; i++)
+        {
+            int bit_x = i & 1;
+            int bit_y = i >> 1;
+            fprintf(file, "    float ov%d_alpha%d%d = ov%dalpha[(y2 + %d) * ov%dalpha_pitch + (x2 + %d)] / 255.f;\n",
+                    ov_index, bit_y, bit_x,
+                    ov_index, bit_y, ov_index, bit_x);
+        }
+    }
+    fprintf(file, "\n");
+
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        for (int i = 0; i < 4; i++)
+        {
+            int bit_x = i & 1;
+            int bit_y = i >> 1;
+            fprintf(file, "    float ov%d_%d%d = ov%d[(y2 + %d) * ov%d_pitch + (x2 + %d)];\n",
+                    ov_index, bit_y, bit_x,
+                    ov_index, bit_y, ov_index, bit_x);
+        }
+    }
+
+    fprintf(file, "\n    float m00, m10, m01, m11;\n"
+            "    m00 = m10 = m01 = m11 = main[x + y*main_pitch];\n");
+    
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        for (int i = 0; i < 4; i++)
+        {
+            int bit_x = i & 1;
+            int bit_y = i >> 1;
+            fprintf(file, "    m%d%d = ov%d_alpha%d%d * ov%d_%d%d + (1.f - ov%d_alpha%d%d) * m%d%d;\n",
+                    bit_y, bit_x,
+                    ov_index, bit_y, bit_x,
+                    ov_index, bit_y, bit_x,
+                    ov_index, bit_y, bit_x,
+                    bit_y, bit_x);
+        }
+    }    
+    
+    fprintf(file, "    main[x + y*main_pitch] = (m00 + m10 + m01 + m11) / 4.f;\n}\n");
+}
+
+
+int main()
+{
+    char *filename = "vf_overlay_many_cuda.cu";
+    FILE *file = fopen(filename, "wb");
+
+    if (file)
+    {
+        fprintf(file, "// This code is generated by vf_overlay_many_cuda_generator.c\n"
+        		"// Use run_overlay_many_cuda_generator.sh to refresh it\n"
+        	    "extern \"C\" {\n");
+
+        for (int input_count = 2; input_count <= MAX_INPUT_COUNT; input_count++)
+            write_standard_function(file, input_count);
+
+        for (int input_count = 2; input_count <= MAX_INPUT_COUNT; input_count++)
+            write_420_plus_444_function(file, input_count);
+
+        fprintf(file, "\n} // extern \"C\"\n");
+        fclose(file);
+    }
+    else
+    {
+        printf("failed to create the file %s\n", filename);
+    }
+}
