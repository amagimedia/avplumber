From dd99bcb9bdcd9452b32b5ebb4bb40c991aefad66 Mon Sep 17 00:00:00 2001
From: Jan Pietek <jan.pietek@gmail.com>
Date: Wed, 18 Mar 2026 12:28:41 +0100
Subject: [PATCH 28/40] nvidia build again

---
 .github/workflows/ubuntu-25.04-deb.yml | 28 ++++++++++++++++++++------
 1 file changed, 22 insertions(+), 6 deletions(-)

diff --git a/.github/workflows/ubuntu-25.04-deb.yml b/.github/workflows/ubuntu-25.04-deb.yml
index cfff078d28..7e77b1dc11 100644
--- a/.github/workflows/ubuntu-25.04-deb.yml
+++ b/.github/workflows/ubuntu-25.04-deb.yml
@@ -560,8 +560,8 @@ jobs:
 
       - name: Install packaging dependencies
         run: |
-          apt-get update
-          apt-get install -y --no-install-recommends \
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
             build-essential \
             ca-certificates \
             dpkg-dev \
@@ -585,12 +585,27 @@ jobs:
             tmpdir="$(mktemp -d)"
             wget -O "${tmpdir}/cuda-keyring.deb" \
               https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb
-            dpkg -i "${tmpdir}/cuda-keyring.deb"
-            apt-get update
-            DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cuda-toolkit-13-0
+            sudo dpkg -i "${tmpdir}/cuda-keyring.deb"
+            sudo apt-get update
+            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cuda-toolkit-13-0
             rm -rf "${tmpdir}"
           fi
 
+          resolved_cuda_prefix=""
+          if [[ -x "/usr/local/cuda-13.0/bin/nvcc" ]]; then
+            resolved_cuda_prefix="/usr/local/cuda-13.0"
+          elif [[ -x "/usr/local/cuda/bin/nvcc" ]]; then
+            resolved_cuda_prefix="/usr/local/cuda"
+          fi
+
+          if [[ -z "${resolved_cuda_prefix}" ]]; then
+            echo "nvcc was not found after CUDA toolkit installation" >&2
+            exit 1
+          fi
+
+          echo "CUDA_PREFIX=${resolved_cuda_prefix}" >> "${GITHUB_ENV}"
+          "${resolved_cuda_prefix}/bin/nvcc" --version
+
       - name: Validate CUDA toolchain
         shell: bash
         run: |
@@ -599,6 +614,7 @@ jobs:
           test -x "${CUDA_PREFIX}/bin/nvcc"
           test -d "${CUDA_PREFIX}/targets/x86_64-linux/include"
           test -d "${CUDA_PREFIX}/targets/x86_64-linux/lib"
+          "${CUDA_PREFIX}/bin/nvcc" --version
 
       - name: Install nv-codec-headers
         shell: bash
@@ -607,7 +623,7 @@ jobs:
           if ! pkg-config --exists ffnvcodec; then
             git clone --depth=1 https://github.com/FFmpeg/nv-codec-headers.git /tmp/nv-codec-headers
             make -C /tmp/nv-codec-headers -j"$(nproc)"
-            make -C /tmp/nv-codec-headers install PREFIX=/usr/local
+            sudo make -C /tmp/nv-codec-headers install PREFIX=/usr/local
           fi
 
       - name: Configure and build
-- 
2.53.0

