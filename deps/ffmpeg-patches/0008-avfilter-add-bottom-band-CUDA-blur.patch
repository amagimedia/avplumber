diff --git a/libavfilter/vf_bottom_blur_cuda.c b/libavfilter/vf_bottom_blur_cuda.c
new file mode 100644
index 0000000..430a2a2
--- /dev/null
+++ b/libavfilter/vf_bottom_blur_cuda.c
@@ -0,0 +1,432 @@
+/*
+ * Bottom-band CUDA blur for subtle scorebug cleanup.
+ *
+ * This file is part of FFmpeg.
+ */
+
+#include <stdint.h>
+
+#include "libavutil/cuda_check.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_cuda_internal.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+#include "avfilter.h"
+#include "avfilter_internal.h"
+#include "formats.h"
+#include "video.h"
+
+#include "cuda/load_helper.h"
+
+#define BLOCK_X 32
+#define BLOCK_Y 8
+#define DIV_UP(a, b) (((a) + (b) - 1) / (b))
+#define CHECK_CU(x) FF_CUDA_CHECK_DL(ctx, ctx->hwctx->internal->cuda_dl, x)
+
+typedef struct BottomBlurCUDAContext {
+    const AVClass *class;
+
+    AVCUDADeviceContext *hwctx;
+    AVBufferRef *hw_device_ctx;
+    CUcontext cu_ctx;
+    CUmodule cu_module;
+    CUstream cu_stream;
+
+    CUfunction downsample_y;
+    CUfunction downsample_uv;
+    CUfunction blur_horizontal_y;
+    CUfunction blur_horizontal_uv;
+    CUfunction blur_vertical;
+    CUfunction composite_y;
+    CUfunction composite_uv;
+
+    CUdeviceptr scratch_y_a;
+    CUdeviceptr scratch_y_b;
+    CUdeviceptr scratch_uv_a;
+    CUdeviceptr scratch_uv_b;
+
+    float start;
+    float full;
+    float bottom_luma;
+    int radius;
+
+    int width;
+    int height;
+    int start_y;
+    int full_y;
+    int down_width;
+    int down_height;
+    int down_uv_height;
+} BottomBlurCUDAContext;
+
+static int copy_plane(BottomBlurCUDAContext *ctx,
+                      uint8_t *dst, int dst_pitch,
+                      const uint8_t *src, int src_pitch,
+                      int width, int height)
+{
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    CUDA_MEMCPY2D copy = { 0 };
+
+    copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+    copy.srcDevice = (CUdeviceptr)(uintptr_t)src;
+    copy.srcPitch = src_pitch;
+    copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+    copy.dstDevice = (CUdeviceptr)(uintptr_t)dst;
+    copy.dstPitch = dst_pitch;
+    copy.WidthInBytes = width;
+    copy.Height = height;
+    return CHECK_CU(cu->cuMemcpy2DAsync(&copy, ctx->cu_stream));
+}
+
+static int launch(BottomBlurCUDAContext *ctx, CUfunction function,
+                  int width, int height, void **args)
+{
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+
+    return CHECK_CU(cu->cuLaunchKernel(
+        function,
+        DIV_UP(width, BLOCK_X), DIV_UP(height, BLOCK_Y), 1,
+        BLOCK_X, BLOCK_Y, 1,
+        0, ctx->cu_stream, args, NULL));
+}
+
+static int bottom_blur_cuda_filter_frame(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *avctx = inlink->dst;
+    BottomBlurCUDAContext *ctx = avctx->priv;
+    AVFilterLink *outlink = avctx->outputs[0];
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    AVFrame *out = NULL;
+    CUcontext dummy;
+    int context_pushed = 0;
+    int ret;
+
+    out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!out) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ret = av_frame_copy_props(out, in);
+    if (ret < 0)
+        goto fail;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->cu_ctx));
+    if (ret < 0)
+        goto fail;
+    context_pushed = 1;
+
+    ret = copy_plane(ctx, out->data[0], out->linesize[0],
+                     in->data[0], in->linesize[0], ctx->width, ctx->height);
+    if (ret < 0)
+        goto pop;
+    ret = copy_plane(ctx, out->data[1], out->linesize[1],
+                     in->data[1], in->linesize[1], ctx->width, ctx->height / 2);
+    if (ret < 0)
+        goto pop;
+
+    {
+        CUdeviceptr src = (CUdeviceptr)(uintptr_t)in->data[0];
+        int src_pitch = in->linesize[0];
+        void *args[] = {
+            &src, &src_pitch, &ctx->width, &ctx->height, &ctx->start_y,
+            &ctx->scratch_y_a, &ctx->down_width, &ctx->down_height,
+        };
+        ret = launch(ctx, ctx->downsample_y,
+                     ctx->down_width, ctx->down_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        CUdeviceptr src = (CUdeviceptr)(uintptr_t)in->data[1];
+        int src_pitch = in->linesize[1];
+        void *args[] = {
+            &src, &src_pitch, &ctx->width, &ctx->height, &ctx->start_y,
+            &ctx->scratch_uv_a, &ctx->down_width, &ctx->down_uv_height,
+        };
+        ret = launch(ctx, ctx->downsample_uv,
+                     ctx->down_width / 2, ctx->down_uv_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        void *args[] = {
+            &ctx->scratch_y_a, &ctx->scratch_y_b,
+            &ctx->down_width, &ctx->down_height, &ctx->radius,
+        };
+        ret = launch(ctx, ctx->blur_horizontal_y,
+                     ctx->down_width, ctx->down_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        void *args[] = {
+            &ctx->scratch_uv_a, &ctx->scratch_uv_b,
+            &ctx->down_width, &ctx->down_uv_height, &ctx->radius,
+        };
+        ret = launch(ctx, ctx->blur_horizontal_uv,
+                     ctx->down_width / 2, ctx->down_uv_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        void *args[] = {
+            &ctx->scratch_y_b, &ctx->scratch_y_a,
+            &ctx->down_width, &ctx->down_height, &ctx->radius,
+        };
+        ret = launch(ctx, ctx->blur_vertical,
+                     ctx->down_width, ctx->down_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        void *args[] = {
+            &ctx->scratch_uv_b, &ctx->scratch_uv_a,
+            &ctx->down_width, &ctx->down_uv_height, &ctx->radius,
+        };
+        ret = launch(ctx, ctx->blur_vertical,
+                     ctx->down_width, ctx->down_uv_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        CUdeviceptr src = (CUdeviceptr)(uintptr_t)in->data[0];
+        CUdeviceptr dst = (CUdeviceptr)(uintptr_t)out->data[0];
+        int src_pitch = in->linesize[0];
+        int dst_pitch = out->linesize[0];
+        void *args[] = {
+            &src, &src_pitch, &dst, &dst_pitch,
+            &ctx->scratch_y_a, &ctx->down_width, &ctx->down_height,
+            &ctx->width, &ctx->height, &ctx->start_y, &ctx->full_y,
+            &ctx->bottom_luma,
+        };
+        ret = launch(ctx, ctx->composite_y,
+                     ctx->width, ctx->height - ctx->start_y, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        CUdeviceptr src = (CUdeviceptr)(uintptr_t)in->data[1];
+        CUdeviceptr dst = (CUdeviceptr)(uintptr_t)out->data[1];
+        int src_pitch = in->linesize[1];
+        int dst_pitch = out->linesize[1];
+        void *args[] = {
+            &src, &src_pitch, &dst, &dst_pitch,
+            &ctx->scratch_uv_a, &ctx->down_width, &ctx->down_uv_height,
+            &ctx->width, &ctx->height, &ctx->start_y, &ctx->full_y,
+        };
+        ret = launch(ctx, ctx->composite_uv,
+                     ctx->width / 2, (ctx->height - ctx->start_y) / 2, args);
+    }
+
+pop:
+    {
+        int pop_ret = CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        context_pushed = 0;
+        if (ret >= 0)
+            ret = pop_ret;
+    }
+    if (ret < 0)
+        goto fail;
+
+    av_frame_free(&in);
+    return ff_filter_frame(outlink, out);
+
+fail:
+    if (context_pushed)
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    av_frame_free(&in);
+    av_frame_free(&out);
+    return ret;
+}
+
+static av_cold int get_function(BottomBlurCUDAContext *ctx,
+                                CUfunction *function, const char *name)
+{
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    int ret = CHECK_CU(cu->cuModuleGetFunction(function, ctx->cu_module, name));
+
+    if (ret < 0)
+        av_log(ctx, AV_LOG_FATAL, "CUDA function %s is unavailable\n", name);
+    return ret;
+}
+
+static av_cold int bottom_blur_cuda_config_output(AVFilterLink *outlink)
+{
+    extern const unsigned char ff_vf_bottom_blur_cuda_ptx_data[];
+    extern const unsigned int ff_vf_bottom_blur_cuda_ptx_len;
+
+    AVFilterContext *avctx = outlink->src;
+    BottomBlurCUDAContext *ctx = avctx->priv;
+    AVFilterLink *inlink = avctx->inputs[0];
+    FilterLink *inl = ff_filter_link(inlink);
+    FilterLink *outl = ff_filter_link(outlink);
+    AVHWFramesContext *frames_ctx;
+    CudaFunctions *cu;
+    CUcontext dummy;
+    int context_pushed = 0;
+    int ret;
+
+    if (!inl->hw_frames_ctx) {
+        av_log(ctx, AV_LOG_ERROR, "No CUDA hardware frame context on input\n");
+        return AVERROR(EINVAL);
+    }
+    frames_ctx = (AVHWFramesContext *)inl->hw_frames_ctx->data;
+    if (frames_ctx->sw_format != AV_PIX_FMT_NV12) {
+        av_log(ctx, AV_LOG_ERROR, "bottom_blur_cuda requires NV12, got %s\n",
+               av_get_pix_fmt_name(frames_ctx->sw_format));
+        return AVERROR(ENOSYS);
+    }
+    if ((inlink->w & 1) || (inlink->h & 1) || inlink->w < 8 || inlink->h < 8) {
+        av_log(ctx, AV_LOG_ERROR, "bottom_blur_cuda requires even dimensions\n");
+        return AVERROR(EINVAL);
+    }
+    if (ctx->full <= ctx->start) {
+        av_log(ctx, AV_LOG_ERROR, "full must be greater than start\n");
+        return AVERROR(EINVAL);
+    }
+
+    ctx->width = inlink->w;
+    ctx->height = inlink->h;
+    ctx->start_y = ((int)(ctx->start * ctx->height)) & ~1;
+    ctx->full_y = FFMIN(ctx->height,
+                        FFMAX(ctx->start_y + 2, (int)(ctx->full * ctx->height)));
+    ctx->down_width = ctx->width / 2;
+    ctx->down_height = (ctx->height - ctx->start_y) / 2;
+    ctx->down_uv_height = ctx->down_height / 2;
+    if (ctx->down_uv_height < 1)
+        return AVERROR(EINVAL);
+
+    ctx->hw_device_ctx = av_buffer_ref(frames_ctx->device_ref);
+    if (!ctx->hw_device_ctx)
+        return AVERROR(ENOMEM);
+    ctx->hwctx = ((AVHWDeviceContext *)ctx->hw_device_ctx->data)->hwctx;
+    ctx->cu_ctx = ctx->hwctx->cuda_ctx;
+    ctx->cu_stream = ctx->hwctx->stream;
+    cu = ctx->hwctx->internal->cuda_dl;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->cu_ctx));
+    if (ret < 0)
+        return ret;
+    context_pushed = 1;
+
+    ret = ff_cuda_load_module(ctx, ctx->hwctx, &ctx->cu_module,
+                              ff_vf_bottom_blur_cuda_ptx_data,
+                              ff_vf_bottom_blur_cuda_ptx_len);
+    if (ret < 0)
+        goto done;
+    if ((ret = get_function(ctx, &ctx->downsample_y, "BottomBlurDownsampleY")) < 0 ||
+        (ret = get_function(ctx, &ctx->downsample_uv, "BottomBlurDownsampleUV")) < 0 ||
+        (ret = get_function(ctx, &ctx->blur_horizontal_y, "BottomBlurHorizontalY")) < 0 ||
+        (ret = get_function(ctx, &ctx->blur_horizontal_uv, "BottomBlurHorizontalUV")) < 0 ||
+        (ret = get_function(ctx, &ctx->blur_vertical, "BottomBlurVertical")) < 0 ||
+        (ret = get_function(ctx, &ctx->composite_y, "BottomBlurCompositeY")) < 0 ||
+        (ret = get_function(ctx, &ctx->composite_uv, "BottomBlurCompositeUV")) < 0)
+        goto done;
+
+    ret = CHECK_CU(cu->cuMemAlloc(&ctx->scratch_y_a,
+                                  ctx->down_width * ctx->down_height));
+    if (ret < 0)
+        goto done;
+    ret = CHECK_CU(cu->cuMemAlloc(&ctx->scratch_y_b,
+                                  ctx->down_width * ctx->down_height));
+    if (ret < 0)
+        goto done;
+    ret = CHECK_CU(cu->cuMemAlloc(&ctx->scratch_uv_a,
+                                  ctx->down_width * ctx->down_uv_height));
+    if (ret < 0)
+        goto done;
+    ret = CHECK_CU(cu->cuMemAlloc(&ctx->scratch_uv_b,
+                                  ctx->down_width * ctx->down_uv_height));
+
+done:
+    if (context_pushed) {
+        int pop_ret = CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        if (ret >= 0)
+            ret = pop_ret;
+    }
+    if (ret < 0)
+        return ret;
+
+    outlink->w = inlink->w;
+    outlink->h = inlink->h;
+    outlink->time_base = inlink->time_base;
+    outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+    outl->frame_rate = inl->frame_rate;
+    outl->hw_frames_ctx = av_buffer_ref(inl->hw_frames_ctx);
+    if (!outl->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+    return 0;
+}
+
+static av_cold void bottom_blur_cuda_uninit(AVFilterContext *avctx)
+{
+    BottomBlurCUDAContext *ctx = avctx->priv;
+
+    if (ctx->hwctx) {
+        CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+        CUcontext dummy;
+
+        if (CHECK_CU(cu->cuCtxPushCurrent(ctx->cu_ctx)) >= 0) {
+            if (ctx->scratch_y_a)
+                CHECK_CU(cu->cuMemFree(ctx->scratch_y_a));
+            if (ctx->scratch_y_b)
+                CHECK_CU(cu->cuMemFree(ctx->scratch_y_b));
+            if (ctx->scratch_uv_a)
+                CHECK_CU(cu->cuMemFree(ctx->scratch_uv_a));
+            if (ctx->scratch_uv_b)
+                CHECK_CU(cu->cuMemFree(ctx->scratch_uv_b));
+            if (ctx->cu_module)
+                CHECK_CU(cu->cuModuleUnload(ctx->cu_module));
+            CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        }
+    }
+    av_buffer_unref(&ctx->hw_device_ctx);
+    ctx->hwctx = NULL;
+}
+
+#define OFFSET(x) offsetof(BottomBlurCUDAContext, x)
+#define FLAGS (AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_VIDEO_PARAM)
+
+static const AVOption bottom_blur_cuda_options[] = {
+    { "start", "normalized height where feather begins", OFFSET(start),
+        AV_OPT_TYPE_FLOAT, { .dbl = 0.70 }, 0.0, 0.95, FLAGS },
+    { "full", "normalized height where blur reaches full strength", OFFSET(full),
+        AV_OPT_TYPE_FLOAT, { .dbl = 1.0 }, 0.05, 1.0, FLAGS },
+    { "radius", "half-resolution box blur radius", OFFSET(radius),
+        AV_OPT_TYPE_INT, { .i64 = 6 }, 1, 12, FLAGS },
+    { "bottom_luma", "luma multiplier at full strength", OFFSET(bottom_luma),
+        AV_OPT_TYPE_FLOAT, { .dbl = 0.86 }, 0.5, 1.0, FLAGS },
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(bottom_blur_cuda);
+
+static const AVFilterPad bottom_blur_cuda_inputs[] = {
+    {
+        .name = "default",
+        .type = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = bottom_blur_cuda_filter_frame,
+    },
+};
+
+static const AVFilterPad bottom_blur_cuda_outputs[] = {
+    {
+        .name = "default",
+        .type = AVMEDIA_TYPE_VIDEO,
+        .config_props = bottom_blur_cuda_config_output,
+    },
+};
+
+const AVFilter ff_vf_bottom_blur_cuda = {
+    .name = "bottom_blur_cuda",
+    .description = NULL_IF_CONFIG_SMALL(
+        "Feathered bottom-band CUDA blur and luma reduction"),
+    .priv_size = sizeof(BottomBlurCUDAContext),
+    .priv_class = &bottom_blur_cuda_class,
+    .uninit = bottom_blur_cuda_uninit,
+    FILTER_INPUTS(bottom_blur_cuda_inputs),
+    FILTER_OUTPUTS(bottom_blur_cuda_outputs),
+    FILTER_SINGLE_PIXFMT(AV_PIX_FMT_CUDA),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+};
diff --git a/libavfilter/vf_bottom_blur_cuda.cu b/libavfilter/vf_bottom_blur_cuda.cu
new file mode 100644
index 0000000..dde8ebb
--- /dev/null
+++ b/libavfilter/vf_bottom_blur_cuda.cu
@@ -0,0 +1,208 @@
+/*
+ * Bottom-band CUDA blur for subtle scorebug cleanup.
+ *
+ * This file is part of FFmpeg.
+ */
+
+#include "cuda/vector_helpers.cuh"
+
+static __device__ __forceinline__ int clamp_int(int value, int low, int high)
+{
+    return max(low, min(value, high));
+}
+
+static __device__ __forceinline__ unsigned char rounded_byte(float value)
+{
+    return (unsigned char)clamp_int((int)(value + 0.5f), 0, 255);
+}
+
+static __device__ __forceinline__ float smooth_strength(int y, int start_y,
+                                                         int full_y)
+{
+    float value = (float)(y - start_y) / (float)max(1, full_y - start_y);
+    value = fminf(1.0f, fmaxf(0.0f, value));
+    return value * value * (3.0f - 2.0f * value);
+}
+
+static __device__ float sample_byte(const unsigned char *source,
+                                    int width, int height,
+                                    float x, float y, int step, int component)
+{
+    const int sample_width = width / step;
+    const float bounded_x = fminf((float)(sample_width - 1), fmaxf(0.0f, x));
+    const float bounded_y = fminf((float)(height - 1), fmaxf(0.0f, y));
+    const int x0 = (int)bounded_x;
+    const int y0 = (int)bounded_y;
+    const int x1 = min(x0 + 1, sample_width - 1);
+    const int y1 = min(y0 + 1, height - 1);
+    const float fx = bounded_x - x0;
+    const float fy = bounded_y - y0;
+    const float top = source[y0 * width + x0 * step + component] * (1.0f - fx) +
+                      source[y0 * width + x1 * step + component] * fx;
+    const float bottom = source[y1 * width + x0 * step + component] * (1.0f - fx) +
+                         source[y1 * width + x1 * step + component] * fx;
+    return top * (1.0f - fy) + bottom * fy;
+}
