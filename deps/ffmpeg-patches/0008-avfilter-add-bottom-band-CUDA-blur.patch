+__global__ void BottomBlurDownsampleY(
+    const unsigned char *source, int source_pitch, int source_width,
+    int source_height, int start_y, unsigned char *destination,
+    int destination_width, int destination_height)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= destination_width || y >= destination_height)
+        return;
+
+    const int sx0 = min(source_width - 1, x * 2);
+    const int sx1 = min(source_width - 1, sx0 + 1);
+    const int sy0 = min(source_height - 1, start_y + y * 2);
+    const int sy1 = min(source_height - 1, sy0 + 1);
+    const int sum = source[sy0 * source_pitch + sx0] +
+                    source[sy0 * source_pitch + sx1] +
+                    source[sy1 * source_pitch + sx0] +
+                    source[sy1 * source_pitch + sx1];
+    destination[y * destination_width + x] = (unsigned char)((sum + 2) / 4);
+}
+
+__global__ void BottomBlurDownsampleUV(
+    const unsigned char *source, int source_pitch, int source_width,
+    int source_height, int start_y, unsigned char *destination,
+    int destination_width, int destination_height)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int y = blockIdx.y * blockDim.y + threadIdx.y;
+    const int destination_pairs = destination_width / 2;
+    if (x >= destination_pairs || y >= destination_height)
+        return;
+
+    const int source_pairs = source_width / 2;
+    const int source_uv_height = source_height / 2;
+    const int sx0 = min(source_pairs - 1, x * 2);
+    const int sx1 = min(source_pairs - 1, sx0 + 1);
+    const int sy0 = min(source_uv_height - 1, start_y / 2 + y * 2);
+    const int sy1 = min(source_uv_height - 1, sy0 + 1);
+    int sum_u = 0;
+    int sum_v = 0;
+    const int xs[2] = { sx0, sx1 };
+    const int ys[2] = { sy0, sy1 };
+    for (int row = 0; row < 2; row++) {
+        for (int column = 0; column < 2; column++) {
+            const int offset = ys[row] * source_pitch + xs[column] * 2;
+            sum_u += source[offset];
+            sum_v += source[offset + 1];
+        }
+    }
+    const int destination_offset = y * destination_width + x * 2;
+    destination[destination_offset] = (unsigned char)((sum_u + 2) / 4);
+    destination[destination_offset + 1] = (unsigned char)((sum_v + 2) / 4);
+}
+
+__global__ void BottomBlurHorizontalY(
+    const unsigned char *source, unsigned char *destination,
+    int width, int height, int radius)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= width || y >= height)
+        return;
+
+    int sum = 0;
+    for (int offset = -radius; offset <= radius; offset++)
+        sum += source[y * width + clamp_int(x + offset, 0, width - 1)];
+    destination[y * width + x] =
+        (unsigned char)((sum + radius) / (radius * 2 + 1));
+}
+
+__global__ void BottomBlurHorizontalUV(
+    const unsigned char *source, unsigned char *destination,
+    int width, int height, int radius)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int y = blockIdx.y * blockDim.y + threadIdx.y;
+    const int pairs = width / 2;
+    if (x >= pairs || y >= height)
+        return;
+
+    int sum_u = 0;
+    int sum_v = 0;
+    for (int offset = -radius; offset <= radius; offset++) {
+        const int source_offset =
+            y * width + clamp_int(x + offset, 0, pairs - 1) * 2;
+        sum_u += source[source_offset];
+        sum_v += source[source_offset + 1];
+    }
+    const int count = radius * 2 + 1;
+    const int destination_offset = y * width + x * 2;
+    destination[destination_offset] = (unsigned char)((sum_u + radius) / count);
+    destination[destination_offset + 1] =
+        (unsigned char)((sum_v + radius) / count);
+}
+
+__global__ void BottomBlurVertical(
+    const unsigned char *source, unsigned char *destination,
+    int width, int height, int radius)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= width || y >= height)
+        return;
+
+    int sum = 0;
+    for (int offset = -radius; offset <= radius; offset++)
+        sum += source[clamp_int(y + offset, 0, height - 1) * width + x];
+    destination[y * width + x] =
+        (unsigned char)((sum + radius) / (radius * 2 + 1));
+}
+
+__global__ void BottomBlurCompositeY(
+    const unsigned char *source, int source_pitch,
+    unsigned char *destination, int destination_pitch,
+    const unsigned char *blurred, int blurred_width, int blurred_height,
+    int width, int height, int start_y, int full_y, float bottom_luma)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int band_y = blockIdx.y * blockDim.y + threadIdx.y;
+    const int y = start_y + band_y;
+    if (x >= width || y >= height)
+        return;
+
+    const float strength = smooth_strength(y, start_y, full_y);
+    const float blur = sample_byte(blurred, blurred_width, blurred_height,
+                                   x * 0.5f, band_y * 0.5f, 1, 0);
+    const float sharp = source[y * source_pitch + x];
+    const float mixed = sharp + (blur - sharp) * strength;
+    const float luma = 1.0f + (bottom_luma - 1.0f) * strength;
+    destination[y * destination_pitch + x] = rounded_byte(mixed * luma);
+}
+
+__global__ void BottomBlurCompositeUV(
+    const unsigned char *source, int source_pitch,
+    unsigned char *destination, int destination_pitch,
+    const unsigned char *blurred, int blurred_width, int blurred_height,
+    int width, int height, int start_y, int full_y)
+{
+    const int x = blockIdx.x * blockDim.x + threadIdx.x;
+    const int band_y = blockIdx.y * blockDim.y + threadIdx.y;
+    const int pairs = width / 2;
+    const int source_y = start_y / 2 + band_y;
+    if (x >= pairs || source_y >= height / 2)
+        return;
+
+    const float strength = smooth_strength(start_y + band_y * 2,
+                                            start_y, full_y);
+    const int source_offset = source_y * source_pitch + x * 2;
+    const int destination_offset = source_y * destination_pitch + x * 2;
+    for (int component = 0; component < 2; component++) {
+        const float blur = sample_byte(
+            blurred, blurred_width, blurred_height,
+            x * 0.5f, band_y * 0.5f, 2, component);
+        const float sharp = source[source_offset + component];
+        destination[destination_offset + component] =
+            rounded_byte(sharp + (blur - sharp) * strength);
+    }
+}
