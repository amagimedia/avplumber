From 264c6230aba1fe6b0127b69ce8bfc1820c996059 Mon Sep 17 00:00:00 2001
From: Jan Pietek <jan.pietek@gmail.com>
Date: Wed, 18 Mar 2026 09:33:41 +0100
Subject: [PATCH 19/40] again - keep cuda disabled

---
 .github/workflows/ubuntu-25.04-deb.yml | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/ubuntu-25.04-deb.yml b/.github/workflows/ubuntu-25.04-deb.yml
index 867dacadfe..e544ebbc93 100644
--- a/.github/workflows/ubuntu-25.04-deb.yml
+++ b/.github/workflows/ubuntu-25.04-deb.yml
@@ -18,8 +18,13 @@ on:
         required: true
         default: false
         type: boolean
-      extra_configure_flags:
-        description: Additional flags appended to both ./configure commands
+      regular_extra_configure_flags:
+        description: Additional flags appended to the regular non-NVIDIA configure command
+        required: false
+        default: ""
+        type: string
+      nvidia_extra_configure_flags:
+        description: Additional flags appended to the NVIDIA/CUDA configure command
         required: false
         default: ""
         type: string
@@ -67,6 +72,12 @@ jobs:
         shell: bash
         run: |
           set -euxo pipefail
+          case " ${{ inputs.regular_extra_configure_flags }} " in
+            *"cuda"*|*"nvcc"*|*"ffnvcodec"*|*"cuvid"*|*"nvdec"*|*"nvenc"*|*"npp"*)
+              echo "regular_extra_configure_flags must not include NVIDIA/CUDA-related options" >&2
+              exit 1
+              ;;
+          esac
           export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig"
           ./configure \
             --prefix="${FFMPEG_PREFIX}" \
@@ -164,7 +175,7 @@ jobs:
             --enable-parser=mp3 \
             --enable-parser=mp2 \
             --enable-parser=opus \
-            ${{ inputs.extra_configure_flags }}
+            ${{ inputs.regular_extra_configure_flags }}
           make -j"$(nproc)"
 
       - name: Stage package contents
@@ -400,7 +411,7 @@ jobs:
             --enable-parser=mp2 \
             --enable-parser=opus \
             --nvcc="${CUDA_PREFIX}/bin/nvcc" \
-            ${{ inputs.extra_configure_flags }}
+            ${{ inputs.nvidia_extra_configure_flags }}
           make -j"$(nproc)"
 
       - name: Stage package contents
-- 
2.53.0

