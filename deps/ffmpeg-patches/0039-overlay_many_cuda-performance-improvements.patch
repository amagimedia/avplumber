+static void write_420_to_420_chroma_function(FILE *file, int input_count)
+{
+    int ov_count = input_count - 1;
+
+    fprintf(file, R"RAW_STR(
+
+__global__ void AlignedOverlay420to420Chroma__%d(
+    unsigned char *main_dst, int main_dst_pitch,
+    const unsigned char * __restrict__ main_src, int main_src_pitch,)RAW_STR",
+            input_count);
+
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        char comma_or_paren = (ov_index+1 == ov_count ? ')' : ',');
+
+        fprintf(file, R"RAW_STR(
+    const unsigned char * __restrict__ ov%d, int ov%d_pitch,
+    const unsigned char * __restrict__ ov%dalpha, int ov%dalpha_pitch%c)RAW_STR",
+                ov_index, ov_index, ov_index, ov_index, comma_or_paren);
+    }
+
+    fprintf(file, R"RAW_STR(
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    int x2 = x * 2;
+    int y2 = y * 2;
+
+)RAW_STR");
+
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        fprintf(file,
+            "    unsigned int ov%d_alpha = (ov%dalpha[y2 * ov%dalpha_pitch + x2] +\n"
+            "        ov%dalpha[y2 * ov%dalpha_pitch + x2 + 1] +\n"
+            "        ov%dalpha[(y2 + 1) * ov%dalpha_pitch + x2] +\n"
+            "        ov%dalpha[(y2 + 1) * ov%dalpha_pitch + x2 + 1] + 2u) >> 2;\n",
+            ov_index,
+            ov_index, ov_index,
+            ov_index, ov_index,
+            ov_index, ov_index,
+            ov_index, ov_index);
+    }
+
+    fprintf(file, "\n    unsigned int m = main_src[x + y*main_src_pitch];\n");
+
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        fprintf(file, "    m = (ov%d_alpha * (unsigned int)ov%d[x + y*ov%d_pitch] + (255u - ov%d_alpha) * m + 127u) >> 8;\n",
+                ov_index, ov_index, ov_index, ov_index);
+    }
+
+    fprintf(file, "    main_dst[x + y*main_dst_pitch] = (unsigned char)m;\n}\n");
+}
+
+static void write_combined_420_420_function(FILE *file, int input_count)
+{
+    int ov_count = input_count - 1;
+
+    fprintf(file, "\n\n__global__ void AlignedOverlayCombined420__%d(\n"
+            "    unsigned char *y_dst, int y_dst_pitch,\n"
+            "    const unsigned char * __restrict__ y_src, int y_src_pitch,\n"
+            "    unsigned char *u_dst, int u_dst_pitch,\n"
+            "    const unsigned char * __restrict__ u_src, int u_src_pitch,\n"
+            "    unsigned char *v_dst, int v_dst_pitch,\n"
+            "    const unsigned char * __restrict__ v_src, int v_src_pitch",
+            input_count);
+
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        int is_last = (ov_index+1 == ov_count);
+        fprintf(file,
+                ",\n"
+                "    const unsigned char * __restrict__ ov%d_y, int ov%d_y_pitch,\n"
+                "    const unsigned char * __restrict__ ov%d_u, int ov%d_u_pitch,\n"
+                "    const unsigned char * __restrict__ ov%d_v, int ov%d_v_pitch,\n"
+                "    const unsigned char * __restrict__ ov%d_alpha, int ov%d_alpha_pitch%s",
+                ov_index, ov_index, ov_index, ov_index,
+                ov_index, ov_index, ov_index, ov_index,
+                is_last ? ")" : "");
+    }
+
+    fprintf(file, "\n{\n"
+            "    int x = blockIdx.x * blockDim.x + threadIdx.x;\n"
+            "    int y = blockIdx.y * blockDim.y + threadIdx.y;\n\n");
+
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        fprintf(file, "    unsigned int y_alpha%d = ov%d_alpha[x + y * ov%d_alpha_pitch];\n",
+                ov_index, ov_index, ov_index);
+    }
+
+    fprintf(file, "\n    unsigned int my = y_src[x + y * y_src_pitch];\n");
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        fprintf(file, "    my = (y_alpha%d * (unsigned int)ov%d_y[x + y*ov%d_y_pitch] + (255u - y_alpha%d) * my + 127u) >> 8;\n",
+                ov_index, ov_index, ov_index, ov_index);
+    }
+    fprintf(file, "    y_dst[x + y*y_dst_pitch] = (unsigned char)my;\n\n");
+
+    fprintf(file, "    if ((x & 1) == 0 && (y & 1) == 0) {\n"
+            "        int cx = x >> 1;\n"
+            "        int cy = y >> 1;\n\n");
+
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        fprintf(file,
+                "        unsigned int uv_alpha%d = (ov%d_alpha[y * ov%d_alpha_pitch + x] +\n"
+                "            ov%d_alpha[y * ov%d_alpha_pitch + x + 1] +\n"
+                "            ov%d_alpha[(y + 1) * ov%d_alpha_pitch + x] +\n"
+                "            ov%d_alpha[(y + 1) * ov%d_alpha_pitch + x + 1] + 2u) >> 2;\n",
+                ov_index, ov_index, ov_index,
+                ov_index, ov_index,
+                ov_index, ov_index,
+                ov_index, ov_index);
+    }
+
+    fprintf(file, "\n        unsigned int mu = u_src[cx + cy * u_src_pitch];\n");
+    for (int ov_index = 0; ov_index < ov_count; ov_index++)
+    {
+        fprintf(file, "        mu = (uv_alpha%d * (unsigned int)ov%d_u[cx + cy*ov%d_u_pitch] + (255u - uv_alpha%d) * mu + 127u) >> 8;\n",
+                ov_index, ov_index, ov_index, ov_index);
+    }
+    fprintf(file, "        u_dst[cx + cy*u_dst_pitch] = (unsigned char)mu;\n\n");
+
+    fprintf(file, "        unsigned int mv = v_src[cx + cy * v_src_pitch];\n");
