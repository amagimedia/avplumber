     ctx->cu_ctx = cuda_ctx;
 
@@ -135,59 +140,99 @@ static int overlay_many_cuda_blend(FFFrameSync *fs)
     if (avctx->is_disabled)
         return ff_filter_frame(outlink, input_frames[0]);
 
