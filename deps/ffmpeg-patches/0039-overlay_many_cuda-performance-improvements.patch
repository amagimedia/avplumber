+                header_arg_count = 4;
+            } else {
+                kernel_args[4] = &alpha_adjust_x;
+                kernel_args[5] = &alpha_adjust_y;
+                header_arg_count = 6;
+            }
 
+            for (int input_index = 1; input_index < ctx->nb_inputs; input_index++) {
+                int start_index = (input_index-1)*4 + header_arg_count;
+                kernel_args[start_index + 0] = &input_frames[input_index]->data[plane_index];
+                kernel_args[start_index + 1] = &input_frames[input_index]->linesize[plane_index];
+                kernel_args[start_index + 2] = &input_frames[input_index]->data[3];
+                kernel_args[start_index + 3] = &input_frames[input_index]->linesize[3];
+            }
+
+            CHECK_CU(cu->cuLaunchKernel(cu_func, grid_dim_x, grid_dim_y, 1,
+                     BLOCK_X, BLOCK_Y, 1,
+                     0, ctx->cu_stream, kernel_args, NULL));
+        }
+    }
 
     CHECK_CU(cu->cuCtxPopCurrent(&dummy));
-    return ff_filter_frame(outlink, input_frames[0]);
+    av_frame_free(&input_frames[0]);
+    return ff_filter_frame(outlink, output);
 }
 
