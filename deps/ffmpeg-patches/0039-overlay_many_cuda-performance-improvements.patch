+                return err;
+            }
+
+            snprintf(buf, sizeof(buf), "AlignedOverlayCombined420__%d", ctx->nb_inputs);
+            err = CHECK_CU(cu->cuModuleGetFunction(&ctx->cu_func_combined, ctx->cu_module, buf));
+            if (err < 0) {
+                av_log(ctx, AV_LOG_FATAL, "CUDA function %s wasn't implemented\n", buf);
+                CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+                return err;
+            }
+        }
+
+        if (ctx->format_main == AV_PIX_FMT_YUV444P &&
+            ctx->format_overlay == AV_PIX_FMT_YUVA444P)
+        {
+            snprintf(buf, sizeof(buf), "AlignedOverlayCombined444__%d", ctx->nb_inputs);
+            err = CHECK_CU(cu->cuModuleGetFunction(&ctx->cu_func_combined, ctx->cu_module, buf));
+            if (err < 0) {
+                av_log(ctx, AV_LOG_FATAL, "CUDA function %s wasn't implemented\n", buf);
+                CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+                return err;
+            }
+        }
+
         CHECK_CU(cu->cuCtxPopCurrent(&dummy));
     }
 
