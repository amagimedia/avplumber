-
-        kernel_args[0] = &input_frames[0]->data[plane_index];
-        kernel_args[1] = &input_frames[0]->linesize[plane_index];
-        
-        if (plane_index > 0 && ctx->cu_func_420and444) {
-            cu_func = ctx->cu_func_420and444;
-            header_arg_count = 2;
-        } else {
-            kernel_args[2] = &alpha_adjust_x;
-            kernel_args[3] = &alpha_adjust_y;
+    if (ctx->cu_func_combined) {
+        // Single launch: combined Y+U+V kernel (YUV420P+YUVA420P or YUV444P+YUVA444P)
