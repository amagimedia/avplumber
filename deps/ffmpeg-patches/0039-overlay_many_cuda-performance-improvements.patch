+            kernel_args[base + 4] = &input_frames[input_index]->data[2];
+            kernel_args[base + 5] = &input_frames[input_index]->linesize[2];
+            kernel_args[base + 6] = &input_frames[input_index]->data[3];
+            kernel_args[base + 7] = &input_frames[input_index]->linesize[3];
         }
-
-        CHECK_CU(cu->cuLaunchKernel(cu_func, grid_dim_x, grid_dim_y, 1,
