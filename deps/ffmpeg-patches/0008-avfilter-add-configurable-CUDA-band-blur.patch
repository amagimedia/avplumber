diff --git a/libavfilter/vf_band_blur_cuda.c b/libavfilter/vf_band_blur_cuda.c
new file mode 100644
index 0000000..c55ec99
--- /dev/null
+++ b/libavfilter/vf_band_blur_cuda.c
@@ -0,0 +1,456 @@
+/*
+ * Configurable vertical-band CUDA blur and luma gradient.
+ *
+ * This file is part of FFmpeg.
+ */
+
+#include <stdint.h>
+
+#include "libavutil/cuda_check.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_cuda_internal.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+#include "avfilter.h"
+#include "avfilter_internal.h"
+#include "formats.h"
+#include "video.h"
+
+#include "cuda/load_helper.h"
+
+#define BLOCK_X 32
+#define BLOCK_Y 8
+#define DIV_UP(a, b) (((a) + (b) - 1) / (b))
+#define CHECK_CU(x) FF_CUDA_CHECK_DL(ctx, ctx->hwctx->internal->cuda_dl, x)
+
+typedef struct BandBlurCUDAContext {
+    const AVClass *class;
+
+    AVCUDADeviceContext *hwctx;
+    AVBufferRef *hw_device_ctx;
+    CUcontext cu_ctx;
+    CUmodule cu_module;
+    CUstream cu_stream;
+
+    CUfunction downsample_y;
+    CUfunction downsample_uv;
+    CUfunction blur_horizontal_y;
+    CUfunction blur_horizontal_uv;
+    CUfunction blur_vertical;
+    CUfunction composite_y;
+    CUfunction composite_uv;
+
+    CUdeviceptr scratch_y_a;
+    CUdeviceptr scratch_y_b;
+    CUdeviceptr scratch_uv_a;
+    CUdeviceptr scratch_uv_b;
+
+    float y_start;
+    float y_end;
+    float blur_start;
+    float blur_end;
+    float luma_start;
+    float luma_end;
+    float gradient_power;
+    int radius;
+    int gradient;
+
+    int width;
+    int height;
+    int start_y;
+    int end_y;
+    int down_width;
+    int down_height;
+    int down_uv_height;
+} BandBlurCUDAContext;
+
+static int copy_plane(BandBlurCUDAContext *ctx,
+                      uint8_t *dst, int dst_pitch,
+                      const uint8_t *src, int src_pitch,
+                      int width, int height)
+{
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    CUDA_MEMCPY2D copy = { 0 };
+
+    copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+    copy.srcDevice = (CUdeviceptr)(uintptr_t)src;
+    copy.srcPitch = src_pitch;
+    copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+    copy.dstDevice = (CUdeviceptr)(uintptr_t)dst;
+    copy.dstPitch = dst_pitch;
+    copy.WidthInBytes = width;
+    copy.Height = height;
+    return CHECK_CU(cu->cuMemcpy2DAsync(&copy, ctx->cu_stream));
+}
+
+static int launch(BandBlurCUDAContext *ctx, CUfunction function,
+                  int width, int height, void **args)
+{
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+
+    return CHECK_CU(cu->cuLaunchKernel(
+        function,
+        DIV_UP(width, BLOCK_X), DIV_UP(height, BLOCK_Y), 1,
+        BLOCK_X, BLOCK_Y, 1,
+        0, ctx->cu_stream, args, NULL));
+}
+
+static int band_blur_cuda_filter_frame(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *avctx = inlink->dst;
+    BandBlurCUDAContext *ctx = avctx->priv;
+    AVFilterLink *outlink = avctx->outputs[0];
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    AVFrame *out = NULL;
+    CUcontext dummy;
+    int context_pushed = 0;
+    int ret;
+
+    out = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!out) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ret = av_frame_copy_props(out, in);
+    if (ret < 0)
+        goto fail;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->cu_ctx));
+    if (ret < 0)
+        goto fail;
+    context_pushed = 1;
+
+    ret = copy_plane(ctx, out->data[0], out->linesize[0],
+                     in->data[0], in->linesize[0], ctx->width, ctx->height);
+    if (ret < 0)
+        goto pop;
+    ret = copy_plane(ctx, out->data[1], out->linesize[1],
+                     in->data[1], in->linesize[1], ctx->width, ctx->height / 2);
+    if (ret < 0)
+        goto pop;
+
+    {
+        CUdeviceptr src = (CUdeviceptr)(uintptr_t)in->data[0];
+        int src_pitch = in->linesize[0];
+        void *args[] = {
+            &src, &src_pitch, &ctx->width, &ctx->height, &ctx->start_y,
+            &ctx->scratch_y_a, &ctx->down_width, &ctx->down_height,
+        };
+        ret = launch(ctx, ctx->downsample_y,
+                     ctx->down_width, ctx->down_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        CUdeviceptr src = (CUdeviceptr)(uintptr_t)in->data[1];
+        int src_pitch = in->linesize[1];
+        void *args[] = {
+            &src, &src_pitch, &ctx->width, &ctx->height, &ctx->start_y,
+            &ctx->scratch_uv_a, &ctx->down_width, &ctx->down_uv_height,
+        };
+        ret = launch(ctx, ctx->downsample_uv,
+                     ctx->down_width / 2, ctx->down_uv_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        void *args[] = {
+            &ctx->scratch_y_a, &ctx->scratch_y_b,
+            &ctx->down_width, &ctx->down_height, &ctx->radius,
+        };
+        ret = launch(ctx, ctx->blur_horizontal_y,
+                     ctx->down_width, ctx->down_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        void *args[] = {
+            &ctx->scratch_uv_a, &ctx->scratch_uv_b,
+            &ctx->down_width, &ctx->down_uv_height, &ctx->radius,
+        };
+        ret = launch(ctx, ctx->blur_horizontal_uv,
+                     ctx->down_width / 2, ctx->down_uv_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        void *args[] = {
+            &ctx->scratch_y_b, &ctx->scratch_y_a,
+            &ctx->down_width, &ctx->down_height, &ctx->radius,
+        };
+        ret = launch(ctx, ctx->blur_vertical,
+                     ctx->down_width, ctx->down_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        void *args[] = {
+            &ctx->scratch_uv_b, &ctx->scratch_uv_a,
+            &ctx->down_width, &ctx->down_uv_height, &ctx->radius,
+        };
+        ret = launch(ctx, ctx->blur_vertical,
+                     ctx->down_width, ctx->down_uv_height, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        CUdeviceptr src = (CUdeviceptr)(uintptr_t)in->data[0];
+        CUdeviceptr dst = (CUdeviceptr)(uintptr_t)out->data[0];
+        int src_pitch = in->linesize[0];
+        int dst_pitch = out->linesize[0];
+        void *args[] = {
+            &src, &src_pitch, &dst, &dst_pitch,
+            &ctx->scratch_y_a, &ctx->down_width, &ctx->down_height,
+            &ctx->width, &ctx->height, &ctx->start_y, &ctx->end_y,
+            &ctx->blur_start, &ctx->blur_end,
+            &ctx->luma_start, &ctx->luma_end,
+            &ctx->gradient, &ctx->gradient_power,
+        };
+        ret = launch(ctx, ctx->composite_y,
+                     ctx->width, ctx->end_y - ctx->start_y, args);
+        if (ret < 0)
+            goto pop;
+    }
+    {
+        CUdeviceptr src = (CUdeviceptr)(uintptr_t)in->data[1];
+        CUdeviceptr dst = (CUdeviceptr)(uintptr_t)out->data[1];
+        int src_pitch = in->linesize[1];
+        int dst_pitch = out->linesize[1];
+        void *args[] = {
+            &src, &src_pitch, &dst, &dst_pitch,
+            &ctx->scratch_uv_a, &ctx->down_width, &ctx->down_uv_height,
+            &ctx->width, &ctx->height, &ctx->start_y, &ctx->end_y,
+            &ctx->blur_start, &ctx->blur_end,
+            &ctx->gradient, &ctx->gradient_power,
+        };
+        ret = launch(ctx, ctx->composite_uv,
+                     ctx->width / 2, (ctx->end_y - ctx->start_y) / 2, args);
+    }
+
+pop:
+    {
+        int pop_ret = CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        context_pushed = 0;
+        if (ret >= 0)
+            ret = pop_ret;
+    }
+    if (ret < 0)
+        goto fail;
+
+    av_frame_free(&in);
+    return ff_filter_frame(outlink, out);
+
+fail:
+    if (context_pushed)
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    av_frame_free(&in);
+    av_frame_free(&out);
+    return ret;
+}
+
+static av_cold int get_function(BandBlurCUDAContext *ctx,
+                                CUfunction *function, const char *name)
+{
+    CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+    int ret = CHECK_CU(cu->cuModuleGetFunction(function, ctx->cu_module, name));
+
+    if (ret < 0)
+        av_log(ctx, AV_LOG_FATAL, "CUDA function %s is unavailable\n", name);
+    return ret;
+}
+
+static av_cold int band_blur_cuda_config_output(AVFilterLink *outlink)
+{
+    extern const unsigned char ff_vf_band_blur_cuda_ptx_data[];
+    extern const unsigned int ff_vf_band_blur_cuda_ptx_len;
+
+    AVFilterContext *avctx = outlink->src;
+    BandBlurCUDAContext *ctx = avctx->priv;
+    AVFilterLink *inlink = avctx->inputs[0];
+    FilterLink *inl = ff_filter_link(inlink);
+    FilterLink *outl = ff_filter_link(outlink);
+    AVHWFramesContext *frames_ctx;
+    CudaFunctions *cu;
+    CUcontext dummy;
+    int context_pushed = 0;
+    int ret;
+
+    if (!inl->hw_frames_ctx) {
+        av_log(ctx, AV_LOG_ERROR, "No CUDA hardware frame context on input\n");
+        return AVERROR(EINVAL);
+    }
+    frames_ctx = (AVHWFramesContext *)inl->hw_frames_ctx->data;
+    if (frames_ctx->sw_format != AV_PIX_FMT_NV12) {
+        av_log(ctx, AV_LOG_ERROR, "band_blur_cuda requires NV12, got %s\n",
+               av_get_pix_fmt_name(frames_ctx->sw_format));
+        return AVERROR(ENOSYS);
+    }
+    if ((inlink->w & 1) || (inlink->h & 1) || inlink->w < 8 || inlink->h < 8) {
+        av_log(ctx, AV_LOG_ERROR, "band_blur_cuda requires even dimensions\n");
+        return AVERROR(EINVAL);
+    }
+    if (ctx->y_end <= ctx->y_start) {
+        av_log(ctx, AV_LOG_ERROR, "y_end must be greater than y_start\n");
+        return AVERROR(EINVAL);
+    }
+
+    ctx->width = inlink->w;
+    ctx->height = inlink->h;
+    ctx->start_y = ((int)(ctx->y_start * ctx->height)) & ~1;
+    ctx->end_y = FFMIN(ctx->height,
+                       FFMAX(ctx->start_y + 2,
+                             ((int)(ctx->y_end * ctx->height)) & ~1));
+    ctx->down_width = ctx->width / 2;
+    ctx->down_height = (ctx->end_y - ctx->start_y + 1) / 2;
+    ctx->down_uv_height = ((ctx->end_y - ctx->start_y) / 2 + 1) / 2;
+    if (ctx->down_uv_height < 1)
+        return AVERROR(EINVAL);
+
+    ctx->hw_device_ctx = av_buffer_ref(frames_ctx->device_ref);
+    if (!ctx->hw_device_ctx)
+        return AVERROR(ENOMEM);
+    ctx->hwctx = ((AVHWDeviceContext *)ctx->hw_device_ctx->data)->hwctx;
+    ctx->cu_ctx = ctx->hwctx->cuda_ctx;
+    ctx->cu_stream = ctx->hwctx->stream;
+    cu = ctx->hwctx->internal->cuda_dl;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(ctx->cu_ctx));
+    if (ret < 0)
+        return ret;
+    context_pushed = 1;
+
+    ret = ff_cuda_load_module(ctx, ctx->hwctx, &ctx->cu_module,
+                              ff_vf_band_blur_cuda_ptx_data,
+                              ff_vf_band_blur_cuda_ptx_len);
+    if (ret < 0)
+        goto done;
+    if ((ret = get_function(ctx, &ctx->downsample_y, "BandBlurDownsampleY")) < 0 ||
+        (ret = get_function(ctx, &ctx->downsample_uv, "BandBlurDownsampleUV")) < 0 ||
+        (ret = get_function(ctx, &ctx->blur_horizontal_y, "BandBlurHorizontalY")) < 0 ||
+        (ret = get_function(ctx, &ctx->blur_horizontal_uv, "BandBlurHorizontalUV")) < 0 ||
+        (ret = get_function(ctx, &ctx->blur_vertical, "BandBlurVertical")) < 0 ||
+        (ret = get_function(ctx, &ctx->composite_y, "BandBlurCompositeY")) < 0 ||
+        (ret = get_function(ctx, &ctx->composite_uv, "BandBlurCompositeUV")) < 0)
+        goto done;
+
+    ret = CHECK_CU(cu->cuMemAlloc(&ctx->scratch_y_a,
+                                  ctx->down_width * ctx->down_height));
+    if (ret < 0)
+        goto done;
+    ret = CHECK_CU(cu->cuMemAlloc(&ctx->scratch_y_b,
+                                  ctx->down_width * ctx->down_height));
+    if (ret < 0)
+        goto done;
+    ret = CHECK_CU(cu->cuMemAlloc(&ctx->scratch_uv_a,
+                                  ctx->down_width * ctx->down_uv_height));
+    if (ret < 0)
+        goto done;
+    ret = CHECK_CU(cu->cuMemAlloc(&ctx->scratch_uv_b,
+                                  ctx->down_width * ctx->down_uv_height));
+
+done:
+    if (context_pushed) {
+        int pop_ret = CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        if (ret >= 0)
+            ret = pop_ret;
+    }
+    if (ret < 0)
+        return ret;
+
+    outlink->w = inlink->w;
+    outlink->h = inlink->h;
+    outlink->time_base = inlink->time_base;
+    outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+    outl->frame_rate = inl->frame_rate;
+    outl->hw_frames_ctx = av_buffer_ref(inl->hw_frames_ctx);
+    if (!outl->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+    return 0;
+}
+
+static av_cold void band_blur_cuda_uninit(AVFilterContext *avctx)
+{
+    BandBlurCUDAContext *ctx = avctx->priv;
+
+    if (ctx->hwctx) {
+        CudaFunctions *cu = ctx->hwctx->internal->cuda_dl;
+        CUcontext dummy;
+
+        if (CHECK_CU(cu->cuCtxPushCurrent(ctx->cu_ctx)) >= 0) {
+            if (ctx->scratch_y_a)
+                CHECK_CU(cu->cuMemFree(ctx->scratch_y_a));
+            if (ctx->scratch_y_b)
+                CHECK_CU(cu->cuMemFree(ctx->scratch_y_b));
+            if (ctx->scratch_uv_a)
+                CHECK_CU(cu->cuMemFree(ctx->scratch_uv_a));
+            if (ctx->scratch_uv_b)
+                CHECK_CU(cu->cuMemFree(ctx->scratch_uv_b));
+            if (ctx->cu_module)
+                CHECK_CU(cu->cuModuleUnload(ctx->cu_module));
+            CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+        }
+    }
+    av_buffer_unref(&ctx->hw_device_ctx);
+    ctx->hwctx = NULL;
+}
+
+#define OFFSET(x) offsetof(BandBlurCUDAContext, x)
+#define FLAGS (AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_VIDEO_PARAM)
+
+static const AVOption band_blur_cuda_options[] = {
+    { "y_start", "normalized top coordinate of the vertical band", OFFSET(y_start),
+        AV_OPT_TYPE_FLOAT, { .dbl = 0.70 }, 0.0, 0.95, FLAGS },
+    { "y_end", "normalized exclusive lower coordinate of the vertical band", OFFSET(y_end),
+        AV_OPT_TYPE_FLOAT, { .dbl = 1.0 }, 0.05, 1.0, FLAGS },
+    { "blur_start", "blur mix at the top of the band", OFFSET(blur_start),
+        AV_OPT_TYPE_FLOAT, { .dbl = 0.0 }, 0.0, 1.0, FLAGS },
+    { "blur_end", "blur mix at the bottom of the band", OFFSET(blur_end),
+        AV_OPT_TYPE_FLOAT, { .dbl = 1.0 }, 0.0, 1.0, FLAGS },
+    { "luma_start", "luma multiplier at the top of the band", OFFSET(luma_start),
+        AV_OPT_TYPE_FLOAT, { .dbl = 1.0 }, 0.0, 2.0, FLAGS },
+    { "luma_end", "luma multiplier at the bottom of the band", OFFSET(luma_end),
+        AV_OPT_TYPE_FLOAT, { .dbl = 0.86 }, 0.0, 2.0, FLAGS },
+    { "radius", "half-resolution box blur radius", OFFSET(radius),
+        AV_OPT_TYPE_INT, { .i64 = 6 }, 1, 12, FLAGS },
+    { "gradient", "gradient interpolation curve", OFFSET(gradient),
+        AV_OPT_TYPE_INT, { .i64 = 1 }, 0, 1, FLAGS, .unit = "gradient" },
+    { "linear", "linear interpolation", 0,
+        AV_OPT_TYPE_CONST, { .i64 = 0 }, 0, 0, FLAGS, .unit = "gradient" },
+    { "smoothstep", "smoothstep interpolation", 0,
+        AV_OPT_TYPE_CONST, { .i64 = 1 }, 0, 0, FLAGS, .unit = "gradient" },
+    { "gradient_power", "bias applied after the gradient curve", OFFSET(gradient_power),
+        AV_OPT_TYPE_FLOAT, { .dbl = 1.0 }, 0.1, 10.0, FLAGS },
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(band_blur_cuda);
+
+static const AVFilterPad band_blur_cuda_inputs[] = {
+    {
+        .name = "default",
+        .type = AVMEDIA_TYPE_VIDEO,
+        .filter_frame = band_blur_cuda_filter_frame,
+    },
+};
+
+static const AVFilterPad band_blur_cuda_outputs[] = {
+    {
+        .name = "default",
+        .type = AVMEDIA_TYPE_VIDEO,
+        .config_props = band_blur_cuda_config_output,
+    },
+};
+
+const AVFilter ff_vf_band_blur_cuda = {
+    .name = "band_blur_cuda",
+    .description = NULL_IF_CONFIG_SMALL(
+        "Configurable vertical-band CUDA blur and luma gradient"),
+    .priv_size = sizeof(BandBlurCUDAContext),
+    .priv_class = &band_blur_cuda_class,
+    .uninit = band_blur_cuda_uninit,
+    FILTER_INPUTS(band_blur_cuda_inputs),
+    FILTER_OUTPUTS(band_blur_cuda_outputs),
+    FILTER_SINGLE_PIXFMT(AV_PIX_FMT_CUDA),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+};
