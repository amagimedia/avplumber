From ee94624876d1a887e0fa9a8e33c22517606c44d8 Mon Sep 17 00:00:00 2001
From: Jan Pietek <jan.pietek@gmail.com>
Date: Wed, 18 Mar 2026 11:12:34 +0100
Subject: [PATCH 24/40] fix ld lib path for stage

---
 .github/workflows/ubuntu-25.04-deb.yml | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/ubuntu-25.04-deb.yml b/.github/workflows/ubuntu-25.04-deb.yml
index f1658d03de..3a88925eab 100644
--- a/.github/workflows/ubuntu-25.04-deb.yml
+++ b/.github/workflows/ubuntu-25.04-deb.yml
@@ -234,7 +234,8 @@ jobs:
           make DESTDIR="${stage_dir}" install
 
           if [[ -x "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" ]]; then
-            "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" -version
+            LD_LIBRARY_PATH="${stage_dir}${FFMPEG_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
+              "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" -version
           fi
 
           if [[ "${{ inputs.strip_binaries }}" == "true" ]]; then
@@ -471,7 +472,8 @@ jobs:
           make DESTDIR="${stage_dir}" install
 
           if [[ -x "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" ]]; then
-            "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" -version
+            LD_LIBRARY_PATH="${stage_dir}${FFMPEG_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
+              "${stage_dir}${FFMPEG_PREFIX}/bin/ffmpeg" -version
           fi
 
           if [[ "${{ inputs.strip_binaries }}" == "true" ]]; then
