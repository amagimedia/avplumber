# Common support services.
JANUS_HTTP_PORT=8088
JANUS_PREVIEW_PORT=8080
WEBUI_PORT=22222
DMA_BROWSER_REST_PORT=9009
REMOTE_CONTROL_PORT=22422

# GPU/DRI selection for hosts with multiple NVIDIA GPUs or render nodes.
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0
DRI_DEVICE=/dev/dri
DMA_BROWSER_RENDER_NODE=

# Generic .avplumber script runner, selected with: --profile script up.
# Graphs should use /media, /models, and /artifacts inside the container.
AVP_RUNNER_IMAGE=<avplumber-runtime-image>
AVP_INSTANCE_NAME=script-runner
AVP_SCRIPT_FILE=/path/to/script.avplumber
AVP_ARTIFACT_DIR=/path/to/avp-output
AVP_MEDIA_DIR=/path/to/media
AVP_MODELS_DIR=/path/to/models
AVP_EXTRA_ARGS=

# Molmo/vLLM smoke image, selected with: --profile molmo run molmo-smoke.
# The image reuses an existing AVP runtime image for patched FFmpeg and pyplumber.
MOLMO_AVP_BASE_IMAGE=fanpulse-recorder:latest
MOLMO_IMAGE=avplumber-molmo-test
MOLMO_IMAGE_TAG=latest
MOLMO_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
MOLMO_VLLM_PACKAGE=vllm==0.22.1
MOLMO_CUPY_PACKAGE=cupy-cuda13x==14.1.1
MOLMO_PIP_EXTRA_PACKAGES=
MOLMO_SMOKE_INPUT=/path/to/input.mp4
MOLMO_ARTIFACT_DIR=/path/to/molmo-artifacts
MOLMO_HF_CACHE=/path/to/huggingface-cache
AVP_MOLMO_RUN_GRAPH=0
AVP_MOLMO_GRAPH_TIMEOUT=45
AVP_MOLMO_BACKEND=mock
AVP_MOLMO_STRICT=true
AVP_MOLMO_MODEL_ID=allenai/Molmo2-VideoPoint-4B
AVP_MOLMO_PROMPT=
AVP_MOLMO_RESULT_POLICY=hold_latest
AVP_MOLMO_SIDECAR_URL=
AVP_MOLMO_SIDECAR_URLS=
AVP_MOLMO_MAX_INFLIGHT=
AVP_MOLMO_WINDOW_QUEUE_SIZE=1
AVP_MOLMO_WORKER_JOIN_TIMEOUT_MS=
