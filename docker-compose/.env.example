# Common support services.
JANUS_HTTP_PORT=8088
JANUS_WS_PORT=8188
JANUS_PREVIEW_PORT=8080
WEBUI_PORT=22222
DMA_BROWSER_REST_PORT=9009
REMOTE_CONTROL_PORT=22422

# GPU/DRI selection for hosts with multiple NVIDIA GPUs or render nodes.
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0
DRI_DEVICE=/dev/dri
DMA_BROWSER_RENDER_NODE=

# Generic .avplumber script runner, selected with: --profile script up.
# Graphs should use /media, /models, and /artifacts inside the container.
AVP_RUNNER_IMAGE=<avplumber-runtime-image>
AVP_INSTANCE_NAME=script-runner
AVP_SCRIPT_FILE=/path/to/script.avplumber
AVP_ARTIFACT_DIR=/path/to/avp-output
AVP_MEDIA_DIR=/path/to/media
AVP_MODELS_DIR=/path/to/models
AVP_EXTRA_ARGS=
