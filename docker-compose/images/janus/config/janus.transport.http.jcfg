general: {
	json = "compact"
	base_path = "/janus"
	http = true
	port = __JANUS_HTTP_PORT__
	# Loopback only: the preview server, the mixer and the L4 proxy reach the API on this host.
	ip = "127.0.0.1"
	https = false
}

admin: {
	admin_http = false
	admin_https = false
}

cors: {
	allow_origin = "*"
}

certificates: {
}
