# Copy to .env beside this file. stack.sh reads it for every command.
# The interface address and, for a cloud VM behind 1:1 NAT, its public address.
JANUS_HOST_IP="<interface-address>"
JANUS_NAT_1_1="<public-address>"

# Optional: an absolute directory to keep generated assets and saved settings.
# MIXER_MEDIA_DIR=<path>
# MIXER_INITIAL_SETTINGS=<path-to-settings.json>
# MIXER_PUBLIC_PORT=7681
# Required: stack.sh does not start the proxy without it. The proxy's nginx user must be able
# to read it (mode 644, for example in a root-only directory).
MIXER_HTPASSWD="<absolute-path-to-htpasswd-file>"
# Comma-separated hostnames or addresses, without ports, that browsers open the proxy by. The
# graph view at /graph/ answers only those (and localhost); another name leaves it empty.
# Default: JANUS_NAT_1_1, or JANUS_HOST_IP without NAT.
# WEBUI_ALLOWED_HOSTS=<public-hostname>,<public-address>
# BUILD_JOBS=4

# CUDA work queues, independent of browser capture buffers.
# CUDA_DEVICE_MAX_CONNECTIONS=32
# CUDA_DEVICE_MAX_COPY_CONNECTIONS=8
# DMA_BROWSER_WINDOWS_PER_PROCESS=10
# DMA_BROWSER_STAGGER_FRAMES=1

# Use the same release tag to pull/load prebuilt images on another instance.
# MIXER_RELEASE=<release>
# MIXER_IMAGE_PREFIX=<registry-path>

# Optional price file inside the writable media directory, using the new region.
# MIXER_COMPUTE_PRICE=/media/compute-price.json
