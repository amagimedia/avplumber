# syntax=docker/dockerfile:1.7
# Fedora 44 / CUDA 13.4 build of the mixer image. It needs host driver R615 or newer.
#
# Build from the repository root:
#   docker build -f docker-compose/mixer/Dockerfile.fedora44 -t avplumber-mixer:fedora44 .
#   TENSORRT_URL=<url of your tensorrt-minimal tgz> docker build \
#       -f docker-compose/mixer/Dockerfile.fedora44 -t avplumber-mixer:fedora44-trt \
#       --build-arg WITH_TENSORRT=1 --secret id=tensorrt_url,env=TENSORRT_URL .
#   docker build -f docker-compose/mixer/Dockerfile.fedora44 -t avplumber-mixer:fedora44-mxl \
#       --build-arg WITH_MXL=1 .
#   docker build -f docker-compose/mixer/Dockerfile.fedora44 -t avplumber-mixer:fedora44-ndi \
#       --build-arg ENABLE_NDI=1 .
#
# WITH_MXL=1 adds the MXL SDK and FFmpeg's libmxl demuxer/muxer.
# Without it the image carries neither, and FFmpeg is configured as before.
# ENABLE_NDI=1 downloads the official NDI 6.4 SDK, which accepts its license, and
# adds FFmpeg's libndi_newtek input device. The two options are independent.
#
# The NVIDIA container runtime supplies the host driver. This CUDA 13.4 image
# runs on R615 and newer drivers, including R620. On desktop Blackwell the
# driver JIT-compiles the compute_89 PTX in the FFmpeg and compositor fatbins.
# NVIDIA_REQUIRE_CUDA below enforces that PTX requirement at container startup.
# The pinned Video Codec SDK 13.1 headers also require R610+ (deps/ffmpeg/9/bases.env).

ARG WITH_TENSORRT=0
ARG WITH_MXL=0

FROM fedora:44 AS base

ARG CUDA_VERSION=13.4
ARG CUDA_REPO_URL=https://developer.download.nvidia.com/compute/cuda/repos/fedora44/x86_64/cuda-fedora44.repo

# The Makefile defaults to /usr/local/cuda; the symlink makes sure it names this
# CUDA_VERSION. Fedora's loader path omits /usr/local/lib, where FFmpeg installs
# below, hence the ld.so.conf entry.
RUN dnf -y install --setopt=install_weak_deps=False ca-certificates dnf5-plugins \
    && dnf config-manager addrepo --from-repofile="${CUDA_REPO_URL}" \
    && cuda_pkg="$(echo "${CUDA_VERSION}" | tr . -)" \
    && dnf -y install --setopt=install_weak_deps=False \
        boost-devel \
        cmake \
        diffutils \
        findutils \
        gcc \
        gcc-c++ \
        git \
        libcurl-devel \
        libdrm-devel \
        libglvnd-devel \
        make \
        nasm \
        nv-codec-headers \
        openssl-devel \
        pkgconf-pkg-config \
        python3-devel \
        which \
        xxd \
        zlib-ng-compat-devel \
        "cuda-cccl-${cuda_pkg}" \
        "cuda-crt-${cuda_pkg}" \
        "cuda-cudart-${cuda_pkg}" \
        "cuda-cudart-devel-${cuda_pkg}" \
        "cuda-culibos-devel-${cuda_pkg}" \
        "cuda-driver-devel-${cuda_pkg}" \
        "cuda-nvcc-${cuda_pkg}" \
        "libnvptxcompiler-${cuda_pkg}" \
        "libnvvm-${cuda_pkg}" \
    && dnf clean all \
    && ln -sfnT "/usr/local/cuda-${CUDA_VERSION}" /usr/local/cuda \
    && echo /usr/local/lib > /etc/ld.so.conf.d/avplumber.conf

# Extra nvcc flags without editing this file, e.g. '-allow-unsupported-compiler'
# should a CUDA release lag behind Fedora's GCC. nvcc 13.4 supports GCC 16.
# For older-toolkit builds, CUDA_VERSION=13.2 uses the fedora43 CUDA_REPO_URL,
# gcc15-c++ and NVCC_PREPEND_FLAGS='-ccbin g++-15'.
ARG NVCC_PREPEND_FLAGS=
ENV NVCC_PREPEND_FLAGS=${NVCC_PREPEND_FLAGS}

# Ubuntu's GCC hardens by default and Fedora's only through rpm %optflags, which
# these builds never see: set it explicitly so the A/B against the Ubuntu image
# compares toolchains, not hardening.
ENV HARDENING_FLAGS="-fstack-protector-strong -D_FORTIFY_SOURCE=2 -fcf-protection"

# MXL is optional so the default image carries no MXL SDK. WITH_MXL selects one
# of the two stages below; the ffmpeg stage builds on it. /opt/mxl holds what the
# runtime stage needs, and exists empty without MXL so its COPY always works.
FROM base AS mxl-0

RUN mkdir -p /opt/mxl/lib

FROM base AS mxl-1

ARG MXL_TAG=v1.1.0
# This registry revision supplies the SDK's fmt 12.1 and spdlog 1.17.
ARG VCPKG_COMMIT=2fc5b0d06b6575491a8b06c18904316ec331926c
ARG BUILD_JOBS=4

# The SDK manifest includes its CLI, tests and GStreamer tools even when their
# build switches are off. Install only the four dependencies of libmxl.
ENV VCPKG_ROOT=/opt/vcpkg
ENV VCPKG_FORCE_SYSTEM_BINARIES=1
RUN dnf -y install --setopt=install_weak_deps=False ninja-build tar unzip zip \
    && dnf clean all \
    && git init --quiet "$VCPKG_ROOT" \
    && git -C "$VCPKG_ROOT" fetch --quiet --depth 1 https://github.com/microsoft/vcpkg.git "$VCPKG_COMMIT" \
    && git -C "$VCPKG_ROOT" checkout --quiet --detach FETCH_HEAD \
    && "$VCPKG_ROOT/bootstrap-vcpkg.sh" -disableMetrics \
    && VCPKG_MAX_CONCURRENCY="${BUILD_JOBS}" "$VCPKG_ROOT/vcpkg" install --classic fmt picojson spdlog stduuid

# Installed into /usr/local, beside FFmpeg (libdir forced to lib: Fedora's
# default is lib64). libmxl links spdlog statically, so the private Requires is
# scrubbed from its pkg-config file before FFmpeg's configure reads it. /opt/mxl
# gets the shared libraries for the runtime stage, and a pkg-config directory
# holding libmxl.pc alone, so that enabling MXL does not change where configure
# finds anything else.
RUN git clone --quiet --branch "${MXL_TAG}" --depth 1 \
        https://github.com/dmf-mxl/mxl.git /tmp/mxl \
    && cmake -S /tmp/mxl -B /tmp/mxl/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_TOOLCHAIN_FILE="$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake" \
        -DVCPKG_MANIFEST_MODE=OFF \
        -DBUILD_DOCS=OFF \
        -DBUILD_TOOLS=OFF -DBUILD_UTILS=OFF -DBUILD_TESTS=OFF \
    && cmake --build /tmp/mxl/build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/mxl/build \
    && test -f /usr/local/lib/pkgconfig/libmxl.pc \
    && sed -i '/^Requires.private: spdlog$/d' /usr/local/lib/pkgconfig/libmxl.pc \
    && mkdir -p /opt/mxl/lib /opt/mxl/pkgconfig \
    && cp -a /usr/local/lib/libmxl*.so* /opt/mxl/lib/ \
    && cp /usr/local/lib/pkgconfig/libmxl.pc /opt/mxl/pkgconfig/ \
    && echo /opt/mxl/lib >> /etc/ld.so.conf.d/avplumber.conf \
    && ldconfig \
    && rm -rf /tmp/mxl "$VCPKG_ROOT" /root/.cache/vcpkg

FROM mxl-${WITH_MXL} AS ffmpeg

ARG WITH_MXL
ARG ENABLE_NDI=0
ARG FFMPEG_TAG=n9.1
ARG BUILD_JOBS=4
# Empty: the nv-codec-headers pinned in deps/ffmpeg/9/bases.env (see there for driver 595 hosts).
ARG NV_CODEC_HEADERS_TAG=
ARG NV_CODEC_HEADERS_COMMIT=

COPY deps/ffmpeg /build/deps/ffmpeg

RUN if [ "${FFMPEG_TAG}" = "$(. /build/deps/ffmpeg/9/bases.env; echo "$upstream_ref")" ]; then \
        . /build/deps/ffmpeg/9/bases.env; \
        nv_codec_headers_tag=${NV_CODEC_HEADERS_TAG:-$nv_codec_headers_tag}; \
        nv_codec_headers_commit=${NV_CODEC_HEADERS_COMMIT:-$nv_codec_headers_commit}; \
        git clone --quiet --branch "$nv_codec_headers_tag" --depth 1 \
            https://github.com/FFmpeg/nv-codec-headers.git /tmp/nv-codec-headers \
        && test "$(git -C /tmp/nv-codec-headers rev-parse HEAD)" = "$nv_codec_headers_commit" \
        && make -C /tmp/nv-codec-headers install PREFIX=/usr/local \
        && rm -rf /tmp/nv-codec-headers \
        && git init --quiet /tmp/ffmpeg \
        && git -C /tmp/ffmpeg remote add origin https://github.com/FFmpeg/FFmpeg.git \
        && git -C /tmp/ffmpeg fetch --quiet --depth 1 origin "$upstream_commit" \
        && git -C /tmp/ffmpeg checkout --quiet --detach FETCH_HEAD; \
    else \
        echo "unsupported FFMPEG_TAG=${FFMPEG_TAG}: this image builds only the pinned FFmpeg 9 base" >&2; \
        exit 1; \
    fi \
    && bash /build/deps/ffmpeg/apply.sh /tmp/ffmpeg

# Only the SDK runtime library crosses into the final image. /opt/ndi/6.4/lib
# exists empty without NDI so the runtime stage's COPY always works.
RUN case "$ENABLE_NDI" in \
        0) mkdir -p /opt/ndi/6.4/lib ;; \
        1) dnf -y install avahi-libs curl tar gzip \
           && dnf clean all && bash /build/deps/ffmpeg/install-ndi-sdk.sh \
           && echo /opt/ndi/6.4/lib >> /etc/ld.so.conf.d/avplumber.conf && ldconfig ;; \
        *) echo "ENABLE_NDI must be 0 or 1" >&2; exit 2 ;; \
    esac

# Janus program audio encodes with libopus. Without it FFmpeg only has the
# native Opus decoder, and the RTP mux fails open with a codec-direction error.
RUN dnf -y install --setopt=install_weak_deps=False opus-devel \
    && dnf clean all

# Replay recordings encode with libx264 on the CPU, so the show's NVENC sessions
# stay with the program and WebRTC outputs. Fedora carries no x264 package and
# RPM Fusion publishes no Fedora 44 repository, so build the pinned upstream
# stable commit. PIC keeps the static archive usable, the shared library is what
# FFmpeg links and the runtime image copies.
ARG X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
RUN git init --quiet /tmp/x264 \
    && git -C /tmp/x264 remote add origin https://code.videolan.org/videolan/x264.git \
    && git -C /tmp/x264 fetch --quiet --depth 1 origin "$X264_COMMIT" \
    && git -C /tmp/x264 checkout --quiet --detach FETCH_HEAD \
    && test "$(git -C /tmp/x264 rev-parse HEAD)" = "$X264_COMMIT" \
    && cd /tmp/x264 \
    && ./configure \
        --prefix=/usr/local \
        --libdir=/usr/local/lib \
        --enable-shared \
        --enable-static \
        --enable-pic \
        --disable-cli \
        --disable-opencl \
    && make -j"${BUILD_JOBS}" \
    && make install \
    && test -f /usr/local/lib/pkgconfig/x264.pc \
    && ldconfig \
    && rm -rf /tmp/x264

# FFmpeg's CUDA filters as fatbins with machine code for T4 (sm_75), A100 (sm_80),
# A10 (sm_86) and L4 (sm_89), as the Makefile does for AVP's own kernels, plus
# compute_89 PTX for newer GPUs. PTX alone made the driver JIT-compile every filter
# on a host's first start (a ~15 s GPU stall on the L4) and again after each driver
# update. configure hardcodes -ptx; the fatbin keeps the .ptx file name, and
# ff_cuda_load_module's cuModuleLoadData() accepts either. CUDA 13 has no Volta
# target, so the old compute_70 is gone.
# WITH_MXL=1 adds --enable-libmxl, which is what makes configure build the mxl
# demuxer and muxer, and points pkg-config at libmxl.pc alone. Without it the
# configure line and its environment are the ones below, unchanged.
# ENABLE_NDI=1 likewise adds --enable-libndi_newtek and the SDK's header and
# library directories, which configure's plain compile-and-link check reads.
RUN cd /tmp/ffmpeg \
    && grep -q 'nvccflags="$nvccflags -ptx"' configure \
    && sed -i 's/nvccflags="$nvccflags -ptx"/nvccflags="$nvccflags -fatbin"/' configure \
    && export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH} \
    && if [ "${WITH_MXL}" = 1 ]; then mxl=--enable-libmxl; export PKG_CONFIG_PATH=/opt/mxl/pkgconfig:$PKG_CONFIG_PATH; else mxl=; fi \
    && if [ "${ENABLE_NDI}" = 1 ]; then \
           ndi=--enable-libndi_newtek; \
           export C_INCLUDE_PATH=/opt/ndi/6.4/include LIBRARY_PATH=/opt/ndi/6.4/lib; \
       else ndi=--disable-libndi_newtek; fi \
    && ./configure \
        --prefix=/usr/local \
        --libdir=/usr/local/lib \
        --incdir=/usr/local/include \
        --pkgconfigdir=/usr/local/lib/pkgconfig \
        --enable-gpl \
        --enable-nonfree \
        --enable-shared \
        --disable-static \
        --enable-cuda \
        --enable-cuda-nvcc \
        --enable-cuvid \
        --enable-ffnvcodec \
        --enable-libdrm \
        --enable-libopus \
        --enable-libx264 \
        --enable-openssl \
        --enable-nvdec \
        --enable-nvenc \
        --disable-libnpp \
        $mxl \
        $ndi \
        --disable-doc \
        --disable-htmlpages \
        --disable-manpages \
        --disable-podpages \
        --disable-txtpages \
        --extra-cflags="-I/usr/local/cuda/targets/x86_64-linux/include ${HARDENING_FLAGS}" \
        --extra-ldflags=-L/usr/local/cuda/targets/x86_64-linux/lib \
        --extra-ldexeflags=-Wl,--disable-new-dtags,-rpath,/usr/local/lib \
        --nvcc=/usr/local/cuda/bin/nvcc \
        --nvccflags='-gencode arch=compute_75,code=sm_75 -gencode arch=compute_80,code=sm_80 -gencode arch=compute_86,code=sm_86 -gencode arch=compute_89,code=sm_89 -gencode arch=compute_89,code=compute_89 -O2' \
        || { cat /tmp/ffmpeg/ffbuild/config.log; exit 1; } \
    && make -j"${BUILD_JOBS}" \
    && modules="$(find libavfilter -name '*.ptx')" \
    && test -n "$modules" \
    && for m in $modules; do \
        [ "$(od -An -tx1 -N4 "$m" | tr -d ' ')" = 50ed55ba ] \
            || { echo "$m is not a CUDA fatbin" >&2; exit 1; }; \
    done \
    && make install \
    && ldconfig \
    && if [ "${WITH_MXL}" = 1 ]; then make TARGET_PATH="$PWD" fate-mxl-video-encdec fate-mxl-audio-encdec fate-mxl-av-encdec; fi \
    && rm -rf /tmp/ffmpeg

# Required mixer filters: color/storage conversion and transitions.
# Scene, wipe and key composition use AVP nodes.
RUN ffmpeg="/usr/local/bin/ffmpeg -hide_banner" \
    && for f in scale_cuda tonemap_cuda; do $ffmpeg -filters | grep -q " $f " || exit 1; done \
    && for e in h264_nvenc hevc_nvenc libopus libx264; do $ffmpeg -encoders | grep -q " $e " || exit 1; done \
    && $ffmpeg -decoders | grep -q ' h264_cuvid ' \
    && $ffmpeg -hwaccels | grep -qx cuda \
    && $ffmpeg -buildconf | grep -q -- '--enable-libdrm' \
    && $ffmpeg -h filter=transition_cuda \
       | awk '$1 == "mode" && $3 ~ /T/ { m = 1 } $1 == "dip" { d = 1 } $1 == "color" && $3 ~ /T/ { c = 1 } \
              END { exit !(m && d && c) }'

# With MXL the demuxer and muxer must be registered; without it neither may be.
RUN ffmpeg="/usr/local/bin/ffmpeg -hide_banner" \
    && if $ffmpeg -demuxers | awk '$1 ~ /D/ && $2 == "mxl" { found = 1 } END { exit !found }'; then d=1; else d=0; fi \
    && if $ffmpeg -muxers | awk '$1 ~ /E/ && $2 == "mxl" { found = 1 } END { exit !found }'; then e=1; else e=0; fi \
    && test "$d$e" = "${WITH_MXL}${WITH_MXL}"

# TensorRT is optional so the default image carries no inference stack.
# WITH_TENSORRT selects one of the two stages below; the builder inherits it.
FROM ffmpeg AS tensorrt-0

RUN mkdir -p /opt/tensorrt/lib

FROM ffmpeg AS tensorrt-1

# The stripped bundle: trtexec, headers, the libnvinfer family. It must be a
# TensorRT build for CUDA 13; .plan engines are TensorRT-version and GPU
# specific and are mounted at run time, never baked in. cudart, the one CUDA
# library TensorRT needs at run time, rides along in /opt/tensorrt/lib so the
# runtime stage needs no CUDA rpms either way. eigen3 serves the tracking nodes.
# The URL comes in as a build secret, so it never lands in the image history.
RUN --mount=type=secret,id=tensorrt_url \
    test -s /run/secrets/tensorrt_url \
    || { echo 'WITH_TENSORRT=1 needs --secret id=tensorrt_url (the url of your tensorrt-minimal tgz)' >&2; exit 1; } \
    && dnf -y install --setopt=install_weak_deps=False curl eigen3-devel tar \
    && dnf clean all \
    && mkdir -p /opt/tensorrt/bin /opt/tensorrt/include /opt/tensorrt/lib \
    && curl -fL --retry 3 "$(cat /run/secrets/tensorrt_url)" -o /tmp/tensorrt.tgz \
    && tar -xzf /tmp/tensorrt.tgz -C /opt/tensorrt/bin --strip-components=2 --wildcards 'TensorRT-*/bin/trtexec' \
    && tar -xzf /tmp/tensorrt.tgz -C /opt/tensorrt/include --strip-components=2 --wildcards 'TensorRT-*/include/*' \
    && tar -xzf /tmp/tensorrt.tgz -C /opt/tensorrt/lib --strip-components=2 --wildcards \
        'TensorRT-*/lib/libnvinfer.so*' \
        'TensorRT-*/lib/libnvinfer_plugin.so*' \
        'TensorRT-*/lib/libnvonnxparser.so*' \
        'TensorRT-*/lib/libnvinfer_builder_resource*.so*' \
    && rm -f /tmp/tensorrt.tgz \
    && cp -a /usr/local/cuda/targets/x86_64-linux/lib/libcudart.so.* /opt/tensorrt/lib/ \
    && echo /opt/tensorrt/lib >> /etc/ld.so.conf.d/avplumber.conf \
    && ldconfig

FROM tensorrt-${WITH_TENSORRT} AS builder

ARG WITH_TENSORRT
ARG WITH_MXL
ARG AVPLUMBER_REVISION=workspace
ARG BUILD_JOBS=4

WORKDIR /build

COPY deps /build/deps
COPY Makefile generate_node_list /build/
COPY src /build/src
COPY pyplumber /build/pyplumber
COPY demos/mixer /build/demos/mixer
COPY docker-compose/mixer/deploy/l4/seed.py /build/docker-compose/mixer/deploy/l4/seed.py

RUN git init --quiet /build \
    && git -C /build -c user.name=builder -c user.email=builder@local \
        commit --quiet --allow-empty -m "workspace ${AVPLUMBER_REVISION}"

# CUDA kernels take the Makefile default image format: fatbin with SASS for
# sm_75, sm_80, sm_86 and sm_89 plus compute_89 PTX for newer GPUs such as
# desktop Blackwell. NEURAL_NET and HAVE_TENSORRT follow WITH_TENSORRT; the Makefile
# ignores TENSORRT_ROOT when they are off.
RUN set -e; for target in avplumber python_module; do \
    make -j"${BUILD_JOBS}" "$target" \
        BUILD_TYPE=Release \
        HAVE_CUDA=1 \
        HAVE_DRM=1 \
        HAVE_GL=1 \
        HAVE_NVOF_FRUC=0 \
        HAVE_NVCC=1 \
        HAVE_NVJPEG=0 \
        HAVE_MXL="${WITH_MXL}" \
        HAVE_TENSORRT="${WITH_TENSORRT}" \
        NEURAL_NET="${WITH_TENSORRT}" \
        TENSORRT_ROOT=/opt/tensorrt \
        PKG_CONFIG_PATH=/usr/local/lib/pkgconfig \
        CXXFLAGS+=" ${HARDENING_FLAGS}" \
        LFLAGS+=' -Wl,--disable-new-dtags'; \
    done

RUN test -f /build/_avplumber"$(python3-config --extension-suffix)" \
    && ldd /build/_avplumber"$(python3-config --extension-suffix)" \
       | grep -q '/usr/local/lib/libavfilter' \
    && if [ "${WITH_MXL}" = 1 ]; then ldd /build/_avplumber"$(python3-config --extension-suffix)" | grep -q libmxl; fi \
    && for node in ipc_dmabuf_source drm_prime_to_egl_image drm_prime_to_cuda \
                   egl_image_cuda_overlay; do \
           grep -q "\"${node}\"" /build/graph_factory.python.generated.cpp || exit 1; \
       done \
    && PYTHONPATH=/build python3 -c 'import _avplumber'

FROM fedora:44 AS runtime

ARG ENABLE_NDI=0
ARG AVPLUMBER_REVISION=workspace

# glvnd needs an ICD naming the NVIDIA EGL library the container runtime
# mounts; without it eglInitialize fails and the DMA-BUF browser inputs
# (drm_prime_to_egl_image) cannot import.
RUN dnf -y install --setopt=install_weak_deps=False \
        boost-thread \
        libcurl \
        libdrm \
        libglvnd-egl \
        libglvnd-gles \
        libglvnd-glx \
        openssl-libs \
        python3 \
        python3-numpy \
        python3-pip \
        opus \
    && dnf clean all \
    && mkdir -p /usr/share/glvnd/egl_vendor.d \
    && echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# glvnd opens every vendor it finds in that directory, and Fedora's libglvnd-egl
# and libglvnd-gles require mesa-libEGL, whose 50_mesa.json lands next to the
# NVIDIA ICD: through it the mixer mapped libEGL_mesa, libgallium and libLLVM
# (~24 MB) it never used. Naming the NVIDIA ICD alone replaces the directory
# scan, so Mesa stays installed (dnf would restore a deleted vendor file with
# the next transaction) but is never opened. eglGetDisplay(EGL_DEFAULT_DISPLAY)
# already resolved through NVIDIA, which sorted first; the wayland image sets
# the same variable.
ENV __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json

WORKDIR /build

COPY --from=builder /etc/ld.so.conf.d/avplumber.conf /etc/ld.so.conf.d/
COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffprobe /usr/local/bin/
COPY --from=builder /usr/local/lib/libav*.so* /usr/local/lib/libsw*.so* /usr/local/lib/libx264.so.* /usr/local/lib/
COPY --from=builder /opt/tensorrt /opt/tensorrt
COPY --from=builder /opt/mxl /opt/mxl
COPY --from=builder /opt/ndi/6.4/lib /opt/ndi/6.4/lib
COPY --from=builder /build/avplumber /usr/local/bin/
COPY --from=builder /build/_avplumber*.so /build/
COPY --from=builder /build/pyplumber /build/pyplumber
COPY demos/mixer /build/demos/mixer
COPY demos/mixer_audio /build/demos/mixer_audio
COPY docker-compose/mixer/deploy/l4/seed.py /build/docker-compose/mixer/deploy/l4/seed.py

# CUDA is loaded through the driver at run time (deps/cuda_loader, ffnvcodec),
# so nothing here may link a CUDA toolkit library: "not found" means a build
# flag drifted (HAVE_NVJPEG, libnpp).
# import _avplumber loads the native module (import pyplumber is lazy), so
# unresolved symbols fail here rather than at the first mixer start.
# libndi needs Avahi's client library for source discovery.
RUN if [ "$ENABLE_NDI" = 1 ]; then dnf -y install avahi-libs && dnf clean all; fi \
    && ldconfig \
    && if [ "$ENABLE_NDI" = 1 ]; then ffmpeg -hide_banner -devices | grep -qw libndi_newtek; fi \
    && pip3 install --no-cache-dir -r /build/pyplumber/mixer/gui/requirements.txt \
    && ls /build/_avplumber*.so >/dev/null \
    && ! ldd /build/_avplumber*.so /usr/local/bin/ffmpeg | grep 'not found' \
    && PYTHONPATH=/build python3 -c 'import _avplumber'

ENV AVPLUMBER_REVISION=${AVPLUMBER_REVISION}
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENV NVIDIA_REQUIRE_CUDA="cuda>=13.4"
ENV NVIDIA_VISIBLE_DEVICES=all
ENV PYTHONPATH=/build
ENV PYTHONUNBUFFERED=1

EXPOSE 7777/tcp

ENTRYPOINT ["python3", "-m", "pyplumber.mixer"]
